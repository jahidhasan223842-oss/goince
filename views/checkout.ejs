<%- include('partials/header') %>

<% const _tk = (v) => { const n = Number(v || 0); return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2)); }; %>

<h1 class="page-title">Checkout</h1>
<%- include('partials/checkout-steps', { step: 2 }) %>

<div class="checkout-wrap">
  <div class="checkout-summary">
    <h3>📋 Order Summary</h3>
    <ul>
      <% cart.forEach(item => { %>
        <li>
          <span class="summary-item-name"><%= item.name %><% if (item.variantLabel) { %> <span class="summary-item-variant">(<%= item.variantLabel %>)</span><% } %> <span class="summary-item-qty">× <%= item.quantity %></span></span>
          <span class="summary-item-price"><%= _tk(item.price * item.quantity) %></span>
        </li>
      <% }) %>
    </ul>
    <div class="summary-totals">
      <p><span>Subtotal</span><span><span id="subtotal-display"><%= _tk(subtotal) %></span></span></p>
      <% if (discount > 0) { %><p class="summary-discount-row"><span>Discount (<%= coupon.code %>)</span><span>-<%= _tk(discount) %></span></p><% } %>
      <p><span>Delivery Charge</span><span><% if (typeof allFreeShipping !== 'undefined' && allFreeShipping) { %>FREE 🚚<% } else { %><span id="delivery-display"><%= _tk(deliveryCharge) %></span><% } %></span></p>
    </div>
    <h3 class="summary-grand-total"><span>Total</span><span><span id="total-display"><%= _tk(total) %></span></span></h3>
    <div class="checkout-reassure">
      <p>✅ Cash on Delivery available</p>
      <p>🚚 Fast delivery — 1–2 days inside Dhaka, 3–5 days outside</p>
      <p>🔄 24h return for defective or wrong products</p>
    </div>
  </div>

  <form action="/checkout" method="POST" class="checkout-form"><%- include('partials/csrf-field') %>
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error-msg"><%= error %></p>
    <% } %>

    <div class="checkout-section">
      <h4 class="checkout-section-title">👤 Contact & Delivery</h4>

      <label>Full Name</label>
      <input type="text" name="customer_name" required>

      <label>Email <span class="field-optional">(to receive order confirmation)</span></label>
      <input type="email" name="email" placeholder="you@example.com">

      <label>Phone Number</label>
      <input type="tel" name="phone" required pattern="^(01[3-9][0-9]{8}|\+8801[3-9][0-9]{8})$" title="Bangladeshi mobile number dao — jemon 01XXXXXXXXX" placeholder="01XXXXXXXXX">

      <label>Delivery Address</label>
      <textarea name="address" rows="3" required></textarea>

      <p class="field-hint">📦 Order korar age phone-e confirm kora hobe. Zone onujayi delivery charge ar somoy bodle jabe.</p>
      <label>Delivery Area</label>
      <select name="delivery_area" id="delivery_area" onchange="updateTotal()">
        <% (typeof deliveryZones !== 'undefined' && deliveryZones.length ? deliveryZones : [{slug:'inside_dhaka',name:'Inside Dhaka',charge:deliveryCharges.inside_dhaka,delivery_time:'1–2 days'},{slug:'outside_dhaka',name:'Outside Dhaka',charge:deliveryCharges.outside_dhaka,delivery_time:'3–5 days'}]).forEach(z => { %>
          <option value="<%= z.slug %>" data-charge="<%= z.charge %>"><%= z.name %> (<%= _tk(z.charge) %><% if (z.delivery_time) { %> · <%= z.delivery_time %><% } %>)</option>
        <% }) %>
      </select>
    </div>

    <div class="checkout-section">
      <h4 class="checkout-section-title">💳 Payment</h4>

      <label>Payment Method</label>
      <select name="payment_method" id="payment_method" onchange="toggleTxnField()">
        <% if (!gateway || gateway.mode !== 'gateway' || !gateway.configured) { %>
          <% if (typeof codAllowed === 'undefined' || codAllowed) { %><option value="Cash on Delivery">Cash on Delivery</option><% } %>
        <% } %>
        <% if (!gateway || gateway.mode !== 'gateway' || !gateway.configured) { %>
          <% paymentMethods.forEach(m => { %>
            <option value="<%= m.method_name %>" data-number="<%= m.number || '' %>" data-type="<%= m.payment_type || 'send_money' %>" data-instructions="<%= (m.instructions || '').replace(/"/g, '&quot;') %>"><%= m.method_name %> — <%= {send_money:'Send Money',cash_out:'Cash Out',payment:'Payment',agent:'Agent Banking',bank:'Bank Transfer'}[m.payment_type || 'send_money'] || 'Send Money' %></option>
          <% }) %>
        <% } %>
        <% if (gateway && gateway.configured && (gateway.mode === 'gateway' || gateway.mode === 'both')) { %>
          <option value="Online Payment (Gateway)" data-gateway="1">💳 Online Payment — <%= {sslcommerz:'SSLCommerz',shurjopay:'ShurjoPay',bkash:'bKash PGW'}[gateway.provider] || 'Gateway' %> (Card / bKash / Nagad)</option>
        <% } %>
      </select>

      <div id="payment-number-box" class="payment-number-box" style="display:none;">
        <p>
          <span id="payment-type-label">Send Money</span> to <strong id="payment-method-name"></strong> at this number:
          <strong id="payment-number-display"></strong>
          <button type="button" id="copy-btn" onclick="copyPaymentNumber()">Copy</button>
        </p>
        <p class="field-hint" id="payment-instructions" style="margin:4px 0 0;"></p>
        <p class="field-hint" style="margin:4px 0 0;">After sending money, write the Transaction ID you receive below — the order won't be confirmed without it.</p>
      </div>
      <div id="gateway-box" class="payment-number-box" style="display:none;">
        <p>💳 Online payment-e gele card / bKash / Nagad diye pay korte parbe — Transaction ID lagbe na.</p>
      </div>

      <div id="txn-field" style="display:none;">
        <label id="txn-label">Transaction ID</label>
        <input type="text" name="transaction_id" id="txn-input" placeholder="e.g. 8N7A2K9XYZ">
      </div>
    </div>

    <button type="submit" class="btn-primary btn-place-order">Place Order — <span id="btn-total-display"><%= _tk(total) %></span></button>
  </form>
</div>

<script>
  const subtotal = <%= subtotal %>;
  const discount = <%= discount %>;

  const freeShipping = <%= (typeof allFreeShipping !== 'undefined' && allFreeShipping) ? 'true' : 'false' %>;
  // One currency format on the shop: ৳990, no decimals — decimals only
  // when the value is not whole (e.g. a percentage discount).
  function fmtTk(v) {
    var n = Math.round(v * 100) / 100;
    return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2));
  }
  function updateTotal() {
    const select = document.getElementById('delivery_area');
    const charge = freeShipping ? 0 : parseFloat(select.options[select.selectedIndex].dataset.charge);
    const total = subtotal - discount + charge;

    const deliveryEl = document.getElementById('delivery-display');
    if (deliveryEl) deliveryEl.textContent = fmtTk(charge);
    document.getElementById('total-display').textContent = fmtTk(total);
    document.getElementById('btn-total-display').textContent = fmtTk(total);
  }

  function toggleTxnField() {
    const select = document.getElementById('payment_method');
    const method = select.value;
    const selectedOption = select.options[select.selectedIndex];
    const number = selectedOption.dataset.number || '';
    const txnField = document.getElementById('txn-field');
    const txnLabel = document.getElementById('txn-label');
    const txnInput = document.getElementById('txn-input');
    const numberBox = document.getElementById('payment-number-box');
    const methodNameEl = document.getElementById('payment-method-name');
    const numberDisplayEl = document.getElementById('payment-number-display');

    var gatewayBox = document.getElementById('gateway-box');
    if (method === 'Cash on Delivery') {
      txnField.style.display = 'none';
      numberBox.style.display = 'none';
      if (gatewayBox) gatewayBox.style.display = 'none';
      txnInput.required = false;
    } else if (selectedOption.dataset.gateway === '1') {
      txnField.style.display = 'none';
      numberBox.style.display = 'none';
      if (gatewayBox) gatewayBox.style.display = 'block';
      txnInput.required = false;
    } else {
      // bKash / Nagad / Rocket
      txnField.style.display = 'block';
      txnLabel.textContent = 'Transaction ID (the ID you get after sending money via ' + method + ') *';
      txnInput.placeholder = 'e.g. 8N7A2K9XYZ';
      txnInput.required = true;

      var typeLabels = { send_money: 'Send Money', cash_out: 'Cash Out', payment: 'Payment', agent: 'Agent Banking', bank: 'Bank Transfer' };
      document.getElementById('payment-type-label').textContent = typeLabels[selectedOption.dataset.type || 'send_money'] || 'Send Money';
      var instr = selectedOption.dataset.instructions || '';
      document.getElementById('payment-instructions').textContent = instr;
      if (gatewayBox) gatewayBox.style.display = 'none';
      if (number) {
        methodNameEl.textContent = method;
        numberDisplayEl.textContent = number;
        numberBox.style.display = 'block';
      } else {
        numberBox.style.display = 'none';
      }
    }
  }

  function copyPaymentNumber() {
    const number = document.getElementById('payment-number-display').textContent;
    navigator.clipboard.writeText(number).then(() => {
      const btn = document.getElementById('copy-btn');
      const oldText = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = oldText; }, 1500);
    });
  }
</script>

<!-- Google Analytics: begin_checkout event -->
<script>
  gtag('event', 'begin_checkout', {
    currency: 'BDT',
    value: <%= total %>,
    items: [
      <% cart.forEach(item => { %>
      {
        item_id: '<%= item.id %>',
        item_name: <%- JSON.stringify(item.name) %>,
        price: <%= item.price %>,
        quantity: <%= item.quantity %>
      },
      <% }) %>
    ]
  });
  fbq('track', 'InitiateCheckout', {
    content_ids: [<% cart.forEach((item, i) => { %>'<%= item.id %>'<% if (i < cart.length - 1) { %>, <% } %><% }) %>],
    content_type: 'product',
    value: <%= total %>,
    currency: 'BDT',
    num_items: <%= cart.reduce((sum, item) => sum + item.quantity, 0) %>
  });
</script>

<%- include('partials/footer') %>
