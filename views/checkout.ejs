<%- include('partials/header') %>

<h1 class="page-title">Checkout</h1>

<div class="checkout-wrap">
  <div class="checkout-summary">
    <h3>Order Summary</h3>
    <ul>
      <% cart.forEach(item => { %>
        <li><%= item.name %><% if (item.variantLabel) { %> (<%= item.variantLabel %>)<% } %> x <%= item.quantity %> — ৳<%= (item.price * item.quantity).toFixed(2) %></li>
      <% }) %>
    </ul>
    <p>Subtotal: ৳<span id="subtotal-display"><%= subtotal.toFixed(2) %></span></p>
    <% if (discount > 0) { %><p>Discount (<%= coupon.code %>): -৳<%= discount.toFixed(2) %></p><% } %>
    <p>Delivery Charge: ৳<span id="delivery-display"><%= deliveryCharge.toFixed(2) %></span></p>
    <h3>Total: ৳<span id="total-display"><%= total.toFixed(2) %></span></h3>
  </div>

  <form action="/checkout" method="POST" class="checkout-form">
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error-msg"><%= error %></p>
    <% } %>

    <label>Full Name</label>
    <input type="text" name="customer_name" required>

    <label>Email (to receive order confirmation)</label>
    <input type="email" name="email" placeholder="you@example.com">

    <label>Phone Number</label>
    <input type="text" name="phone" required>

    <label>Delivery Address</label>
    <textarea name="address" rows="3" required></textarea>

    <label>Delivery Area</label>
    <select name="delivery_area" id="delivery_area" onchange="updateTotal()">
      <option value="inside_dhaka" data-charge="<%= deliveryCharges.inside_dhaka %>">Inside Dhaka (৳<%= deliveryCharges.inside_dhaka %>)</option>
      <option value="outside_dhaka" data-charge="<%= deliveryCharges.outside_dhaka %>">Outside Dhaka (৳<%= deliveryCharges.outside_dhaka %>)</option>
    </select>

    <label>Payment Method</label>
    <select name="payment_method" id="payment_method" onchange="toggleTxnField()">
      <option value="Cash on Delivery">Cash on Delivery</option>
      <% paymentMethods.forEach(m => { %>
        <option value="<%= m.method_name %>" data-number="<%= m.number || '' %>"><%= m.method_name %></option>
      <% }) %>
      <option value="Card">Card (Visa/Mastercard)</option>
    </select>

    <div id="payment-number-box" class="payment-number-box" style="display:none;">
      <p>
        Send Money to <strong id="payment-method-name"></strong> at this number:
        <strong id="payment-number-display"></strong>
        <button type="button" id="copy-btn" onclick="copyPaymentNumber()">Copy</button>
      </p>
      <p class="field-hint" style="margin:4px 0 0;">After sending money, write the Transaction ID you receive below — the order won't be confirmed without it.</p>
    </div>

    <div id="txn-field" style="display:none;">
      <label id="txn-label">Transaction ID</label>
      <input type="text" name="transaction_id" id="txn-input" placeholder="e.g. 8N7A2K9XYZ">
    </div>

    <button type="submit" class="btn-primary">Place Order</button>
  </form>
</div>

<script>
  const subtotal = <%= subtotal %>;
  const discount = <%= discount %>;

  function updateTotal() {
    const select = document.getElementById('delivery_area');
    const charge = parseFloat(select.options[select.selectedIndex].dataset.charge);
    const total = subtotal - discount + charge;

    document.getElementById('delivery-display').textContent = charge.toFixed(2);
    document.getElementById('total-display').textContent = total.toFixed(2);
  }

  function toggleTxnField() {
    const select = document.getElementById('payment_method');
    const method = select.value;
    const selectedOption = select.options[select.selectedIndex];
    const number = selectedOption.dataset.number || '';
    const txnField = document.getElementById('txn-field');
    const txnLabel = document.getElementById('txn-label');
    const txnInput = document.getElementById('txn-input');
    const numberBox = document.getElementById('payment-number-box');
    const methodNameEl = document.getElementById('payment-method-name');
    const numberDisplayEl = document.getElementById('payment-number-display');

    if (method === 'Cash on Delivery') {
      txnField.style.display = 'none';
      numberBox.style.display = 'none';
      txnInput.required = false;
    } else if (method === 'Card') {
      txnField.style.display = 'block';
      numberBox.style.display = 'none';
      txnLabel.textContent = 'Note';
      txnInput.placeholder = 'Card payment gateway coming soon — will be processed as COD for now';
      txnInput.required = false;
    } else {
      // bKash / Nagad / Rocket
      txnField.style.display = 'block';
      txnLabel.textContent = 'Transaction ID (the ID you get after sending money via ' + method + ') *';
      txnInput.placeholder = 'e.g. 8N7A2K9XYZ';
      txnInput.required = true;

      if (number) {
        methodNameEl.textContent = method;
        numberDisplayEl.textContent = number;
        numberBox.style.display = 'block';
      } else {
        numberBox.style.display = 'none';
      }
    }
  }

  function copyPaymentNumber() {
    const number = document.getElementById('payment-number-display').textContent;
    navigator.clipboard.writeText(number).then(() => {
      const btn = document.getElementById('copy-btn');
      const oldText = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = oldText; }, 1500);
    });
  }
</script>

<%- include('partials/footer') %>
