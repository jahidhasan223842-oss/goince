<%- include('partials/header') %>

<% const _tk = (v) => { const n = Number(v || 0); return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2)); }; %>
<% /* E2/E3/E5 (feat/checkout): _f is the form's values — either the
     logged-in customer's profile pre-fill (GET /checkout) or what
     they just typed (error re-render). Old renders that pass no
     `form` local (older tests) get empty fields, never a crash. */ %>
<% const _f = (typeof form !== 'undefined' && form) || {}; %>
<% const _fv = (k) => (_f[k] == null ? '' : _f[k]); %>
<% const _districts = (typeof bdDistricts !== 'undefined' && bdDistricts && bdDistricts.districts) || ['Dhaka']; %>
<% const _areas = (_fv('district') && typeof bdDistricts !== 'undefined' && bdDistricts && bdDistricts.areas && bdDistricts.areas[_fv('district')]) || []; %>

<h1 class="page-title">Checkout</h1>
<%- include('partials/checkout-steps', { step: 2 }) %>

<div class="checkout-wrap">
  <div class="checkout-summary">
    <h3>📋 Order Summary</h3>
    <ul>
      <% cart.forEach(item => { %>
        <li>
          <span class="summary-item-name"><%= item.name %><% if (item.variantLabel) { %> <span class="summary-item-variant">(<%= item.variantLabel %>)</span><% } %> <span class="summary-item-qty">× <%= item.quantity %></span></span>
          <span class="summary-item-price"><%= _tk(item.price * item.quantity) %></span>
        </li>
      <% }) %>
    </ul>
    <div class="summary-totals">
      <p><span>Subtotal</span><span><span id="subtotal-display"><%= _tk(subtotal) %></span></span></p>
      <% if (discount > 0) { %><p class="summary-discount-row"><span>Discount (<%= coupon.code %>)</span><span>-<%= _tk(discount) %></span></p><% } %>
      <% if (typeof pointsDiscount !== 'undefined' && pointsDiscount > 0) { %><p class="summary-discount-row"><span>Points discount</span><span>-<%= _tk(pointsDiscount) %></span></p><% } %>
      <p><span>Delivery Charge</span><span><% if (typeof allFreeShipping !== 'undefined' && allFreeShipping) { %>FREE 🚚<% } else { %><span id="delivery-display"><%= _tk(deliveryCharge) %></span><% } %></span></p>
    </div>
    <h3 class="summary-grand-total"><span>Total</span><span><span id="total-display"><%= _tk(total) %></span></span></h3>
    <div class="checkout-reassure">
      <p>✅ Cash on Delivery available</p>
      <p>🚚 Fast delivery — 1–2 days inside Dhaka, 3–5 days outside</p>
      <p>🔄 24h return for defective or wrong products</p>
    </div>
  </div>

  <% /* E2 — ONE-PAGE checkout: contact + address + delivery +
       payment + review on ONE scrollable page, in a SINGLE form
       (no step 1/2/3 form pages). Guest checkout works as before;
       COD + manual bKash/Nagad/Rocket + Transaction ID unchanged.
       novalidate: the inline validation (public/js/checkout.js,
       E4) is the gate — the server re-validates on POST, so no-JS
       still works. */ %>
  <form action="/checkout" method="POST" class="checkout-form" id="checkout-form" novalidate><%- include('partials/csrf-field') %>
    <% if (typeof error !== 'undefined' && error) { %>
      <p class="error-msg"><%= error %></p>
    <% } %>
    <% if (typeof prefill !== 'undefined' && prefill) { %>
      <p class="checkout-prefill-note">Signed in as <strong><%= prefill.name %></strong> — your details are filled in from your <a href="/account/profile">profile</a>. You can edit anything below.</p>
    <% } %>

    <div class="checkout-section" id="checkout-section-contact">
      <h4 class="checkout-section-title">1. Contact</h4>

      <label for="customer_name">Full Name</label>
      <input type="text" id="customer_name" name="customer_name" value="<%= _fv('customer_name') %>" required>
      <span class="field-msg" id="customer_name-msg" role="alert"></span>

      <label for="email">Email <span class="field-optional">(to receive order confirmation)</span></label>
      <input type="email" id="email" name="email" value="<%= _fv('email') %>" placeholder="you@example.com">
      <span class="field-msg" id="email-msg" role="alert"></span>

      <label for="phone">Phone Number</label>
      <input type="tel" id="phone" name="phone" value="<%= _fv('phone') %>" required pattern="^(01[3-9][0-9]{8}|\+8801[3-9][0-9]{8})$" title="Bangladeshi mobile number dao — jemon 01XXXXXXXXX" placeholder="01XXXXXXXXX">
      <span class="field-msg" id="phone-msg" role="alert"></span>
    </div>

    <div class="checkout-section" id="checkout-section-address">
      <h4 class="checkout-section-title">2. Delivery Address</h4>

      <p class="field-hint">📦 Order korar age phone-e confirm kora hobe. District ar area bechhe dao — vul thikana-e delivery fail kom hobe.</p>
      <div class="checkout-district-row">
        <div>
          <label for="district">District</label>
          <select name="district" id="district" required>
            <option value="">Select district</option>
            <% _districts.forEach(d => { %>
              <option value="<%= d %>"<%= _fv('district') === d ? ' selected' : '' %>><%= d %></option>
            <% }) %>
          </select>
          <span class="field-msg" id="district-msg" role="alert"></span>
        </div>
        <div>
          <label for="area">Area / Thana</label>
          <select name="area" id="area" data-selected="<%= _fv('area') %>">
            <option value="">Select district first</option>
            <% _areas.forEach(a => { %>
              <option value="<%= a %>"<%= _fv('area') === a ? ' selected' : '' %>><%= a %></option>
            <% }) %>
          </select>
          <span class="field-msg" id="area-msg" role="alert"></span>
        </div>
      </div>

      <label for="address_line">House / Road / Landmark</label>
      <input type="text" id="address_line" name="address_line" value="<%= _fv('address_line') %>" required placeholder="e.g. House 12, Road 5, Dhanmondi">
      <span class="field-msg" id="address_line-msg" role="alert"></span>
    </div>

    <div class="checkout-section" id="checkout-section-delivery">
      <h4 class="checkout-section-title">3. Delivery</h4>

      <label for="delivery_area">Delivery Area</label>
      <select name="delivery_area" id="delivery_area" onchange="updateTotal()">
        <% (typeof deliveryZones !== 'undefined' && deliveryZones.length ? deliveryZones : [{slug:'inside_dhaka',name:'Inside Dhaka',charge:deliveryCharges.inside_dhaka,delivery_time:'1–2 days'},{slug:'outside_dhaka',name:'Outside Dhaka',charge:deliveryCharges.outside_dhaka,delivery_time:'3–5 days'}]).forEach(z => { %>
          <option value="<%= z.slug %>" data-charge="<%= z.charge %>"><%= z.name %> (<%= _tk(z.charge) %><% if (z.delivery_time) { %> · <%= z.delivery_time %><% } %>)</option>
        <% }) %>
      </select>
      <p class="field-hint">Zone onujayi delivery charge ar somoy bodle jabe.<%= (typeof allFreeShipping !== 'undefined' && allFreeShipping) ? ' Tomar cart-er sob product-e Free Delivery — delivery charge ৳0.' : '' %></p>
    </div>

    <div class="checkout-section" id="checkout-section-payment">
      <h4 class="checkout-section-title">4. Payment</h4>

      <label for="payment_method">Payment Method</label>
      <select name="payment_method" id="payment_method" onchange="toggleTxnField()">
        <% if (!gateway || gateway.mode !== 'gateway' || !gateway.configured) { %>
          <% if (typeof codAllowed === 'undefined' || codAllowed) { %><option value="Cash on Delivery">Cash on Delivery</option><% } %>
        <% } %>
        <% if (!gateway || gateway.mode !== 'gateway' || !gateway.configured) { %>
          <% paymentMethods.forEach(m => { %>
            <option value="<%= m.method_name %>" data-number="<%= m.number || '' %>" data-type="<%= m.payment_type || 'send_money' %>" data-instructions="<%= (m.instructions || '').replace(/"/g, '&quot;') %>"><%= m.method_name %> — <%= {send_money:'Send Money',cash_out:'Cash Out',payment:'Payment',agent:'Agent Banking',bank:'Bank Transfer'}[m.payment_type || 'send_money'] || 'Send Money' %></option>
          <% }) %>
        <% } %>
        <% if (gateway && gateway.configured && (gateway.mode === 'gateway' || gateway.mode === 'both')) { %>
          <option value="Online Payment (Gateway)" data-gateway="1">💳 Online Payment — <%= {sslcommerz:'SSLCommerz',shurjopay:'ShurjoPay',bkash:'bKash PGW'}[gateway.provider] || 'Gateway' %> (Card / bKash / Nagad)</option>
        <% } %>
      </select>

      <div id="payment-number-box" class="payment-number-box" style="display:none;">
        <p>
          <span id="payment-type-label">Send Money</span> to <strong id="payment-method-name"></strong> at this number:
          <strong id="payment-number-display"></strong>
          <button type="button" id="copy-btn" onclick="copyPaymentNumber()">Copy</button>
        </p>
        <p class="field-hint" id="payment-instructions" style="margin:4px 0 0;"></p>
        <p class="field-hint" style="margin:4px 0 0;">After sending money, write the Transaction ID you receive below — the order won't be confirmed without it.</p>
      </div>
      <div id="gateway-box" class="payment-number-box" style="display:none;">
        <p>💳 Online payment-e gele card / bKash / Nagad diye pay korte parbe — Transaction ID lagbe na.</p>
      </div>

      <div id="txn-field" style="display:none;">
        <label id="txn-label" for="txn-input">Transaction ID</label>
        <input type="text" name="transaction_id" id="txn-input" placeholder="e.g. 8N7A2K9XYZ">
        <span class="field-msg" id="transaction_id-msg" role="alert"></span>
      </div>
    </div>

    <div class="checkout-section" id="checkout-section-review">
      <h4 class="checkout-section-title">5. Review Your Order</h4>
      <ul class="checkout-review-list">
        <% cart.forEach(item => { %>
          <li>
            <span><%= item.name %><% if (item.variantLabel) { %> (<%= item.variantLabel %>)<% } %> × <%= item.quantity %></span>
            <span><%= _tk(item.price * item.quantity) %></span>
          </li>
        <% }) %>
      </ul>
      <div class="summary-totals">
        <p><span>Subtotal</span><span><%= _tk(subtotal) %></span></p>
        <% if (discount > 0) { %><p class="summary-discount-row"><span>Discount (<%= coupon.code %>)</span><span>-<%= _tk(discount) %></span></p><% } %>
        <% if (typeof pointsDiscount !== 'undefined' && pointsDiscount > 0) { %><p class="summary-discount-row"><span>Points discount</span><span>-<%= _tk(pointsDiscount) %></span></p><% } %>
        <p><span>Delivery Charge</span><span><% if (typeof allFreeShipping !== 'undefined' && allFreeShipping) { %>FREE 🚚<% } else { %><span id="review-delivery-display"><%= _tk(deliveryCharge) %></span><% } %></span></p>
      </div>
      <h3 class="summary-grand-total"><span>Total</span><span id="review-total-display"><%= _tk(total) %></span></h3>
      <p class="field-hint">🔄 24h return for defective or wrong products.</p>
    </div>

    <% /* F4 (feat/retention): loyalty points redeem — logged-in
         customer with a balance can spend points here. The server
         clamps the value (balance / max-redeem cap / amount to pay),
         so typing more than allowed is safe. */ %>
    <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn && typeof loyaltyEnabled !== 'undefined' && loyaltyEnabled && typeof pointsBalance !== 'undefined' && pointsBalance > 0) { %>
    <div class="checkout-section" id="checkout-section-points">
      <h4 class="checkout-section-title">🎁 Loyalty Points</h4>
      <p class="field-hint" style="margin:0 0 8px;">You have <strong><%= pointsBalance %> points</strong><% if (typeof pointsValue !== 'undefined' && pointsValue > 0) { %> — worth <strong><%= _tk(pointsValue) %></strong> off<% } %>. Points are earned on delivered orders.</p>
      <label for="redeem_points">Redeem points (optional)</label>
      <input type="number" id="redeem_points" name="redeem_points" min="0" max="<%= pointsBalance %>" step="1" value="<%= (typeof redeemPointsInput !== 'undefined' && redeemPointsInput) || 0 %>" placeholder="0">
      <p class="field-hint" id="redeem-hint"><%= (typeof pointsRedeemPoints !== 'undefined' && pointsRedeemPoints) || 100 %> points = ৳<%= (typeof pointsRedeemTaka !== 'undefined' && pointsRedeemTaka) || 10 %> off. The total updates as you type.</p>
    </div>
    <% } %>

    <button type="submit" class="btn-primary btn-place-order">Place Order — <span id="btn-total-display"><%= _tk(total) %></span></button>
    <p class="field-hint" id="place-order-hint"></p>
  </form>
</div>

<script>
  // E5 data for public/js/checkout.js (district -> area lists).
  window.BD_DISTRICTS = <%- JSON.stringify((typeof bdDistricts !== 'undefined' && bdDistricts) || { districts: ['Dhaka'], areas: {} }) %>;
</script>
<script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/checkout.js') : '/js/checkout.js' %>"></script>

<script>
  // Place Order button lock (feat/animations-delight, A3): submit
  // chaplei button disable + spinner "Placing order…" — double-click
  // ba double-submit-e ditiyo order toiri hobe na. Submit hole page
  // navigate kore (server order-success-e pathay ba error-e form-ta
  // abar render kore — du khetrei notun button ase), tai safal
  // submit-e reset lage na. Tobe navigation kono karone na hole
  // (network stall) ba back-button-e bfcache theke firle button
  // atke thakbe na: 15s safety timer + pageshow-e reset.
  (function () {
    var form = document.querySelector('.checkout-form');
    var btn = document.querySelector('.btn-place-order');
    if (!form || !btn) return;
    var origHtml = btn.innerHTML;
    var safetyTimer = null;
    function resetBtn() {
      form._placing = false;
      btn.disabled = false;
      btn.classList.remove('is-loading');
      btn.innerHTML = origHtml;
      if (safetyTimer) { clearTimeout(safetyTimer); safetyTimer = null; }
    }
    form.addEventListener('submit', function () {
      if (form._placing) return;
      form._placing = true;
      btn.disabled = true;
      btn.classList.add('is-loading');
      btn.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span> Placing order…';
      safetyTimer = setTimeout(resetBtn, 15000);
    });
    window.addEventListener('pageshow', function () { if (form._placing) resetBtn(); });
  })();
</script>

<script>
  const subtotal = <%= subtotal %>;
  const discount = <%= discount %>;
  // F4 (feat/retention): loyalty redeem — live preview while typing.
  // Server re-clamps on POST, so this is display only.
  const pointsBalance = <%= (typeof pointsBalance !== 'undefined' && pointsBalance) || 0 %>;
  const pointsRedeemPoints = <%= (typeof pointsRedeemPoints !== 'undefined' && pointsRedeemPoints) || 100 %>;
  const pointsRedeemTaka = <%= (typeof pointsRedeemTaka !== 'undefined' && pointsRedeemTaka) || 10 %>;
  const pointsMaxRedeem = <%= (typeof pointsMaxRedeem !== 'undefined' && pointsMaxRedeem) || 500 %>;
  function livePointsValue() {
    var input = document.getElementById('redeem_points');
    if (!input) return 0;
    var typed = Math.max(0, Math.floor(Number(input.value) || 0));
    typed = Math.min(typed, pointsBalance);
    var value = Math.floor(typed / pointsRedeemPoints) * pointsRedeemTaka;
    value = Math.min(value, pointsMaxRedeem, Math.max(0, subtotal - discount));
    return Math.floor(value / pointsRedeemTaka) * pointsRedeemTaka;
  }

  const freeShipping = <%= (typeof allFreeShipping !== 'undefined' && allFreeShipping) ? 'true' : 'false' %>;
  // One currency format on the shop: ৳990, no decimals — decimals only
  // when the value is not whole (e.g. a percentage discount).
  function fmtTk(v) {
    var n = Math.round(v * 100) / 100;
    return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2));
  }
  function updateTotal() {
    const select = document.getElementById('delivery_area');
    const charge = freeShipping ? 0 : parseFloat(select.options[select.selectedIndex].dataset.charge);
    const pointsValue = livePointsValue();
    const total = subtotal - discount - pointsValue + charge;

    const deliveryEl = document.getElementById('delivery-display');
    if (deliveryEl) deliveryEl.textContent = fmtTk(charge);
    // PR #87: the Review section (section 5) has its own Delivery
    // Charge line — it used to keep the server-rendered ৳60 after a
    // zone change because only the summary line above was refreshed.
    // (All-free cart: no review-delivery-display exists — both lines
    // statically read FREE, i.e. ৳0 — so the guard skips it.)
    const reviewDeliveryEl = document.getElementById('review-delivery-display');
    if (reviewDeliveryEl) reviewDeliveryEl.textContent = fmtTk(charge);
    document.getElementById('total-display').textContent = fmtTk(total);
    document.getElementById('btn-total-display').textContent = fmtTk(total);
    const reviewTotalEl = document.getElementById('review-total-display');
    if (reviewTotalEl) reviewTotalEl.textContent = fmtTk(total);
  }

  // F4 (feat/retention): redeem input bodle total sathe sathe bodlay.
  (function () {
    var redeemInput = document.getElementById('redeem_points');
    if (!redeemInput) return;
    redeemInput.addEventListener('input', function () {
      updateTotal();
      var hint = document.getElementById('redeem-hint');
      if (hint) {
        var v = livePointsValue();
        hint.textContent = v > 0
          ? ('You will save ' + fmtTk(v) + ' on this order.')
          : (pointsRedeemPoints + ' points = ৳' + pointsRedeemTaka + ' off. The total updates as you type.');
      }
    });
    updateTotal();
  })();

  function toggleTxnField() {
    const select = document.getElementById('payment_method');
    const method = select.value;
    const selectedOption = select.options[select.selectedIndex];
    const number = selectedOption.dataset.number || '';
    const txnField = document.getElementById('txn-field');
    const txnLabel = document.getElementById('txn-label');
    const txnInput = document.getElementById('txn-input');
    const numberBox = document.getElementById('payment-number-box');
    const methodNameEl = document.getElementById('payment-method-name');
    const numberDisplayEl = document.getElementById('payment-number-display');

    var gatewayBox = document.getElementById('gateway-box');
    if (method === 'Cash on Delivery') {
      txnField.style.display = 'none';
      numberBox.style.display = 'none';
      if (gatewayBox) gatewayBox.style.display = 'none';
      txnInput.required = false;
    } else if (selectedOption.dataset.gateway === '1') {
      txnField.style.display = 'none';
      numberBox.style.display = 'none';
      if (gatewayBox) gatewayBox.style.display = 'block';
      txnInput.required = false;
    } else {
      // bKash / Nagad / Rocket
      txnField.style.display = 'block';
      txnLabel.textContent = 'Transaction ID (the ID you get after sending money via ' + method + ') *';
      txnInput.placeholder = 'e.g. 8N7A2K9XYZ';
      txnInput.required = true;

      var typeLabels = { send_money: 'Send Money', cash_out: 'Cash Out', payment: 'Payment', agent: 'Agent Banking', bank: 'Bank Transfer' };
      document.getElementById('payment-type-label').textContent = typeLabels[selectedOption.dataset.type || 'send_money'] || 'Send Money';
      var instr = selectedOption.dataset.instructions || '';
      document.getElementById('payment-instructions').textContent = instr;
      if (gatewayBox) gatewayBox.style.display = 'none';
      if (number) {
        methodNameEl.textContent = method;
        numberDisplayEl.textContent = number;
        numberBox.style.display = 'block';
      } else {
        numberBox.style.display = 'none';
      }
    }
  }

  function copyPaymentNumber() {
    const number = document.getElementById('payment-number-display').textContent;
    navigator.clipboard.writeText(number).then(() => {
      const btn = document.getElementById('copy-btn');
      const oldText = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = oldText; }, 1500);
    });
  }
</script>

<!-- Google Analytics: begin_checkout event -->
<script>
  gtag('event', 'begin_checkout', {
    currency: 'BDT',
    value: <%= total %>,
    items: [
      <% cart.forEach(item => { %>
      {
        item_id: '<%= item.id %>',
        item_name: <%- JSON.stringify(item.name) %>,
        price: <%= item.price %>,
        quantity: <%= item.quantity %>
      },
      <% }) %>
    ]
  });
  fbq('track', 'InitiateCheckout', {
    content_ids: [<% cart.forEach((item, i) => { %>'<%= item.id %>'<% if (i < cart.length - 1) { %>, <% } %><% }) %>],
    content_type: 'product',
    value: <%= total %>,
    currency: 'BDT',
    num_items: <%= cart.reduce((sum, item) => sum + item.quantity, 0) %>
  });
</script>

<%- include('partials/footer') %>
