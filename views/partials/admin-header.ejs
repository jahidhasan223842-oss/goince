<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - <%= siteName %></title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1a1a2e">
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
  <link rel="icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/icons/icon-192.png' %>">
  <link rel="apple-touch-icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/icons/icon-192.png' %>">
  <script>
    (function () {
      var t = localStorage.getItem('goince-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/style.css') : '/css/style.css' %>">
</head>
<body class="admin-body">
  <div class="admin-wrapper">
    <div class="admin-mobile-topbar">
      <button type="button" class="admin-menu-btn" id="admin-menu-btn" aria-expanded="false" aria-controls="admin-sidebar" aria-label="Menu">☰</button>
      <span class="admin-mobile-title"><%= siteName %> Admin</span>
      <button type="button" class="theme-toggle-btn admin-mobile-theme-btn" onclick="toggleGoinceTheme()" title="Dark mode" aria-label="Toggle dark mode">🌙</button>
    </div>
    <aside class="admin-sidebar" id="admin-sidebar">
      <h2><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="" class="admin-logo-mark"> <%= siteName %></h2>
      <nav>
        <% const _perms = (typeof adminPermissions !== 'undefined' && Array.isArray(adminPermissions)) ? adminPermissions : null; %>
        <% const _can = (p) => !_perms || _perms.includes(p); %>
        <% const _any = (...ps) => ps.some((p) => _can(p)); %>
        <% if (_can('dashboard.view')) { %><a href="/admin/dashboard">🏠 Dashboard</a><% } %>
        <% if (_any('products.view', 'products.manage', 'products.variants', 'categories.manage', 'banners.manage', 'stock-alerts.manage', 'inventory.manage')) { %><p class="admin-nav-group">Shop</p><% } %>
        <% if (_can('products.view')) { %><a href="/admin/products">📦 Products</a><% } %>
        <% if (_can('products.manage')) { %>
        <a href="/admin/products/import">⇪ Import Products</a>
        <% } %>
        <% if (_can('products.variants')) { %><a href="/admin/attributes">🧩 Attributes</a><% } %>
        <% if (_can('stock-alerts.manage')) { %><a href="/admin/stock-alerts">🔔 Stock Alerts</a><% } %>
        <% if (_can('categories.manage')) { %><a href="/admin/categories">🗂️ Categories</a><% } %>
        <% if (_can('banners.manage')) { %><a href="/admin/banners">🖼️ Banners</a><% } %>
        <% if (_can('inventory.manage')) { %><a href="/admin/inventory">📋 Inventory</a><% } %>
        <% if (_any('orders.view', 'activity.view', 'reports.view', 'customers.manage', 'coupons.manage', 'payment-methods.manage', 'delivery-zones.manage')) { %><p class="admin-nav-group">Sales</p><% } %>
        <% if (_can('orders.view')) { %><a href="/admin/invoices">🛒 Orders</a><% } %>
        <% if (_can('activity.view')) { %><a href="/admin/activity">📞 Calls &amp; Activity</a><% } %>
        <% if (_can('reports.view')) { %><a href="/admin/reports">📊 Reports</a><% } %>
        <% if (_can('customers.manage')) { %><a href="/admin/customers">👥 Customers</a><% } %>
        <% if (_can('coupons.manage')) { %><a href="/admin/coupons">🎟️ Coupons</a><% } %>
        <% if (_can('payment-methods.manage')) { %><a href="/admin/payment-methods">💳 Payment Methods</a><% } %>
        <% if (_can('delivery-zones.manage')) { %><a href="/admin/delivery-zones">🚚 Delivery Zones</a><% } %>
        <% if (_any('chats.manage', 'messages.manage', 'reviews.manage')) { %>
        <p class="admin-nav-group">Communication</p>
        <% if (_can('chats.manage')) { %><a href="/admin/chats">💬 Live Chat</a><% } %>
        <% if (_can('messages.manage')) { %><a href="/admin/messages">✉️ Contact Messages</a><% } %>
        <% if (_can('reviews.manage')) { %><a href="/admin/reviews">⭐ Reviews</a><% } %>
        <% } %>
        <% if (_any('settings.manage', 'test-email.send', 'staff.manage')) { %>
        <p class="admin-nav-group">System</p>
        <% if (_can('settings.manage')) { %><a href="/admin/settings">⚙️ Settings</a><% } %>
        <% if (_can('test-email.send')) { %><a href="/admin/test-email">📧 Test Email</a><% } %>
        <% if (_can('staff.manage')) { %><a href="/admin/staff">👤 Staff &amp; Roles</a><% } %>
        <% if (_can('staff.manage')) { %><a href="/admin/roles">🎭 Roles</a><% } %>
        <% } %>
        <a href="/" target="_blank">🌐 View Site</a>
        <a href="/admin/logout" class="logout-link">Logout</a>
      </nav>
    </aside>
    <div class="admin-sidebar-overlay" id="admin-sidebar-overlay"></div>
    <main class="admin-content">
      <button type="button" class="theme-toggle-btn theme-toggle-btn-dark theme-toggle-fixed" onclick="toggleGoinceTheme()" title="Dark mode">🌙</button>
