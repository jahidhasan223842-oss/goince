<% /*
  WHMCS-style admin shell (fix/whmcs-style-admin, top nav in
  fix/whmcs-top-nav, one-line bar in fix/whmcs-one-line-topbar). WHMCS
  has NO left sidebar — the admin nav is a row of dropdown buttons ON
  the one-line blue top bar (logo, nav menus, search icon,
  notifications bell, View Site globe, theme toggle, profile pill),
  and the same links live in the off-canvas drawer on phones.
  Every admin page includes this partial, so every page gets the same
  shell: one-line top bar + breadcrumb. The header NEVER queries the
  DB — counts come from res.locals (routes/admin.js notification
  middleware); every new local is guarded with typeof so direct EJS
  renders in tests keep working.

  CONVENTION — to add a new admin page later:
    1. Add its permission to lib/permissions.js (one entry) and guard the
       route with requirePermission('…').
    2. Add ONE link in _navGroups below (icon + permission + optional
       badge) inside the right group, and ONE breadcrumb entry in
       _crumbDefs.
    3. Done — the page gets the top bar, top nav, drawer, bell, sidebar
       badges and breadcrumb automatically. Do NOT build a second header.
*/ %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - <%= siteName %></title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#ffffff">
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
  <link rel="icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/icons/icon-192.png' %>">
  <link rel="apple-touch-icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/icons/icon-192.png' %>">
  <script>
    (function () {
      /* One-time theme reset (fix/whmcs-light-theme): the WHMCS light look
         is the new admin default. A browser that already stored 'dark'
         (the old default) is reset to 'light' ONCE; after that the
         theme toggle choice is respected and never reset again. */
      var MIGRATION_KEY = 'goince-theme-whmcs-v1';
      var stored = null;
      try {
        if (!localStorage.getItem(MIGRATION_KEY)) {
          localStorage.setItem('goince-theme', 'light');
          localStorage.setItem(MIGRATION_KEY, '1');
        }
        stored = localStorage.getItem('goince-theme');
      } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || 'light');
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/style.css') : '/css/style.css' %>">
</head>
<body class="admin-body">
  <% const _perms = (typeof adminPermissions !== 'undefined' && Array.isArray(adminPermissions)) ? adminPermissions : null; %>
  <% const _can = (p) => !_perms || _perms.includes(p); %>
  <% const _any = (...ps) => ps.some((p) => _can(p)); %>
  <% const _notif = (typeof adminNotifications !== 'undefined' && adminNotifications) || { pendingOrders: 0, phoneQueue: 0, unreadMessages: 0, pendingReviews: 0, openOrders: 0, total: 0 }; %>
  <% const _adminEmail = (typeof adminEmail !== 'undefined' && adminEmail) ? String(adminEmail) : ''; %>
  <% /* Display name + photo (fix/admin-profile-photo): the display name is
       set on the profile page and falls back to the email local part
       exactly as before; the photo comes from the session too — the
       header never queries the DB. */ %>
  <% const _adminName = (typeof adminDisplayName !== 'undefined' && adminDisplayName) ? String(adminDisplayName) : (_adminEmail ? _adminEmail.split('@')[0] : 'Admin'); %>
  <% const _adminPhotoUrl = (typeof adminPhotoUrl !== 'undefined' && adminPhotoUrl && String(adminPhotoUrl).startsWith('/uploads/')) ? String(adminPhotoUrl) : null; %>
  <% const _adminInitial = _adminName ? _adminName.charAt(0).toUpperCase() : 'A'; %>
  <% const _adminRoleLabel = (typeof adminRole !== 'undefined' && adminRole) ? adminRole : 'Owner'; %>
  <% /* Brand + breadcrumb root: link to the first page this admin can
       actually open (same rule as the login landing page) — a staff admin
       without dashboard.view must never see a Dashboard link that 403s. */ %>
  <% const _landing = _can('dashboard.view') ? '/admin/dashboard' : _can('orders.view') ? '/admin/orders' : _can('products.view') ? '/admin/products' : '/admin/dashboard'; %>
  <% const _rootLabel = _can('dashboard.view') ? 'Dashboard' : 'Admin'; %>
  <% const _path = (typeof adminCurrentPath === 'string' && adminCurrentPath) ? adminCurrentPath : '/admin/dashboard'; %>
  <% const _crumbDefs = [
    ['/admin/dashboard', null, null],
    ['/admin/profile', null, 'My Profile'],
    ['/admin/search', 'Search results', null],
    ['/admin/products/add', 'Shop', 'Add New Product'],
    ['/admin/products/import', 'Shop', 'Import Products'],
    ['/admin/products', 'Shop', 'Products'],
    ['/admin/attributes', 'Shop', 'Attributes'],
    ['/admin/stock-alerts', 'Shop', 'Stock Alerts'],
    ['/admin/categories', 'Shop', 'Categories'],
    ['/admin/banners', 'Shop', 'Banners'],
    ['/admin/inventory', 'Shop', 'Inventory'],
    ['/admin/orders', 'Sales', 'Orders'],
    ['/admin/invoices', 'Sales', 'Orders'],
    ['/admin/activity', 'Sales', 'Calls & Activity'],
    ['/admin/reports', 'Sales', 'Reports'],
    ['/admin/customers', 'Sales', 'Customers'],
    ['/admin/coupons', 'Sales', 'Coupons'],
    ['/admin/abandoned-carts', 'Sales', 'Abandoned Carts'],
    ['/admin/payment-methods', 'Sales', 'Payment Methods'],
    ['/admin/delivery-zones', 'Sales', 'Delivery Zones'],
    ['/admin/chats', 'Communication', 'Live Chat'],
    ['/admin/messages', 'Communication', 'Contact Messages'],
    ['/admin/reviews', 'Communication', 'Reviews'],
    ['/admin/campaigns', 'Communication', 'Campaigns'],
    ['/admin/settings', 'System', 'Settings'],
    ['/admin/test-email', 'System', 'Test Email'],
    ['/admin/staff', 'System', 'Staff & Roles'],
    ['/admin/roles', 'System', 'Roles'],
  ]; %>
  <% let _crumb = { group: null, title: 'Admin' }; %>
  <% for (const _def of _crumbDefs) { if (_path === _def[0] || _path.indexOf(_def[0] + '/') === 0) { _crumb = { group: _def[1], title: _def[2] }; break; } } %>
  <% /* Top nav + drawer share ONE link list (fix/whmcs-top-nav): WHMCS
       has no left sidebar — the nav is a row of dropdown buttons ON the
       one-line blue top bar (fix/whmcs-one-line-topbar), and the same
       links render a second time inside the mobile drawer (off-canvas,
       ≤768px). One array keeps both in sync; each link keeps its
       permission guard, and `badge` names the
       res.locals.adminNotifications count to show. */ %>
  <% const _navGroups = [
    { key: 'shop', label: 'Shop', perms: ['products.view', 'products.manage', 'products.variants', 'categories.manage', 'banners.manage', 'stock-alerts.manage', 'inventory.manage'], links: [
      { href: '/admin/products', label: '📦 Products', perm: 'products.view' },
      { href: '/admin/products/import', label: '⇪ Import Products', perm: 'products.manage' },
      { href: '/admin/attributes', label: '🧩 Attributes', perm: 'products.variants' },
      { href: '/admin/stock-alerts', label: '🔔 Stock Alerts', perm: 'stock-alerts.manage' },
      { href: '/admin/categories', label: '🗂️ Categories', perm: 'categories.manage' },
      { href: '/admin/banners', label: '🖼️ Banners', perm: 'banners.manage' },
      { href: '/admin/inventory', label: '📋 Inventory', perm: 'inventory.manage' },
    ] },
    { key: 'sales', label: 'Sales', perms: ['orders.view', 'activity.view', 'reports.view', 'customers.manage', 'coupons.manage', 'payment-methods.manage', 'delivery-zones.manage'], links: [
      { href: '/admin/invoices', label: '🛒 Orders', perm: 'orders.view', badge: 'openOrders' },
      { href: '/admin/activity', label: '📞 Calls & Activity', perm: 'activity.view', badge: 'phoneQueue' },
      { href: '/admin/reports', label: '📊 Reports', perm: 'reports.view' },
      { href: '/admin/customers', label: '👥 Customers', perm: 'customers.manage' },
      { href: '/admin/coupons', label: '🎟️ Coupons', perm: 'coupons.manage' },
      { href: '/admin/abandoned-carts', label: '🛒 Abandoned Carts', perm: 'customers.manage' },
      { href: '/admin/payment-methods', label: '💳 Payment Methods', perm: 'payment-methods.manage' },
      { href: '/admin/delivery-zones', label: '🚚 Delivery Zones', perm: 'delivery-zones.manage' },
    ] },
    { key: 'communication', label: 'Communication', perms: ['chats.manage', 'messages.manage', 'reviews.manage', 'campaigns.manage'], links: [
      { href: '/admin/chats', label: '💬 Live Chat', perm: 'chats.manage' },
      { href: '/admin/messages', label: '✉️ Contact Messages', perm: 'messages.manage', badge: 'unreadMessages' },
      { href: '/admin/reviews', label: '⭐ Reviews', perm: 'reviews.manage', badge: 'pendingReviews' },
      { href: '/admin/campaigns', label: '📧 Campaigns', perm: 'campaigns.manage' },
    ] },
    { key: 'system', label: 'System', perms: ['settings.manage', 'test-email.send', 'staff.manage'], links: [
      { href: '/admin/settings', label: '⚙️ Settings', perm: 'settings.manage' },
      { href: '/admin/test-email', label: '📧 Test Email', perm: 'test-email.send' },
      { href: '/admin/staff', label: '👤 Staff & Roles', perm: 'staff.manage' },
      { href: '/admin/roles', label: '🎭 Roles', perm: 'staff.manage' },
    ] },
  ]; %>
  <% const _isNavActive = (href) => _path === href || _path.indexOf(href + '/') === 0 || (href === '/admin/invoices' && _path.indexOf('/admin/orders') === 0); %>
  <div class="admin-wrapper">
    <aside class="admin-sidebar" id="admin-sidebar" aria-label="Admin navigation">
      <h2><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="" class="admin-logo-mark"> <%= siteName %></h2>
      <nav>
        <% if (_can('dashboard.view')) { %><a href="/admin/dashboard"<%- _isNavActive('/admin/dashboard') ? ' aria-current="page"' : '' %>>🏠 Dashboard</a><% } %>
        <% for (const _g of _navGroups) { if (!_any(..._g.perms)) continue; %>
        <button type="button" class="admin-nav-group-btn" data-nav-group="<%= _g.key %>" aria-expanded="true"><%= _g.label %> <span class="admin-nav-group-chevron" aria-hidden="true">▾</span></button>
        <div class="admin-nav-items" data-nav-group="<%= _g.key %>">
        <% for (const _l of _g.links) { if (!_can(_l.perm)) continue; %>
        <a href="<%= _l.href %>"<%- _isNavActive(_l.href) ? ' aria-current="page"' : '' %>><%= _l.label %><% if (_l.badge && Number(_notif[_l.badge] || 0) > 0) { %> <span class="admin-nav-badge"><%= Number(_notif[_l.badge]) %></span><% } %></a>
        <% } %>
        </div>
        <% } %>
        <a href="/" target="_blank">🌐 View Site</a>
      </nav>
    </aside>
    <div class="admin-sidebar-overlay" id="admin-sidebar-overlay"></div>
    <div class="admin-main-col">
      <!-- One-line WHMCS-style top bar (fix/whmcs-one-line-topbar): logo +
           nav menus + search icon + bell + View Site globe + theme toggle
           + profile pill all sit on ONE blue bar, like the real WHMCS.
           The nav lives inside the bar (no separate row below it); the
           right-hand group is pushed to the far right edge. -->
      <header class="admin-topbar">
        <button type="button" class="admin-menu-btn" id="admin-menu-btn" aria-expanded="false" aria-controls="admin-sidebar" aria-label="Menu">☰</button>
        <a class="admin-topbar-brand" href="<%= _landing %>"><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="" class="admin-logo-mark"> <span><%= siteName %> Admin</span></a>
        <nav class="admin-topnav" aria-label="Admin navigation">
          <% if (_can('dashboard.view')) { %><a href="/admin/dashboard" class="admin-topnav-link<%= _isNavActive('/admin/dashboard') ? ' is-active' : '' %>"<%- _isNavActive('/admin/dashboard') ? ' aria-current="page"' : '' %>>🏠 Dashboard</a><% } %>
          <% for (const _g of _navGroups) { if (!_any(..._g.perms)) continue; %>
          <div class="admin-topnav-dropdown">
            <button type="button" class="admin-topnav-btn<%= _crumb.group === _g.label ? ' is-active' : '' %>" data-topnav-btn aria-haspopup="true" aria-expanded="false"><%= _g.label %> <span class="admin-topnav-chevron" aria-hidden="true">▾</span></button>
            <div class="admin-topnav-menu" role="menu" aria-label="<%= _g.label %>">
              <% for (const _l of _g.links) { if (!_can(_l.perm)) continue; %>
              <a href="<%= _l.href %>" class="admin-topnav-menu-link<%= _isNavActive(_l.href) ? ' is-active' : '' %>"<%- _isNavActive(_l.href) ? ' aria-current="page"' : '' %>><%= _l.label %><% if (_l.badge && Number(_notif[_l.badge] || 0) > 0) { %> <span class="admin-nav-badge"><%= Number(_notif[_l.badge]) %></span><% } %></a>
              <% } %>
            </div>
          </div>
          <% } %>
        </nav>
        <div class="admin-topbar-right">
          <div class="admin-topbar-dropdown">
            <button type="button" class="admin-topbar-search-btn" id="admin-topbar-search-btn" aria-label="Search" aria-expanded="false">🔍</button>
            <form class="admin-topbar-search" id="admin-topbar-search" method="GET" action="/admin/search" role="search">
              <input type="search" name="q" placeholder="Search orders, customers, products…" aria-label="Search orders, customers and products" value="<%= (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '' %>">
              <button type="submit" aria-label="Search">🔍</button>
            </form>
          </div>
          <div class="admin-topbar-dropdown">
            <button type="button" class="admin-bell-btn" id="admin-bell-btn" data-dropdown-btn aria-label="Notifications" aria-expanded="false">🔔<% if (Number(_notif.total || 0) > 0) { %> <span class="admin-bell-badge"><%= Number(_notif.total) %></span><% } %></button>
            <div class="admin-dropdown-menu admin-bell-menu" id="admin-bell-menu" role="menu" aria-label="Notifications">
              <p class="admin-dropdown-heading">Needs attention</p>
              <% if (Number(_notif.total || 0) === 0) { %>
                <p class="admin-dropdown-empty">Nothing needs attention right now.</p>
              <% } else { %>
                <% if (_can('orders.view') && Number(_notif.pendingOrders || 0) > 0) { %><a href="/admin/orders?status=Pending">🛒 <strong><%= Number(_notif.pendingOrders) %> pending order(s)</strong><span>View pending orders →</span></a><% } %>
                <% if (_can('activity.view') && Number(_notif.phoneQueue || 0) > 0) { %><a href="/admin/activity">📞 <strong><%= Number(_notif.phoneQueue) %> order(s) waiting for a phone call</strong><span>Open Calls &amp; Activity →</span></a><% } %>
                <% if (_can('messages.manage') && Number(_notif.unreadMessages || 0) > 0) { %><a href="/admin/messages">✉️ <strong><%= Number(_notif.unreadMessages) %> unread message(s)</strong><span>Read messages →</span></a><% } %>
                <% if (_can('reviews.manage') && Number(_notif.pendingReviews || 0) > 0) { %><a href="/admin/reviews">⭐ <strong><%= Number(_notif.pendingReviews) %> review(s) waiting for approval</strong><span>Review them →</span></a><% } %>
              <% } %>
            </div>
          </div>
          <a href="/" target="_blank" class="admin-topbar-icon-link" aria-label="View Site" title="View Site">🌐</a>
          <button type="button" class="theme-toggle-btn admin-topbar-theme-btn" onclick="toggleGoinceTheme()" title="Dark mode" aria-label="Toggle dark mode">🌙</button>
          <div class="admin-topbar-dropdown admin-profile-dropdown">
            <button type="button" class="admin-user-btn" id="admin-user-btn" data-dropdown-btn aria-haspopup="true" aria-label="Profile menu" aria-expanded="false"><% if (_adminPhotoUrl) { %><span class="admin-user-avatar" aria-hidden="true"><img src="<%= _adminPhotoUrl %>" alt=""></span><% } else { %><span class="admin-user-avatar" aria-hidden="true"><%= _adminInitial %></span><% } %><span class="admin-user-name"><%= _adminName %></span><span class="admin-user-chevron" aria-hidden="true">▾</span></button>
            <div class="admin-dropdown-menu admin-user-menu admin-profile-menu" id="admin-user-menu" role="menu" aria-label="Profile menu">
              <div class="admin-profile-menu-head">
                <% if (_adminPhotoUrl) { %><span class="admin-user-avatar admin-profile-menu-avatar" aria-hidden="true"><img src="<%= _adminPhotoUrl %>" alt=""></span><% } else { %><span class="admin-user-avatar admin-profile-menu-avatar" aria-hidden="true"><%= _adminInitial %></span><% } %>
                <span class="admin-profile-menu-identity">
                  <span class="admin-profile-menu-name"><%= _adminName %></span>
                  <span class="admin-profile-menu-email"><%= _adminEmail %></span>
                  <span class="admin-profile-role-badge"><%= _adminRoleLabel %></span>
                </span>
              </div>
              <a class="admin-profile-menu-link" href="/admin/profile">👤 My Profile</a>
              <div class="admin-profile-menu-divider" role="separator"></div>
              <a class="admin-profile-menu-link admin-profile-menu-logout" href="/admin/logout">🚪 Logout</a>
            </div>
          </div>
        </div>
      </header>
      <main class="admin-content">
        <nav class="admin-breadcrumb" aria-label="Breadcrumb">
          <a href="<%= _landing %>"><%= _rootLabel %></a>
          <% if (_crumb.group) { %><span aria-hidden="true"> / </span><span><%= _crumb.group %></span><% } %>
          <% if (_crumb.title) { %><span aria-hidden="true"> / </span><span aria-current="page"><%= _crumb.title %></span><% } %>
        </nav>
