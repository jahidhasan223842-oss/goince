<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - <%= siteName %></title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#1a1a2e">
  <link rel="icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/icons/icon-192.png' %>">
  <link rel="apple-touch-icon" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/icons/icon-192.png' %>">
  <script>
    (function () {
      var t = localStorage.getItem('goince-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
  <div class="admin-wrapper">
    <aside class="admin-sidebar">
      <h2><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="" class="admin-logo-mark"> <%= siteName %></h2>
      <nav>
        <a href="/admin/dashboard">🏠 Dashboard</a>
        <p class="admin-nav-group">Shop</p>
        <a href="/admin/products">📦 Products</a>
        <a href="/admin/products/import">⇪ Import Products</a>
        <a href="/admin/categories">🗂️ Categories</a>
        <a href="/admin/inventory">📋 Inventory</a>
        <p class="admin-nav-group">Sales</p>
        <a href="/admin/orders">🛒 Orders</a>
        <a href="/admin/reports">📊 Reports</a>
        <a href="/admin/customers">👥 Customers</a>
        <a href="/admin/coupons">🎟️ Coupons</a>
        <a href="/admin/payment-methods">💳 Payment Methods</a>
        <a href="/admin/delivery-zones">🚚 Delivery Zones</a>
        <p class="admin-nav-group">Communication</p>
        <a href="/admin/chats">💬 Live Chat</a>
        <a href="/admin/messages">✉️ Contact Messages</a>
        <p class="admin-nav-group">System</p>
        <a href="/admin/settings">⚙️ Settings</a>
        <a href="/admin/test-email">📧 Test Email</a>
        <a href="/" target="_blank">🌐 View Site</a>
        <a href="/admin/logout" class="logout-link">Logout</a>
      </nav>
    </aside>
    <main class="admin-content">
      <button type="button" class="admin-sidebar-toggle" onclick="toggleAdminSidebar()" aria-label="Toggle admin menu" aria-expanded="false">☰</button>
      <button type="button" class="theme-toggle-btn theme-toggle-btn-dark theme-toggle-fixed" onclick="toggleGoinceTheme()" title="Dark mode">🌙</button>
