        na; hover slides it a few px out from the edge. 56px is a
        proper tap target. Nijer overlap guard (niche) tab-ta lukay
        jokhon kono product button-er sathe lege jay. */ %>
  <a href="/cart" class="side-cart" aria-label="View cart" title="View cart"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 20 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg><% if (typeof cartCount !== 'undefined' && cartCount > 0) { %><span class="side-cart-badge"><%= cartCount %></span><% } %></a>
  <% /* ---------- Mini-cart drawer (fix/mini-cart-drawer-hover) ----------
        donal asked (2026-11-27): clicking the cart option must NOT go
        to another page — it should open on the SAME page — and if
        there are any advance features, add them. So the side-cart tab
        above stays a plain <a href="/cart"> (no-JS fallback: it still
        navigates to /cart), and the footer IIFE below intercepts the
        click and opens this panel instead. Server-rendered from the
        session cart (res.locals.miniCart / miniCartSubtotal, set in
        server.js — no new query, no new route, no JSON API): photo,
        name, variant/option label, quantity stepper, line total,
        per-item remove, subtotal, delivery note (the site's real
        charges: ৳60 inside Dhaka / ৳120 outside), View Cart + Checkout
        buttons. Quantity + remove reuse the EXISTING cart POST routes
        (/cart/update/:cartKey, /cart/remove/:cartKey — same as the
        cart page), so a stepper click does a full page reload to
        /cart, exactly like the cart page today; the drawer re-opens
        only via the tab after reload. No recommendations row here —
        a footer query on every page load would be wasteful. */ %>
  <% const _miniTk = (v) => { const n = Number(v || 0); return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2)); }; %>
  <% const _miniCart = (typeof miniCart !== 'undefined' && miniCart) ? miniCart : []; %>
  <% const _miniSubtotal = (typeof miniCartSubtotal !== 'undefined' && miniCartSubtotal) ? miniCartSubtotal : _miniCart.reduce((s, it) => s + (Number(it.price) || 0) * (Number(it.quantity) || 0), 0); %>
  <div class="mini-cart-overlay" id="mini-cart-overlay" hidden></div>
  <aside class="mini-cart-drawer" id="mini-cart-drawer" role="dialog" aria-modal="true" aria-labelledby="mini-cart-title" hidden>
    <div class="mini-cart-head">
      <h2 id="mini-cart-title">Your Cart<% if (typeof cartCount !== 'undefined' && cartCount > 0) { %> (<%= cartCount %>)<% } %></h2>
      <button type="button" class="mini-cart-close" aria-label="Close cart">×</button>
    </div>
    <% if (_miniCart.length === 0) { %>
      <div class="mini-cart-empty">
        <p>Your cart is empty.</p>
        <a href="/" class="btn-primary">Start Shopping</a>
      </div>
    <% } else { %>
      <ul class="mini-cart-items">
        <% _miniCart.forEach(function (item) { %>
          <li class="mini-cart-item">
            <a href="/product/<%= item.id %>"><img src="/uploads/<%= item.image %>" alt="<%= item.name %>" class="mini-cart-thumb" onerror="this.src='/uploads/no-image.png'"></a>
            <div class="mini-cart-info">
              <a href="/product/<%= item.id %>" class="mini-cart-name"><%= item.name %></a>
              <% if (item.variantLabel) { %><span class="mini-cart-variant"><%= item.variantLabel %></span><% } %>
              <span class="mini-cart-price"><%= _miniTk(item.price) %> each</span>
              <form action="/cart/update/<%= item.cartKey || item.id %>" method="POST" class="qty-stepper mini-cart-qty"><%- include('csrf-field') %>
                <button type="submit" name="quantity" value="<%= Math.max(1, item.quantity - 1) %>" class="qty-btn" aria-label="Decrease quantity">−</button>
                <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="qty-input" aria-label="Quantity">
                <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="qty-btn" aria-label="Increase quantity">+</button>
              </form>
            </div>
            <div class="mini-cart-line">
              <span class="mini-cart-line-total"><%= _miniTk(item.price * item.quantity) %></span>
              <form action="/cart/remove/<%= item.cartKey || item.id %>" method="POST"><%- include('csrf-field') %>
                <button type="submit" class="mini-cart-remove" aria-label="Remove <%= item.name %>">×</button>
              </form>
            </div>
          </li>
        <% }) %>
      </ul>
      <div class="mini-cart-foot">
        <p class="mini-cart-subtotal"><span>Subtotal</span><strong><%= _miniTk(_miniSubtotal) %></strong></p>
        <p class="mini-cart-delivery">🚚 Delivery: ৳60 inside Dhaka / ৳120 outside Dhaka — calculated at checkout.</p>
        <div class="mini-cart-actions">
          <a href="/cart" class="mini-cart-view">View Cart</a>
          <a href="/checkout" class="btn-primary mini-cart-checkout">Checkout</a>
        </div>
        <button type="button" class="mini-cart-continue">Continue shopping</button>
      </div>
    <% } %>
