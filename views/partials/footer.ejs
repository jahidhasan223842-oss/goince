  <script>
    // Search suggestions: type korlei product-er naam/daam dekhabe
    (function () {
      var input = document.getElementById('search-input');
      var box = document.getElementById('search-suggestions');
      if (!input || !box) return;
      // "null" guard (fix/floating-cart-wishlist): donal's screenshot
      // showed the literal text "null" sitting in the search box on
      // /wishlist. No code path sets it — the server renders null as
      // '' (EJS prints null/undefined empty) and no JS assigns the
      // input's value — so it most likely arrived as a stale form
      // value restored by the browser (bfcache / back-forward
      // navigation). Whatever restored it, a search box must never
      // show the word "null": clear it on load, and the header EJS
      // guard is hardened to a truthy check too.
      if (input.value === 'null' || input.value === 'undefined') input.value = '';
      var timer = null;
      input.addEventListener('input', function () {
        clearTimeout(timer);
        var q = input.value.trim();
        if (q.length < 2) { box.hidden = true; box.innerHTML = ''; return; }
        timer = setTimeout(function () {
          // A2 skeleton (feat/animations-delight): suggestion ashar
          // age shimmer row dekhay — search-i ekmatro sotti async
          // jayga (250ms debounce + fetch); result aslei bodle jay.
          box.innerHTML = '<div class="search-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>';
          box.hidden = false;
          fetch('/api/search-suggestions?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (items) {
              if (!items.length) { box.hidden = true; box.innerHTML = ''; return; }
              box.innerHTML = items.map(function (it) {
                return '<a href="/product/' + it.id + '">' + it.name.replace(/</g, '&lt;') + ' <span>৳' + it.price + '</span></a>';
              }).join('');
              box.hidden = false;
            }).catch(function () { box.hidden = true; });
        }, 250);
      });
      document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== input) box.hidden = true; });
    })();
  </script>
  <script>
    // WhatsApp button: pre-fill the message (adds the product link on product pages) and track the click
    (function () {
      var btn = document.getElementById('whatsapp-btn');
      if (!btn) return;
      var msg = 'Hi Goince, I have a question';
      if (location.pathname.indexOf('/product/') === 0) msg += ' about this product: ' + location.href;
      btn.href += '?text=' + encodeURIComponent(msg);
      btn.addEventListener('click', function () {
        if (window.fbq) fbq('track', 'Contact');
        if (window.gtag) gtag('event', 'whatsapp_click', { page_path: location.pathname });
      });

      // Scroll-aware + overlap guard (sob width-e): button-ta jeno
      // kono clickable control dheke na fele.
      // - ≤1024px (mobile + tablet): page-er ekdom upore (scroll ≤
      //   300px) thakle lukano thake — hero/product-er chobi dheke
      //   na fele; 300px-er beshi niche scroll korle fade-in hoy.
      // - sob width: guarded control-er sathe overlap korle lukano
      //   thake — homepage Sort, cart "Proceed to Checkout",
      //   product-card-er "Add to Cart" / "Choose Option" button
      //   (.product-card .btn-card), product page-er Add to Cart
      //   (.add-to-cart-form button / .product-info .btn-primary),
      //   sticky buy bar-er Add to Cart (.sticky-buy-bar .btn-primary,
      //   feat/cart-buying B2 — mobile-e bar-ta niche thake, float-er
      //   sathe lege gele float lukabe),
      //   ar dan pranter floating side-cart tab (.side-cart — khub
      //   chhoto viewport-e majhkhane thaka tab-er satheo jeno na
      //   lege jay). Overlap-ta float-er asol rect-er sathe
      //   miliye dekha hoy (ager bottom-band onuman noy), tai jekono
      //   scroll position-ei kaj kore. Check shudhu scroll/resize-e
      //   noy — load, font ready, ResizeObserver (jekono layout
      //   bodol) ar pageshow-teo chole, jate prothom load-ei overlap
      //   thakle button lukay. JS na cholle class-e ashe na,
      //   tai button ager motoi sob somoy visible thake. CSS-e
      //   .whatsapp-float--scroll / .is-visible fade dey;
      //   prefers-reduced-motion-e transition none.
      var mq = window.matchMedia ? window.matchMedia('(max-width: 1024px)') : null;
      if (!mq) return;
      var THRESHOLD = 300;
      var GUARDED = '#sort, .cart-summary .btn-primary, .product-card .btn-card, .add-to-cart-form button, .product-info .btn-primary, .sticky-buy-bar .btn-primary, .side-cart';
      var raf = window.requestAnimationFrame || function (fn) { fn(); };
      var ticking = false;
      function overlapsFloat(el) {
        var r = el.getBoundingClientRect();
        var f = btn.getBoundingClientRect();
        if (!r || !f) return false;
        if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
        var pad = 4;
        return r.left < f.right + pad && r.right > f.left - pad &&
               r.top < f.bottom + pad && r.bottom > f.top - pad;
      }
      function update() {
        ticking = false;
        var show;
        if (!mq.matches) {
          // Desktop (>1024px): scroll-er upor nirvor kore na — shudhu
          // overlap holei lukay.
          show = true;
        } else {
          show = (window.pageYOffset || document.documentElement.scrollTop || 0) > THRESHOLD;
        }
        if (show) {
          var guarded = document.querySelectorAll(GUARDED);
          for (var i = 0; i < guarded.length; i++) {
            if (overlapsFloat(guarded[i])) { show = false; break; }
          }
        }
        btn.classList.add('whatsapp-float--scroll');
        btn.classList.toggle('is-visible', show);
        btn.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (show) { btn.removeAttribute('tabindex'); } else { btn.setAttribute('tabindex', '-1'); }
      }
      function onScroll() {
        if (!ticking) { ticking = true; raf(update); }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (mq.addEventListener) { mq.addEventListener('change', update); }
      else if (mq.addListener) { mq.addListener(update); }
      // Parse-er somoy ekbar-i map (update()) jothesto chilo na — etai
      // chilo asol karon: prothom viewport-e overlap thaka sotteo
      // button lukato na, karon map-ta neya hoto document parse
      // howar somoyei, prothom paint / chobi load / layout boshar
      // age; pore layout bodle guarded button float-er niche chole
      // gele ar keu abar mapto na (scroll/resize na korle). Tai
      // layout boshar prottek muhurte abar check: window load-er
      // pore, font ready hole, jekono layout-size bodol-e
      // (ResizeObserver — chobi load, deri-te asa content, viewport
      // bodol), bfcache theke firle (pageshow), ar prothom paint-er
      // pore rAF-e ekbar. Scroll/resize listener ager motoi ache.
      if (window.addEventListener) {
        window.addEventListener('load', update);
        window.addEventListener('pageshow', update);
      }
      if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
        document.fonts.ready.then(function () { update(); });
      }
      if (window.ResizeObserver && document.documentElement) {
        var ro = new window.ResizeObserver(function () { onScroll(); });
        ro.observe(document.documentElement);
      }
      raf(function () { update(); });
      update();
    })();
  </script>

  <script>
    // Grid -> product page transition (feat/animations-delight, A6):
    // product card-er link-e click korle View Transitions API
    // thakle cross-fade hoy; na thakle kichui kora hoy na — sadharon
    // navigation-i chole (fallback). Shudhu plain left-click (kono
    // modifier key / middle-click noy), shudhu .product-card-er
    // /product/ link — Add to Cart form, drawer, dark mode kichutei
    // hat deya hoy na.
    (function () {
      if (!document.addEventListener) return;
      document.addEventListener('click', function (e) {
        if (typeof document.startViewTransition !== 'function') return;
        if (!e || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        var t = (e.target && typeof e.target.closest === 'function')
          ? e.target.closest('.product-card a[href^="/product/"]') : null;
        if (!t) return;
        if (e.preventDefault) e.preventDefault();
        var url = t.getAttribute ? t.getAttribute('href') : null;
        if (!url) return;
        document.startViewTransition(function () { window.location.href = url; });
      });
    })();
  </script>

  <script>
    // Side-cart tab overlap guard (fix/header-cart-side-tab) + 6s
    // idle timer + mini-cart drawer (fix/mini-cart-drawer-hover):
    // tab-ta fixed, majhkhane dan dike thake — scroll korle dan
    // diker product card-er "Add to Cart" / "Choose Option"
    // button-er dan pranto-er niche chole aste pare (live-e dekha
    // geche, Best Sellers row-e). WhatsApp guard-er motoi asol rect
    // intersection diye mapa hoy: overlap hole tab lukay
    // (.side-cart--hidden — fade + pointer-events none), na hole
    // abar dekha jay. Check scroll/resize-e noy — load, font ready,
    // ResizeObserver, pageshow ar prothom paint-er pore rAF-eo
    // chole. JS na cholle tab ager motoi sob somoy visible thake.
    // 6 SECOND RULE (donal: click na korle vasoman obosthay 6 second
    // thakbe): load-er pore tab puropuri visible + 6s timer chole;
    // 6s-er moddhe hover/click na hole tab dan dike sore giye
    // shudhu ~14px sonali sliver rekhe jay (.side-cart--minimised)
    // — cart pouchano jay, page porishkar thake. Sliver-e hover /
    // click korle puro pill fire ashe + timer notun kore shuru hoy.
    // Puro tab-e click korle /cart-e jaoa hoy NA — eki page-e
    // mini-cart drawer khole (preventDefault; href="/cart" thakay
    // JS na cholle ager motoi /cart-e jay). Drawer khola thakle
    // timer bondho + tab puropuri visible thake; drawer bondho hole
    // tab abar visible hoy + 6s timer notun kore shuru hoy. Guard
    // sobar upore: overlap hole tab puropuri lukay, timer-er
    // obostha jai hok na keno, ar overlap shesh hole timer-er
    // obosthay fire ashe.
    (function () {
      var tab = document.querySelector('.side-cart');
      if (!tab) return;
      var drawer = document.querySelector('#mini-cart-drawer');
      var overlay = document.querySelector('#mini-cart-overlay');
      var closeBtn = document.querySelector('.mini-cart-close');
      var continueBtn = document.querySelector('.mini-cart-continue');
      var GUARDED = '#sort, .cart-summary .btn-primary, .product-card .btn-card, .add-to-cart-form button, .product-info .btn-primary, .sticky-buy-bar .btn-primary';
      var IDLE_MS = 6000;
      var CLOSE_MS = 260;
      var raf = window.requestAnimationFrame || function (fn) { fn(); };
      var ticking = false;
      var timerId = null;
      var minimised = false;
      var drawerOpen = false;
      var guardHidden = false;
      var lastFocused = null;
      // Add-to-cart toast (fix/ajax-add-to-cart): "✓ <product> added
      // to cart" — ~3s pore nije theke chole jay; error hole lal.
      var toast = document.querySelector('#cart-toast');
      var toastTimer = null;
      function showToast(msg, isError) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.toggle('cart-toast--error', !!isError);
        toast.hidden = false;
        void toast.offsetWidth;
        toast.classList.add('is-visible');
        if (hasTimer) {
          if (toastTimer !== null) clearTimeout(toastTimer);
          toastTimer = setTimeout(function () {
            toastTimer = null;
            toast.classList.remove('is-visible');
            toast.hidden = true;
          }, 3000);
        }
      }
      // Badge duto jayga-tei update hoy (side-cart tab + mobile
      // drawer-er Cart link) — ektai cartCount, kono ditiyo count
      // source nei. Badge na thakle (cart khali chhilo) baniye
      // bosano hoy; 0 hole soriye fela hoy.
      function setCartCount(n) {
        var count = Number(n) || 0;
        var badge = document.querySelector('.side-cart-badge');
        if (count > 0) {
          if (!badge && document.createElement) {
            badge = document.createElement('span');
            badge.className = 'side-cart-badge';
            if (tab.appendChild) tab.appendChild(badge);
          }
          if (badge) {
            badge.textContent = String(count);
            // A4 badge bump (feat/animations-delight): add-er sathe
            // sathe badge-ta pop kore (scale .9 -> 1.05 -> 1, CSS
            // keyframes). Class soriye reflow kore abar lagano hoy,
            // jate porpor add-eo protibar bump chole. Hover-er pop
            // (age thekei ache) bodlano hoy ni.
            if (badge.classList) {
              badge.classList.remove('side-cart-badge--bump');
              void badge.offsetWidth;
              badge.classList.add('side-cart-badge--bump');
            }
          }
        } else if (badge && badge.parentNode && badge.parentNode.removeChild) {
          badge.parentNode.removeChild(badge);
        }
        var drawerLink = document.querySelector('.shop-drawer-link[href="/cart"]');
        var drawerBadge = document.querySelector('.shop-drawer-link[href="/cart"] .badge');
        if (drawerLink) {
          if (count > 0) {
            if (!drawerBadge && document.createElement) {
              drawerBadge = document.createElement('span');
              drawerBadge.className = 'badge';
              if (drawerLink.appendChild) drawerLink.appendChild(drawerBadge);
            }
            if (drawerBadge) drawerBadge.textContent = String(count);
          } else if (drawerBadge && drawerBadge.parentNode && drawerBadge.parentNode.removeChild) {
            drawerBadge.parentNode.removeChild(drawerBadge);
          }
        }
      }
      // Drawer-er vitore HTML bodle gele (AJAX add-er pore drawer
      // refresh) purono × / Continue button duto bodle jay — tai
      // notun kore khuje listener lagate hoy. Prothombar nichei
      // call hoy, pore drawer refresh-er pore abar.
      function rebindDrawerButtons() {
        closeBtn = document.querySelector('.mini-cart-close');
        continueBtn = document.querySelector('.mini-cart-continue');
        if (closeBtn) closeBtn.addEventListener('click', function () { closeDrawer(); });
        if (continueBtn) continueBtn.addEventListener('click', function () { closeDrawer(); });
      }
      // Test-er vm sandbox-e setTimeout na thakleo IIFE cholte
      // hobe — tai age thekei porikkha kore rakhi; browser-e sob
      // somoy ache.
      var hasTimer = typeof setTimeout === 'function' && typeof clearTimeout === 'function';
      function overlapsTab(el) {
        var r = el.getBoundingClientRect();
        var t = tab.getBoundingClientRect();
        if (!r || !t) return false;
        if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
        var pad = 4;
        return r.left < t.right + pad && r.right > t.left - pad &&
               r.top < t.bottom + pad && r.bottom > t.top - pad;
      }
      // Tab-er asol state ek jaygay: guard sobar upore (overlap
      // hole puropuri lukay), tarpor timer-er sliver, tarpor drawer
      // khola thakle tab puropuri visible.
      function applyTabState() {
        if (guardHidden) {
          tab.classList.add('side-cart--hidden');
          tab.classList.remove('side-cart--minimised');
        } else {
          tab.classList.remove('side-cart--hidden');
          tab.classList.toggle('side-cart--minimised', minimised && !drawerOpen);
        }
        tab.setAttribute('aria-hidden', guardHidden ? 'true' : 'false');
        if (guardHidden) { tab.setAttribute('tabindex', '-1'); } else { tab.removeAttribute('tabindex'); }
      }
      function update() {
        ticking = false;
        var hide = false;
        var guarded = document.querySelectorAll(GUARDED);
        for (var i = 0; i < guarded.length; i++) {
          if (overlapsTab(guarded[i])) { hide = true; break; }
        }
        guardHidden = hide;
        applyTabState();
      }
      function stopTimer() {
        if (hasTimer && timerId !== null) { clearTimeout(timerId); timerId = null; }
      }
      function startTimer() {
        stopTimer();
        if (!hasTimer || drawerOpen) return;
        timerId = setTimeout(function () {
          timerId = null;
          minimised = true;
          applyTabState();
        }, IDLE_MS);
      }
      function restoreTab() {
        minimised = false;
        applyTabState();
        startTimer();
      }
      function openDrawer() {
        if (!drawer || !overlay) return;
        drawerOpen = true;
        stopTimer();
        lastFocused = document.activeElement || null;
        drawer.hidden = false;
        overlay.hidden = false;
        // Reflow, jate hidden soranor pore .is-open jog korle
        // slide-in animation-ta sotti chole (na hole ek frame-ei
        // shesh obostha dekhabe).
        void drawer.offsetWidth;
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
        if (document.body) document.body.classList.add('mini-cart-open');
        applyTabState();
        if (closeBtn && closeBtn.focus) closeBtn.focus();
      }
      function closeDrawer() {
        if (!drawerOpen) return;
        drawerOpen = false;
        if (drawer) drawer.classList.remove('is-open');
        if (overlay) overlay.classList.remove('is-open');
        if (document.body) document.body.classList.remove('mini-cart-open');
        // Bondho howar slide-out-ta dekhte deoar jonno hidden ektu
        // pore boshe (260ms = transition-er somoy); tar moddhe abar
        // khulle hidden bosbe na (drawerOpen abar check kora hoy).
        if (hasTimer) {
          setTimeout(function () {
            if (!drawerOpen) {
              if (drawer) drawer.hidden = true;
              if (overlay) overlay.hidden = true;
            }
          }, CLOSE_MS);
        } else {
          if (drawer) drawer.hidden = true;
          if (overlay) overlay.hidden = true;
        }
        applyTabState();
        startTimer();
        if (lastFocused && lastFocused.focus) lastFocused.focus();
        lastFocused = null;
      }
      function onScroll() {
        if (!ticking) { ticking = true; raf(update); }
      }
      // Sliver-e hover/focus korle puro pill abar ashe + timer
      // notun kore shuru hoy.
      tab.addEventListener('mouseenter', function () { restoreTab(); });
      tab.addEventListener('focus', function () { restoreTab(); });
      tab.addEventListener('click', function (e) {
        // preventDefault DUITA shakha-tei lage: sliver-e click-eo
        // browser /cart-e chole jeto (tab-ta <a href="/cart">),
        // kintu sliver-er kaj shudhu pill-ta firiye ana — drawer
        // khola noy. href="/cart" thakay JS na cholle ager motoi
        // /cart-e jaoa jay (no-JS fallback).
        if (e && e.preventDefault) e.preventDefault();
        if (minimised) { restoreTab(); return; }
        // Puro tab-e click: /cart-e jaoa noy — eki page-e drawer
        // khole.
        openDrawer();
      });
      rebindDrawerButtons();
      if (overlay) overlay.addEventListener('click', function () { closeDrawer(); });
      if (document.addEventListener) {
        document.addEventListener('keydown', function (e) {
          if (drawerOpen && e && (e.key === 'Escape' || e.key === 'Esc')) {
            if (e.preventDefault) e.preventDefault();
            closeDrawer();
          }
        });
      }
      // ---------- Fly to cart (feat/animations-delight, A1) ----------
      // Add to Cart chaple product-er chobi-ta ure dan diker floating
      // side-cart tab-er dike jay (~0.6s), tarpor nije theke sore
      // jay. Target HEADER-er cart icon NOY (PR #75-e header theke
      // sorano hoyeche) — floating gold side-cart tab (.side-cart).
      // Fetch-er sathe sathe chole — add-ke ek muhurto-o deri koray
      // na; add fail holeo animation-ta shudhu visual, kichu vange
      // na. Chobi na pele, tab na thakle, ba prefers-reduced-motion
      // hole chupchap kichu kore na (skip).
      function reducedMotion() {
        try {
          return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        } catch (err) { return false; }
      }
      function findProductImage(form) {
        try {
          var card = (form && typeof form.closest === 'function') ? form.closest('.product-card') : null;
          var img = null;
          if (card && card.querySelector) img = card.querySelector('img');
          if (!img && document.querySelector) img = document.querySelector('#main-product-image') || document.querySelector('.product-image img');
          if (!img || typeof img.getBoundingClientRect !== 'function') return null;
          var src = (img.getAttribute && img.getAttribute('src')) || img.src || '';
          if (!src || src.indexOf('no-image.png') !== -1) return null;
          return { src: src, rect: img.getBoundingClientRect() };
        } catch (err) { return null; }
      }
      function flyToCart(form) {
        try {
          if (reducedMotion()) return;
          if (!tab || typeof tab.getBoundingClientRect !== 'function') return;
          if (!document.createElement || !document.body || !document.body.appendChild) return;
          var found = findProductImage(form);
          if (!found) return;
          var from = found.rect;
          var to = tab.getBoundingClientRect();
          if (!from || !to || !from.width || !to.width) return;
          var clone = document.createElement('img');
          clone.className = 'fly-to-cart-img';
          clone.src = found.src;
          if (clone.setAttribute) clone.setAttribute('aria-hidden', 'true');
          if (!clone.style) clone.style = {};
          clone.style.left = from.left + 'px';
          clone.style.top = from.top + 'px';
          clone.style.width = from.width + 'px';
          clone.style.height = from.height + 'px';
          document.body.appendChild(clone);
          // Reflow, jate prothom obostha boshe, tarpor sesh obostha
          // (tab-er kendro, chhoto, halka fade) — transition-tai arc.
          void clone.offsetWidth;
          clone.style.left = (to.left + to.width / 2 - 14) + 'px';
          clone.style.top = (to.top + to.height / 2 - 14) + 'px';
          clone.style.width = '28px';
          clone.style.height = '28px';
          clone.style.opacity = '0.25';
          if (hasTimer) {
            setTimeout(function () {
              if (clone.parentNode && clone.parentNode.removeChild) clone.parentNode.removeChild(clone);
            }, 650);
          }
        } catch (err) { /* fly animation kokhono add-ke vangbe na */ }
      }
      // ---------- AJAX Add to Cart (fix/ajax-add-to-cart) + drawer
      // steppers/remove (feat/cart-buying, B5) ----------
      // donal: Add to Cart chaple cart-er page-e chole jay — erokom
      // jaoa jabe na. Tai shob /cart/add/ form-er submit ekhanei
      // dhora hoy (document-level delegation — Recently Viewed-er
      // JS-e toiri form guloteo kaj kore): fetch POST, page reload
      // hoy na, kothao navigate hoy na. Body URLSearchParams-e
      // pathano hoy (urlencoded — multipart NOY: CSRF middleware
      // body parser-er age chole, ar multipart body tokhon pora
      // jay na; urlencoded body thik-i pora jay, tai form-er _csrf
      // field-ta kaj kore). Route-er JSON shakha theke notun
      // cartCount + drawer-er TAZA HTML ashe: badge update hoy,
      // drawer-er vitore notun content boshe (purono × / Continue
      // button bodle jay bole rebindDrawerButtons() abar chole),
      // tab-er sliver obostha thakle puro pill fire ashe, drawer
      // khole, ar toast "✓ <product> added to cart" dekhay.
      // Error hole (out-of-stock / vul variant / server error)
      // toast error dekhay — navigate hoy na, drawer khole na.
      // Request cholte thakle button disable thake (double-add
      // atkano). "Choose Option →" kono form-i noy (link), tai
      // ekhane dhora pore na — ager motoi product page-e jay.
      // Buy Now (B3) ekoi form-er ditiyo button — take dhora hoy
      // NA: sadharon POST-e /checkout-e jay (route redirect dey).
      // Drawer-er qty stepper / remove (B5): drawer-er VITORE
      // chaple ekhanei AJAX-e dhora hoy — eki JSON shakha, drawer
      // refresh, reload noy, drawer bondho hoy na, toast lage na
      // (drawer-ei bodol dekha jay). Cart page-er stepper/remove
      // ekhane dhora pore NA (ora #mini-cart-drawer-er baire) —
      // ora ager motoi POST kore /cart-e redirect hoy (no-JS
      // fallback — action + method bodlano hoy ni).
      // Click tracker: kon submit button chapa hoyeche mone rakha
      // hoy — FormData-te button-er value ase na, ar e.submitter
      // Enter-key submit-eo prothom button-ke dekhay, tai click-ta
      // mone rakha lage: drawer stepper-er +1/−1 quantity ar Buy
      // Now-er buy_now — duitai ei tracker theke ase.
      if (document.addEventListener) {
        document.addEventListener('click', function (e) {
          var t = e && e.target;
          var b = null;
          if (t && typeof t.closest === 'function') b = t.closest('button[type="submit"]');
          if (!b || !b.form) return;
          b.form._clickedSubmitter = b;
        });
      }
      // FormData -> urlencoded body (PR #80-er motoi: multipart
      // NOY). submitter thakle tar name/value override kore —
      // stepper-er quantity (+1/−1) input-er value-ke haray, Buy
      // Now-er buy_now jog hoy. Click na hole (Enter-key submit)
      // input-er value-i thake (thik).
      function buildFormBody(form, submitter) {
        var body = '';
        try {
          var fd = new FormData(form);
          var params = new URLSearchParams();
          fd.forEach(function (v, k) { params.append(k, v); });
          if (submitter && submitter.name) params.set(submitter.name, submitter.value);
          body = params.toString();
        } catch (err) {
          body = '';
        }
        return body;
      }
      // B5: drawer-er qty stepper / remove — AJAX, reload noy.
      // Safal hole: badge update + drawer-er TAZA HTML (delivery
      // line-soho) + button rebind — drawer kholai thake, toast
      // lage na, kothao navigate hoy na. Error hole toast error —
      // navigate hoy na, drawer bondho hoy na. Request cholte
      // thakle click kora button disable thake (double-submit
      // atkano).
      function drawerCartSubmit(form, action, submitter) {
        if (form._updating) return;
        form._updating = true;
        var btn = submitter || (form.querySelector ? form.querySelector('button[type="submit"]') : null);
        if (btn) btn.disabled = true;
        fetch(action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json',
            'Content-Type': 'application/x-www-form-urlencoded'
          },
          body: buildFormBody(form, submitter),
          credentials: 'same-origin'
        }).then(function (res) {
          return res.json().then(function (data) {
            return { status: res.status, ok: res.ok, data: data };
          }).catch(function () {
            return { status: res.status, ok: res.ok, data: null };
          });
        }).then(function (r) {
          if (r.ok && r.data && r.data.ok) {
            setCartCount(r.data.cartCount);
            if (drawer && typeof r.data.drawerHtml === 'string') {
              drawer.innerHTML = r.data.drawerHtml;
              rebindDrawerButtons();
            }
          } else {
            showToast((r.data && r.data.error) || 'Could not update cart. Please try again.', true);
          }
          form._updating = false;
          if (btn) btn.disabled = false;
        }).catch(function () {
          showToast('Could not update cart. Please try again.', true);
          form._updating = false;
          if (btn) btn.disabled = false;
        });
      }
      if (document.addEventListener) {
        document.addEventListener('submit', function (e) {
          var form = e && e.target;
          if (!form || typeof form.getAttribute !== 'function') return;
          var action = form.getAttribute('action') || '';
          var inDrawer = form.closest && form.closest('#mini-cart-drawer');
          var isDrawerOp = !!inDrawer && (action.indexOf('/cart/update/') === 0 || action.indexOf('/cart/remove/') === 0);
          if (action.indexOf('/cart/add/') !== 0 && !isDrawerOp) return;
          var method = (form.getAttribute('method') || 'get').toLowerCase();
          if (method !== 'post') return;
          var submitter = form._clickedSubmitter || null;
          form._clickedSubmitter = null;
          var isAdd = action.indexOf('/cart/add/') === 0;
          // Buy Now (B3): ekoi form, kintu /checkout-e navigate
          // korte hobe — AJAX-e dhora jabe na, sadharon POST cholbe
          // (route /checkout-e redirect dey; no-JS-eo eki).
          if (isAdd && submitter && submitter.name === 'buy_now') return;
          if (e.preventDefault) e.preventDefault();
          if (!isAdd) { drawerCartSubmit(form, action, submitter); return; }
          // Ekbar cholte thakle ditiyo submit ar neoa hoy na.
          if (form._adding) return;
          form._adding = true;
          var btn = null;
          if (form.querySelector) btn = form.querySelector('button[type="submit"]');
          // A3 button loading state (feat/animations-delight): spinner
          // + "Adding…" — PR #80-er in-flight disable-er upore visual
          // state; ager label-ta mone rakha hoy, jate pore fire ase.
          var btnOrigHtml = null;
          if (btn) {
            btn.disabled = true;
            if (btn.classList) btn.classList.add('is-loading');
            if (typeof btn.innerHTML === 'string') {
              btnOrigHtml = btn.innerHTML;
              btn.innerHTML = '<span class="btn-spinner" aria-hidden="true"></span> Adding…';
            }
          }
          // A1 fly-to-cart: fetch-er sathe sathei shuru — add-ke
          // deri koray na; chobi na pele chupchap skip.
          flyToCart(form);
          var body = buildFormBody(form, null);
          // A3 success/error reset: safal hole tick "✓ Added" ~1.2s,
          // tarpor ager label fire ase; error hole sathe sathe ager
          // label fire ase (button abar chapa jay). Disabled sob
          // somoy sathe sathe khule jay.
          function done(success) {
            form._adding = false;
            if (btn) {
              btn.disabled = false;
              if (btn.classList) btn.classList.remove('is-loading');
              if (typeof btn.innerHTML === 'string' && btnOrigHtml !== null) {
                if (success) {
                  if (btn.classList) btn.classList.add('is-success');
                  btn.innerHTML = '✓ Added';
                  if (hasTimer) {
                    setTimeout(function () {
                      if (btn.classList) btn.classList.remove('is-success');
                      btn.innerHTML = btnOrigHtml;
                    }, 1200);
                  } else {
                    if (btn.classList) btn.classList.remove('is-success');
                    btn.innerHTML = btnOrigHtml;
                  }
                } else {
                  btn.innerHTML = btnOrigHtml;
                }
              }
            }
          }
          fetch(action, {
            method: 'POST',
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json',
              'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: body,
            credentials: 'same-origin'
          }).then(function (res) {
            return res.json().then(function (data) {
              return { status: res.status, ok: res.ok, data: data };
            }).catch(function () {
              return { status: res.status, ok: res.ok, data: null };
            });
          }).then(function (r) {
            if (r.ok && r.data && r.data.ok) {
              setCartCount(r.data.cartCount);
              if (drawer && typeof r.data.drawerHtml === 'string') {
                drawer.innerHTML = r.data.drawerHtml;
                rebindDrawerButtons();
              }
              restoreTab();
              openDrawer();
              showToast('✓ ' + (r.data.itemName || 'Product') + ' added to cart', false);
              done(true);
            } else {
              showToast((r.data && r.data.error) || 'Could not add to cart. Please try again.', true);
              done(false);
            }
          }).catch(function () {
            showToast('Could not add to cart. Please try again.', true);
            done(false);
          });
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (window.addEventListener) {
        window.addEventListener('load', update);
        window.addEventListener('pageshow', update);
      }
      if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
        document.fonts.ready.then(function () { update(); });
      }
      if (window.ResizeObserver && document.documentElement) {
        var ro = new window.ResizeObserver(function () { onScroll(); });
        ro.observe(document.documentElement);
      }
      raf(function () { update(); });
      update();
      startTimer();
    })();
  </script>

  <script>
    // Shared "show/hide password" toggle used across Login, Signup, Reset Password, etc.
    function togglePasswordVisibility(btn, inputId) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      btn.textContent = isHidden ? 'Hide' : 'Show';
    }
  </script>
</body>
</html>
