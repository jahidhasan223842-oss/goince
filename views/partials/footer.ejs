  <script>
    // Search suggestions: type korlei product-er naam/daam dekhabe
    (function () {
      var input = document.getElementById('search-input');
      var box = document.getElementById('search-suggestions');
      if (!input || !box) return;
      // "null" guard (fix/floating-cart-wishlist): donal's screenshot
      // showed the literal text "null" sitting in the search box on
      // /wishlist. No code path sets it — the server renders null as
      // '' (EJS prints null/undefined empty) and no JS assigns the
      // input's value — so it most likely arrived as a stale form
      // value restored by the browser (bfcache / back-forward
      // navigation). Whatever restored it, a search box must never
      // show the word "null": clear it on load, and the header EJS
      // guard is hardened to a truthy check too.
      if (input.value === 'null' || input.value === 'undefined') input.value = '';
      var timer = null;
      input.addEventListener('input', function () {
        clearTimeout(timer);
        var q = input.value.trim();
        if (q.length < 2) { box.hidden = true; box.innerHTML = ''; return; }
        timer = setTimeout(function () {
          fetch('/api/search-suggestions?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (items) {
              if (!items.length) { box.hidden = true; box.innerHTML = ''; return; }
              box.innerHTML = items.map(function (it) {
                return '<a href="/product/' + it.id + '">' + it.name.replace(/</g, '&lt;') + ' <span>৳' + it.price + '</span></a>';
              }).join('');
              box.hidden = false;
            }).catch(function () { box.hidden = true; });
        }, 250);
      });
      document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== input) box.hidden = true; });
    })();
  </script>
  <script>
    // WhatsApp button: pre-fill the message (adds the product link on product pages) and track the click
    (function () {
      var btn = document.getElementById('whatsapp-btn');
      if (!btn) return;
      var msg = 'Hi Goince, I have a question';
      if (location.pathname.indexOf('/product/') === 0) msg += ' about this product: ' + location.href;
      btn.href += '?text=' + encodeURIComponent(msg);
      btn.addEventListener('click', function () {
        if (window.fbq) fbq('track', 'Contact');
        if (window.gtag) gtag('event', 'whatsapp_click', { page_path: location.pathname });
      });

      // Scroll-aware + overlap guard (sob width-e): button-ta jeno
      // kono clickable control dheke na fele.
      // - ≤1024px (mobile + tablet): page-er ekdom upore (scroll ≤
      //   300px) thakle lukano thake — hero/product-er chobi dheke
      //   na fele; 300px-er beshi niche scroll korle fade-in hoy.
      // - sob width: guarded control-er sathe overlap korle lukano
      //   thake — homepage Sort, cart "Proceed to Checkout",
      //   product-card-er "Add to Cart" / "Choose Option" button
      //   (.product-card .btn-card), product page-er Add to Cart
      //   (.add-to-cart-form button / .product-info .btn-primary),
      //   ar dan pranter floating side-cart tab (.side-cart — khub
      //   chhoto viewport-e majhkhane thaka tab-er satheo jeno na
      //   lege jay). Overlap-ta float-er asol rect-er sathe
      //   miliye dekha hoy (ager bottom-band onuman noy), tai jekono
      //   scroll position-ei kaj kore. Check shudhu scroll/resize-e
      //   noy — load, font ready, ResizeObserver (jekono layout
      //   bodol) ar pageshow-teo chole, jate prothom load-ei overlap
      //   thakle button lukay. JS na cholle class-e ashe na,
      //   tai button ager motoi sob somoy visible thake. CSS-e
      //   .whatsapp-float--scroll / .is-visible fade dey;
      //   prefers-reduced-motion-e transition none.
      var mq = window.matchMedia ? window.matchMedia('(max-width: 1024px)') : null;
      if (!mq) return;
      var THRESHOLD = 300;
      var GUARDED = '#sort, .cart-summary .btn-primary, .product-card .btn-card, .add-to-cart-form button, .product-info .btn-primary, .side-cart';
      var raf = window.requestAnimationFrame || function (fn) { fn(); };
      var ticking = false;
      function overlapsFloat(el) {
        var r = el.getBoundingClientRect();
        var f = btn.getBoundingClientRect();
        if (!r || !f) return false;
        if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
        var pad = 4;
        return r.left < f.right + pad && r.right > f.left - pad &&
               r.top < f.bottom + pad && r.bottom > f.top - pad;
      }
      function update() {
        ticking = false;
        var show;
        if (!mq.matches) {
          // Desktop (>1024px): scroll-er upor nirvor kore na — shudhu
          // overlap holei lukay.
          show = true;
        } else {
          show = (window.pageYOffset || document.documentElement.scrollTop || 0) > THRESHOLD;
        }
        if (show) {
          var guarded = document.querySelectorAll(GUARDED);
          for (var i = 0; i < guarded.length; i++) {
            if (overlapsFloat(guarded[i])) { show = false; break; }
          }
        }
        btn.classList.add('whatsapp-float--scroll');
        btn.classList.toggle('is-visible', show);
        btn.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (show) { btn.removeAttribute('tabindex'); } else { btn.setAttribute('tabindex', '-1'); }
      }
      function onScroll() {
        if (!ticking) { ticking = true; raf(update); }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (mq.addEventListener) { mq.addEventListener('change', update); }
      else if (mq.addListener) { mq.addListener(update); }
      // Parse-er somoy ekbar-i map (update()) jothesto chilo na — etai
      // chilo asol karon: prothom viewport-e overlap thaka sotteo
      // button lukato na, karon map-ta neya hoto document parse
      // howar somoyei, prothom paint / chobi load / layout boshar
      // age; pore layout bodle guarded button float-er niche chole
      // gele ar keu abar mapto na (scroll/resize na korle). Tai
      // layout boshar prottek muhurte abar check: window load-er
      // pore, font ready hole, jekono layout-size bodol-e
      // (ResizeObserver — chobi load, deri-te asa content, viewport
      // bodol), bfcache theke firle (pageshow), ar prothom paint-er
      // pore rAF-e ekbar. Scroll/resize listener ager motoi ache.
      if (window.addEventListener) {
        window.addEventListener('load', update);
        window.addEventListener('pageshow', update);
      }
      if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
        document.fonts.ready.then(function () { update(); });
      }
      if (window.ResizeObserver && document.documentElement) {
        var ro = new window.ResizeObserver(function () { onScroll(); });
        ro.observe(document.documentElement);
      }
      raf(function () { update(); });
      update();
    })();
  </script>

  <script>
    // Side-cart tab overlap guard (fix/header-cart-side-tab) + 6s
    // idle timer + mini-cart drawer (fix/mini-cart-drawer-hover):
    // tab-ta fixed, majhkhane dan dike thake — scroll korle dan
    // diker product card-er "Add to Cart" / "Choose Option"
    // button-er dan pranto-er niche chole aste pare (live-e dekha
    // geche, Best Sellers row-e). WhatsApp guard-er motoi asol rect
    // intersection diye mapa hoy: overlap hole tab lukay
    // (.side-cart--hidden — fade + pointer-events none), na hole
    // abar dekha jay. Check scroll/resize-e noy — load, font ready,
    // ResizeObserver, pageshow ar prothom paint-er pore rAF-eo
    // chole. JS na cholle tab ager motoi sob somoy visible thake.
    // 6 SECOND RULE (donal: click na korle vasoman obosthay 6 second
    // thakbe): load-er pore tab puropuri visible + 6s timer chole;
    // 6s-er moddhe hover/click na hole tab dan dike sore giye
    // shudhu ~14px sonali sliver rekhe jay (.side-cart--minimised)
    // — cart pouchano jay, page porishkar thake. Sliver-e hover /
    // click korle puro pill fire ashe + timer notun kore shuru hoy.
    // Puro tab-e click korle /cart-e jaoa hoy NA — eki page-e
    // mini-cart drawer khole (preventDefault; href="/cart" thakay
    // JS na cholle ager motoi /cart-e jay). Drawer khola thakle
    // timer bondho + tab puropuri visible thake; drawer bondho hole
    // tab abar visible hoy + 6s timer notun kore shuru hoy. Guard
    // sobar upore: overlap hole tab puropuri lukay, timer-er
    // obostha jai hok na keno, ar overlap shesh hole timer-er
    // obosthay fire ashe.
    (function () {
      var tab = document.querySelector('.side-cart');
      if (!tab) return;
      var drawer = document.querySelector('#mini-cart-drawer');
      var overlay = document.querySelector('#mini-cart-overlay');
      var closeBtn = document.querySelector('.mini-cart-close');
      var continueBtn = document.querySelector('.mini-cart-continue');
      var GUARDED = '#sort, .cart-summary .btn-primary, .product-card .btn-card, .add-to-cart-form button, .product-info .btn-primary';
      var IDLE_MS = 6000;
      var CLOSE_MS = 260;
      var raf = window.requestAnimationFrame || function (fn) { fn(); };
      var ticking = false;
      var timerId = null;
      var minimised = false;
      var drawerOpen = false;
      var guardHidden = false;
      var lastFocused = null;
      // Test-er vm sandbox-e setTimeout na thakleo IIFE cholte
      // hobe — tai age thekei porikkha kore rakhi; browser-e sob
      // somoy ache.
      var hasTimer = typeof setTimeout === 'function' && typeof clearTimeout === 'function';
      function overlapsTab(el) {
        var r = el.getBoundingClientRect();
        var t = tab.getBoundingClientRect();
        if (!r || !t) return false;
        if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
        var pad = 4;
        return r.left < t.right + pad && r.right > t.left - pad &&
               r.top < t.bottom + pad && r.bottom > t.top - pad;
      }
      // Tab-er asol state ek jaygay: guard sobar upore (overlap
      // hole puropuri lukay), tarpor timer-er sliver, tarpor drawer
      // khola thakle tab puropuri visible.
      function applyTabState() {
        if (guardHidden) {
          tab.classList.add('side-cart--hidden');
          tab.classList.remove('side-cart--minimised');
        } else {
          tab.classList.remove('side-cart--hidden');
          tab.classList.toggle('side-cart--minimised', minimised && !drawerOpen);
        }
        tab.setAttribute('aria-hidden', guardHidden ? 'true' : 'false');
        if (guardHidden) { tab.setAttribute('tabindex', '-1'); } else { tab.removeAttribute('tabindex'); }
      }
      function update() {
        ticking = false;
        var hide = false;
        var guarded = document.querySelectorAll(GUARDED);
        for (var i = 0; i < guarded.length; i++) {
          if (overlapsTab(guarded[i])) { hide = true; break; }
        }
        guardHidden = hide;
        applyTabState();
      }
      function stopTimer() {
        if (hasTimer && timerId !== null) { clearTimeout(timerId); timerId = null; }
      }
      function startTimer() {
        stopTimer();
        if (!hasTimer || drawerOpen) return;
        timerId = setTimeout(function () {
          timerId = null;
          minimised = true;
          applyTabState();
        }, IDLE_MS);
      }
      function restoreTab() {
        minimised = false;
        applyTabState();
        startTimer();
      }
      function openDrawer() {
        if (!drawer || !overlay) return;
        drawerOpen = true;
        stopTimer();
        lastFocused = document.activeElement || null;
        drawer.hidden = false;
        overlay.hidden = false;
        // Reflow, jate hidden soranor pore .is-open jog korle
        // slide-in animation-ta sotti chole (na hole ek frame-ei
        // shesh obostha dekhabe).
        void drawer.offsetWidth;
        drawer.classList.add('is-open');
        overlay.classList.add('is-open');
        if (document.body) document.body.classList.add('mini-cart-open');
        applyTabState();
        if (closeBtn && closeBtn.focus) closeBtn.focus();
      }
      function closeDrawer() {
        if (!drawerOpen) return;
        drawerOpen = false;
        if (drawer) drawer.classList.remove('is-open');
        if (overlay) overlay.classList.remove('is-open');
        if (document.body) document.body.classList.remove('mini-cart-open');
        // Bondho howar slide-out-ta dekhte deoar jonno hidden ektu
        // pore boshe (260ms = transition-er somoy); tar moddhe abar
        // khulle hidden bosbe na (drawerOpen abar check kora hoy).
        if (hasTimer) {
          setTimeout(function () {
            if (!drawerOpen) {
              if (drawer) drawer.hidden = true;
              if (overlay) overlay.hidden = true;
            }
          }, CLOSE_MS);
        } else {
          if (drawer) drawer.hidden = true;
          if (overlay) overlay.hidden = true;
        }
        applyTabState();
        startTimer();
        if (lastFocused && lastFocused.focus) lastFocused.focus();
        lastFocused = null;
      }
      function onScroll() {
        if (!ticking) { ticking = true; raf(update); }
      }
      // Sliver-e hover/focus korle puro pill abar ashe + timer
      // notun kore shuru hoy.
      tab.addEventListener('mouseenter', function () { restoreTab(); });
      tab.addEventListener('focus', function () { restoreTab(); });
      tab.addEventListener('click', function (e) {
        // preventDefault DUITA shakha-tei lage: sliver-e click-eo
        // browser /cart-e chole jeto (tab-ta <a href="/cart">),
        // kintu sliver-er kaj shudhu pill-ta firiye ana — drawer
        // khola noy. href="/cart" thakay JS na cholle ager motoi
        // /cart-e jaoa jay (no-JS fallback).
        if (e && e.preventDefault) e.preventDefault();
        if (minimised) { restoreTab(); return; }
        // Puro tab-e click: /cart-e jaoa noy — eki page-e drawer
        // khole.
        openDrawer();
      });
      if (closeBtn) closeBtn.addEventListener('click', function () { closeDrawer(); });
      if (continueBtn) continueBtn.addEventListener('click', function () { closeDrawer(); });
      if (overlay) overlay.addEventListener('click', function () { closeDrawer(); });
      if (document.addEventListener) {
        document.addEventListener('keydown', function (e) {
          if (drawerOpen && e && (e.key === 'Escape' || e.key === 'Esc')) {
            if (e.preventDefault) e.preventDefault();
            closeDrawer();
          }
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (window.addEventListener) {
        window.addEventListener('load', update);
        window.addEventListener('pageshow', update);
      }
      if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
        document.fonts.ready.then(function () { update(); });
      }
      if (window.ResizeObserver && document.documentElement) {
        var ro = new window.ResizeObserver(function () { onScroll(); });
        ro.observe(document.documentElement);
      }
      raf(function () { update(); });
      update();
      startTimer();
    })();
  </script>

  <script>
    // Shared "show/hide password" toggle used across Login, Signup, Reset Password, etc.
    function togglePasswordVisibility(btn, inputId) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      btn.textContent = isHidden ? 'Hide' : 'Show';
    }
  </script>
</body>
