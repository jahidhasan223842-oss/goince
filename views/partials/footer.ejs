  <script>
    // Search suggestions: type korlei product-er naam/daam dekhabe
    (function () {
      var input = document.getElementById('search-input');
      var box = document.getElementById('search-suggestions');
      if (!input || !box) return;
      var timer = null;
      input.addEventListener('input', function () {
        clearTimeout(timer);
        var q = input.value.trim();
        if (q.length < 2) { box.hidden = true; box.innerHTML = ''; return; }
        timer = setTimeout(function () {
          fetch('/api/search-suggestions?q=' + encodeURIComponent(q))
            .then(function (r) { return r.json(); })
            .then(function (items) {
              if (!items.length) { box.hidden = true; box.innerHTML = ''; return; }
              box.innerHTML = items.map(function (it) {
                return '<a href="/product/' + it.id + '">' + it.name.replace(/</g, '&lt;') + ' <span>৳' + it.price + '</span></a>';
              }).join('');
              box.hidden = false;
            }).catch(function () { box.hidden = true; });
        }, 250);
      });
      document.addEventListener('click', function (e) { if (!box.contains(e.target) && e.target !== input) box.hidden = true; });
    })();
  </script>
  <script>
    // WhatsApp button: pre-fill the message (adds the product link on product pages) and track the click
    (function () {
      var btn = document.getElementById('whatsapp-btn');
      if (!btn) return;
      var msg = 'Hi Goince, I have a question';
      if (location.pathname.indexOf('/product/') === 0) msg += ' about this product: ' + location.href;
      btn.href += '?text=' + encodeURIComponent(msg);
      btn.addEventListener('click', function () {
        if (window.fbq) fbq('track', 'Contact');
        if (window.gtag) gtag('event', 'whatsapp_click', { page_path: location.pathname });
      });

      // Scroll-aware + overlap guard (sob width-e): button-ta jeno
      // kono clickable control dheke na fele.
      // - ≤1024px (mobile + tablet): page-er ekdom upore (scroll ≤
      //   300px) thakle lukano thake — hero/product-er chobi dheke
      //   na fele; 300px-er beshi niche scroll korle fade-in hoy.
      // - sob width: guarded control-er sathe overlap korle lukano
      //   thake — homepage Sort, cart "Proceed to Checkout",
      //   product-card-er "Add to Cart" / "Choose Option" button
      //   (.product-card .btn-card) ar product page-er Add to Cart
      //   (.add-to-cart-form button / .product-info .btn-primary).
      //   Desktop-e (1920px) dan dik-er shesh product card-er Add
      //   to Cart button-er upore circle-ta boshe jeto — ekhon
      //   overlap hole button lukay, scroll korle control sore
      //   gelei abar ase. Overlap-ta float-er asol rect-er sathe
      //   miliye dekha hoy (ager bottom-band onuman noy), tai jekono
      //   scroll position-ei kaj kore. Check shudhu scroll/resize-e
      //   noy — load, font ready, ResizeObserver (jekono layout
      //   bodol) ar pageshow-teo chole, jate prothom load-ei overlap
      //   thakle button lukay. JS na cholle class-e ashe na,
      //   tai button ager motoi sob somoy visible thake. CSS-e
      //   .whatsapp-float--scroll / .is-visible fade dey;
      //   prefers-reduced-motion-e transition none.
      var mq = window.matchMedia ? window.matchMedia('(max-width: 1024px)') : null;
      if (!mq) return;
      var THRESHOLD = 300;
      var GUARDED = '#sort, .cart-summary .btn-primary, .product-card .btn-card, .add-to-cart-form button, .product-info .btn-primary';
      var raf = window.requestAnimationFrame || function (fn) { fn(); };
      var ticking = false;
      function overlapsFloat(el) {
        var r = el.getBoundingClientRect();
        var f = btn.getBoundingClientRect();
        if (!r || !f) return false;
        if (r.bottom <= 0 || r.top >= window.innerHeight) return false;
        var pad = 4;
        return r.left < f.right + pad && r.right > f.left - pad &&
               r.top < f.bottom + pad && r.bottom > f.top - pad;
      }
      function update() {
        ticking = false;
        var show;
        if (!mq.matches) {
          // Desktop (>1024px): scroll-er upor nirvor kore na — shudhu
          // overlap holei lukay.
          show = true;
        } else {
          show = (window.pageYOffset || document.documentElement.scrollTop || 0) > THRESHOLD;
        }
        if (show) {
          var guarded = document.querySelectorAll(GUARDED);
          for (var i = 0; i < guarded.length; i++) {
            if (overlapsFloat(guarded[i])) { show = false; break; }
          }
        }
        btn.classList.add('whatsapp-float--scroll');
        btn.classList.toggle('is-visible', show);
        btn.setAttribute('aria-hidden', show ? 'false' : 'true');
        if (show) { btn.removeAttribute('tabindex'); } else { btn.setAttribute('tabindex', '-1'); }
      }
      function onScroll() {
        if (!ticking) { ticking = true; raf(update); }
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      if (mq.addEventListener) { mq.addEventListener('change', update); }
      else if (mq.addListener) { mq.addListener(update); }
      // Parse-er somoy ekbar-i map (update()) jothesto chilo na — etai
      // chilo asol karon: prothom viewport-e overlap thaka sotteo
      // button lukato na, karon map-ta neya hoto document parse
      // howar somoyei, prothom paint / chobi load / layout boshar
      // age; pore layout bodle guarded button float-er niche chole
      // gele ar keu abar mapto na (scroll/resize na korle). Tai
      // layout boshar prottek muhurte abar check: window load-er
      // pore, font ready hole, jekono layout-size bodol-e
      // (ResizeObserver — chobi load, deri-te asa content, viewport
      // bodol), bfcache theke firle (pageshow), ar prothom paint-er
      // pore rAF-e ekbar. Scroll/resize listener ager motoi ache.
      if (window.addEventListener) {
        window.addEventListener('load', update);
        window.addEventListener('pageshow', update);
      }
      if (document.fonts && document.fonts.ready && document.fonts.ready.then) {
        document.fonts.ready.then(function () { update(); });
      }
      if (window.ResizeObserver && document.documentElement) {
        var ro = new window.ResizeObserver(function () { onScroll(); });
        ro.observe(document.documentElement);
      }
      raf(function () { update(); });
      update();
    })();
  </script>

  <script>
    // Shared "show/hide password" toggle used across Login, Signup, Reset Password, etc.
    function togglePasswordVisibility(btn, inputId) {
      const input = document.getElementById(inputId);
      if (!input) return;
      const isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      btn.textContent = isHidden ? 'Hide' : 'Show';
    }
  </script>
