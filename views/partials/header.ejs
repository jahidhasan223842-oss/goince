<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : siteName + ' - Online Shop' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Goince - Online shop in Bangladesh. Cash on Delivery, delivery in 1-2 days inside Dhaka, 3-5 days outside Dhaka.' %>">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : siteName + ' - Online Shop' %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Goince - Bangladesh-er online shop. Cash on Delivery.' %>">
  <meta property="og:type" content="website">
  <!-- Google Analytics (GA4) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QZ3JV5Z2BV"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QZ3JV5Z2BV');
  </script>
  <!-- Meta (Facebook) Pixel -->
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '2431917593964376');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=2431917593964376&ev=PageView&noscript=1"
  /></noscript>
  <!-- End Meta Pixel Code -->
  <script>
    (function () {
      var t = localStorage.getItem('goince-theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="icon" type="image/png" sizes="192x192" href="<%= (typeof siteFaviconAbs !== 'undefined' && siteFaviconAbs) ? siteFaviconAbs : '/icons/icon-192.png' %>">
  <link rel="apple-touch-icon" href="<%= (typeof siteFaviconAbs !== 'undefined' && siteFaviconAbs) ? siteFaviconAbs : '/icons/icon-192.png' %>">
  <meta property="og:url" content="<%= (typeof pageUrl !== 'undefined' && pageUrl) ? pageUrl : '' %>">
  <meta property="og:image" content="<%= (typeof siteOgImageAbs !== 'undefined' && siteOgImageAbs) ? siteOgImageAbs : '/icons/icon-512.png' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : siteName + ' - Online Shop' %>">
  <meta name="twitter:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'Goince - Bangladesh-er online shop. Cash on Delivery.' %>">
  <meta name="twitter:image" content="<%= (typeof siteOgImageAbs !== 'undefined' && siteOgImageAbs) ? siteOgImageAbs : '/icons/icon-512.png' %>">
  <% /* Google search-e logo dekhate Organization structured data — logo
        Admin > Settings > Logo theke bodlano jay (Main Logo). Google nije
        decide kore logo dekhabe ki na, ar dekhate koyek din somoy lagte pare. */ %>
  <% if (typeof isHomePage !== 'undefined' && isHomePage) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Goince",
    "url": "<%= (typeof siteUrl !== 'undefined' && siteUrl) ? siteUrl : 'https://goince.com' %>",
    "logo": "<%= (typeof siteLogoAbs !== 'undefined' && siteLogoAbs) ? siteLogoAbs : 'https://goince.com/icons/icon-192.png' %>"<% if (typeof siteSettings !== 'undefined' && siteSettings.facebook_url) { %>,
    "sameAs": ["<%= siteSettings.facebook_url %>"]<% } %>
  }
  </script>
  <% } %>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/style.css') : '/css/style.css' %>">
  <meta name="google-site-verification" content="GAj60zbiOAiiDk_FkIPCdO4W336XXdmOVd-fMGNAxgI" />
</head>
<body>
  <% if (typeof siteSettings !== 'undefined' && siteSettings.announcement_text) { %>
    <div class="announcement-bar"><%= siteSettings.announcement_text %></div>
  <% } %>
  <header class="site-header">
    <div class="container header-inner">
      <% /* Mobile header (≤768px): hamburger + logo + search icon + cart
            icon — Home / Categories / Login / Sign Up ar header-e chhoriye
            thake na, ogulo drawer-er vitore thake (niche). Desktop-e ei
            button-gulo lukano thake. Search bar mobile-e sob somoy dekhay
            na — 🔍 icon chaple niche khule (shop-search-row). */ %>
      <button type="button" class="shop-menu-btn" id="shop-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="shop-drawer">☰</button>
      <a href="/" class="logo"><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="" class="logo-mark"> <%= siteName %> <span class="logo-tag">Online Shop</span></a>
      <button type="button" class="shop-search-btn" id="shop-search-btn" aria-label="Search" aria-expanded="false" aria-controls="shop-search-row">🔍</button>
      <a href="/cart" class="shop-cart-btn" aria-label="Cart">🛒<% if (cartCount > 0) { %><span class="badge"><%= cartCount %></span><% } %></a>
      <form action="/" method="GET" class="search-form" id="shop-search-row" autocomplete="off">
        <div class="search-box">
          <input type="text" name="search" id="search-input" placeholder="Search products..." value="<%= typeof search !== 'undefined' ? search : '' %>">
          <div id="search-suggestions" class="search-suggestions" hidden></div>
        </div>
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/">Home</a>
        <% /* Header mega menu: shob category ek jaygay — DESKTOP-e (769px+)
              hover/click-e khole. Mobile-e (≤768px) main-nav lukano thake,
              bodle hamburger drawer khole (niche shop-drawer) — tai ei panel
              mobile-e ar khole na. menuCategories server.js-er global
              middleware theke ashe, tai shob page-e thake. */ %>
        <div class="mega-menu-wrap">
          <button type="button" class="mega-menu-btn" id="mega-menu-btn" aria-haspopup="true" aria-expanded="false" aria-controls="mega-menu-panel">Categories <span class="mega-caret" aria-hidden="true">▾</span></button>
          <div class="mega-menu-panel" id="mega-menu-panel">
            <% if (typeof menuCategories !== 'undefined' && menuCategories && menuCategories.length) { %>
              <div class="mega-menu-grid">
                <% menuCategories.forEach(function (cat) { %>
                  <div class="mega-col" data-cat-id="<%= cat.id %>">
                    <div class="mega-col-head">
                      <a class="mega-col-title" href="/?category=<%= cat.id %>"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" alt="" class="mega-col-thumb"><% } %><span><%= cat.name %></span><span class="mega-count">(<%= cat.totalProductCount %>)</span></a>
                      <% /* Column toggle (fix/shop-mega-menu-compact): title-er
                            pashe chhoto ▾ button — chaple oi category-r
                            child list khulbe/bondho hobe. Title nije link-i
                            thake (click-e category page-e jay); toggle
                            shudhu expand/collapse kore. Child nei emon
                            category-te toggle thake na. */ %>
                      <% if (cat.children && cat.children.length) { %>
                        <button type="button" class="mega-col-toggle" aria-expanded="false" aria-controls="mega-col-list-<%= cat.id %>" aria-label="Show sub-categories of <%= cat.name %>"><span class="mega-col-caret" aria-hidden="true">▾</span></button>
                      <% } %>
                    </div>
                    <% if (cat.children && cat.children.length) { %>
                      <ul class="mega-col-list" id="mega-col-list-<%= cat.id %>">
                        <% cat.children.forEach(function (sub) { %>
                          <li>
                            <a href="/?category=<%= sub.id %>"><%= sub.name %> <span class="mega-count">(<%= sub.totalProductCount %>)</span></a>
                            <% if (sub.children && sub.children.length) { %>
                              <ul class="mega-sub-list">
                                <% sub.children.forEach(function (g) { %>
                                  <li><a href="/?category=<%= g.id %>"><%= g.name %> <span class="mega-count">(<%= g.totalProductCount %>)</span></a></li>
                                <% }) %>
                              </ul>
                            <% } %>
                          </li>
                        <% }) %>
                      </ul>
                    <% } %>
                  </div>
                <% }) %>
              </div>
              <div class="mega-menu-footer"><a href="/">View all products →</a></div>
            <% } else { %>
              <p class="mega-menu-empty">No categories yet.</p>
            <% } %>
          </div>
        </div>
        <a href="/cart">Cart <% if (cartCount > 0) { %><span class="badge"><%= cartCount %></span><% } %></a>
        <% if (userName) { %>
          <a href="/wishlist">Wishlist</a>
          <% /* Customer profile (fix/customer-profile-section): the
                header shows the customer's photo (small circle) next
                to their name, falling back to an initial-letter circle
                when no photo is set. Links to the profile hub. */ %>
          <a href="/account/profile" class="shop-account-link"><% const _uPhoto = (typeof userPhotoUrl !== 'undefined' && userPhotoUrl) ? String(userPhotoUrl) : null; %><% if (_uPhoto) { %><span class="shop-user-avatar" aria-hidden="true"><img src="<%= _uPhoto %>" alt=""></span><% } else { %><span class="shop-user-avatar" aria-hidden="true"><%= String(userName).trim().charAt(0).toUpperCase() %></span><% } %><span><%= userName %></span></a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login" class="btn-nav-outline">Login</a>
          <a href="/signup" class="btn-nav-solid">Sign Up</a>
        <% } %>
        <button type="button" class="theme-toggle-btn" onclick="toggleGoinceTheme()" title="ডার্ক মোড">🌙</button>
      </nav>
    </div>
  </header>
  <% /* ---------- Mobile shop drawer (≤768px) ----------
     Hamburger chaple bam dik theke slide kore ashe. Desktop-e (769px+)
     CSS-e lukano thake. Categories accordion: menuCategories (server.js
     global middleware) thekei ashe — mega menu-r motoi data, lukano
     category/subtree age thekei bad. Theme toggle mobile header-e jayga
     pay na bole drawer-er niche rakha holo. */ %>
  <div class="shop-drawer-overlay" id="shop-drawer-overlay"></div>
  <aside class="shop-drawer" id="shop-drawer" aria-label="Shop menu" aria-hidden="true">
    <div class="shop-drawer-head">
      <a href="/" class="shop-drawer-logo"><img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="" class="logo-mark"> <%= siteName %></a>
      <button type="button" class="shop-drawer-close" id="shop-drawer-close" aria-label="Close menu">✕</button>
    </div>
    <nav class="shop-drawer-nav">
      <a href="/" class="shop-drawer-link">🏠 Home</a>
      <% if (typeof menuCategories !== 'undefined' && menuCategories && menuCategories.length) { %>
        <div class="shop-drawer-cats">
          <button type="button" class="shop-drawer-cat-btn" id="shop-drawer-cat-btn" aria-expanded="false" aria-controls="shop-drawer-cat-list">🗂️ Categories <span class="shop-drawer-caret" aria-hidden="true">▾</span></button>
          <ul class="shop-drawer-cat-list" id="shop-drawer-cat-list">
            <% menuCategories.forEach(function (cat) { %>
              <li class="shop-drawer-cat">
                <div class="shop-drawer-cat-head">
                  <a href="/?category=<%= cat.id %>" class="shop-drawer-cat-link"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" alt="" class="shop-drawer-cat-thumb"><% } %><span><%= cat.name %></span><span class="mega-count">(<%= cat.totalProductCount %>)</span></a>
                  <% if (cat.children && cat.children.length) { %><button type="button" class="shop-drawer-sub-toggle" aria-expanded="false" aria-label="Show sub-categories of <%= cat.name %>">▸</button><% } %>
                </div>
                <% if (cat.children && cat.children.length) { %>
                  <ul class="shop-drawer-sub">
                    <% cat.children.forEach(function (sub) { %>
                      <li>
                        <a href="/?category=<%= sub.id %>"><%= sub.name %> <span class="mega-count">(<%= sub.totalProductCount %>)</span></a>
                        <% if (sub.children && sub.children.length) { %>
                          <ul class="shop-drawer-sub-sub">
                            <% sub.children.forEach(function (g) { %>
                              <li><a href="/?category=<%= g.id %>"><%= g.name %> <span class="mega-count">(<%= g.totalProductCount %>)</span></a></li>
                            <% }) %>
                          </ul>
                        <% } %>
                      </li>
                    <% }) %>
                  </ul>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <a href="/cart" class="shop-drawer-link">🛒 Cart<% if (cartCount > 0) { %> <span class="badge"><%= cartCount %></span><% } %></a>
      <a href="/track-order" class="shop-drawer-link">📦 Track Order</a>
      <% if (userName) { %>
        <% /* Customer profile (fix/customer-profile-section): the drawer
              shows the customer's photo + name at the top of the
              account block, same avatar as the desktop header. */ %>
        <div class="shop-drawer-account"><% const _dPhoto = (typeof userPhotoUrl !== 'undefined' && userPhotoUrl) ? String(userPhotoUrl) : null; %><% if (_dPhoto) { %><span class="shop-user-avatar shop-drawer-avatar" aria-hidden="true"><img src="<%= _dPhoto %>" alt=""></span><% } else { %><span class="shop-user-avatar shop-drawer-avatar" aria-hidden="true"><%= String(userName).trim().charAt(0).toUpperCase() %></span><% } %><span class="shop-drawer-account-name"><%= userName %></span></div>
        <a href="/wishlist" class="shop-drawer-link">♥️ Wishlist</a>
        <a href="/account/profile" class="shop-drawer-link">👤 My Profile</a>
        <a href="/account" class="shop-drawer-link">📦 My Orders</a>
        <a href="/logout" class="shop-drawer-link">🚪 Logout</a>
      <% } else { %>
        <a href="/login" class="shop-drawer-link">🔑 Login</a>
        <a href="/signup" class="shop-drawer-link">📝 Sign Up</a>
      <% } %>
      <a href="/about" class="shop-drawer-link">ℹ️ About</a>
      <a href="/contact" class="shop-drawer-link">✉️ Contact</a>
    </nav>
    <div class="shop-drawer-foot">
      <button type="button" class="shop-drawer-theme" onclick="toggleGoinceTheme()">🌙 Dark mode</button>
    </div>
  </aside>
  <main class="container">
