<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= siteName %> - Online Shop</title>
  <script>
    (function () {
      var t = localStorage.getItem('goince-theme') || 'light';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <meta name="google-site-verification" content="GAj60zbiOAiiDk_FkIPCdO4W336XXdmOVd-fMGNAxgI" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo"><%= siteName %></a>
      <form action="/" method="GET" class="search-form">
        <input type="text" name="search" placeholder="Search products..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        <button type="submit">Search</button>
      </form>
      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/cart">Cart <% if (cartCount > 0) { %><span class="badge"><%= cartCount %></span><% } %></a>
        <% if (userName) { %>
          <a href="/wishlist">Wishlist</a>
          <a href="/account">My Account</a>
          <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login" class="btn-nav-outline">Login</a>
          <a href="/signup" class="btn-nav-solid">Sign Up</a>
        <% } %>
        <button type="button" class="theme-toggle-btn" onclick="toggleGoinceTheme()" title="ডার্ক মোড">🌙</button>
      </nav>
    </div>
  </header>
  <main class="container">
