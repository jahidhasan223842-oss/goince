<%- include('partials/header') %>

<% const _tk = (v) => { const n = Number(v || 0); return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2)); }; %>

<h1 class="page-title">Your Cart</h1>
<%- include('partials/checkout-steps', { step: 1 }) %>
<% /* Offline notice (feat/mobile-pwa, H4): connection chole gele
      shop-pwa.js ei div-ta dekhay — cart-er TAZA page-ta tokhon
      ar load hobe na, kintu ja dekhacche ta last-known, ar checkout
      korte connection lagbe. */ %>
<div class="offline-notice" id="offline-notice" role="status" hidden>📶 You&rsquo;re offline — this cart was loaded when you were last online. Prices and stock may have changed; checkout needs a connection.</div>

<% if (cart.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">🛒</span>
    <strong>Your cart is empty</strong>
    <p>Browse the shop and add something you like.</p>
    <a href="/" class="btn-primary">🛍️ Continue shopping</a>
  </div>
<% } else { %>
  <p class="delivery-estimate">🚚 Estimated Delivery: <strong><%= estimatedDelivery %></strong></p>

  <div class="table-responsive">
  <table class="cart-table">
    <thead>
      <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr>
    </thead>
    <tbody>
      <% cart.forEach(item => { %>
        <tr>
          <td>
            <img src="/uploads/<%= item.image %>" class="cart-thumb" onerror="this.src='/uploads/no-image.png'">
            <%= item.name %>
            <% if (item.variantLabel) { %>
              <br><span style="font-size:12px; color:var(--text-muted);"><%= item.variantLabel %></span>
            <% } %>
            <% if (item.overStock) { %>
              <p class="stock-warning">⚠️ Only <%= item.availableStock %> left in stock — quantity adjusted needed</p>
            <% } %>
          </td>
          <td><%= _tk(item.price) %></td>
          <td>
            <form action="/cart/update/<%= item.cartKey %>" method="POST" class="qty-stepper"><%- include('partials/csrf-field') %>
              <button type="submit" name="quantity" value="<%= Math.max(1, item.quantity - 1) %>" class="qty-btn">−</button>
              <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.availableStock %>" class="qty-input">
              <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="qty-btn" <%= item.quantity >= item.availableStock ? 'disabled' : '' %>>+</button>
            </form>
          </td>
          <td><%= _tk(item.price * item.quantity) %></td>
          <td class="cart-actions">
            <form action="/cart/remove/<%= item.cartKey %>" method="POST"><%- include('partials/csrf-field') %>
              <button type="submit" class="btn-remove">Remove</button>
            </form>
            <form action="/cart/save-for-later/<%= item.cartKey %>" method="POST"><%- include('partials/csrf-field') %>
              <button type="submit" class="btn-save-later">Save for later</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <div class="coupon-box">
    <% if (coupon) { %>
      <p>✅ Coupon <strong><%= coupon.code %></strong> applied (<%= coupon.discount_percent %>% off)
        <form action="/cart/remove-coupon" method="POST" style="display:inline"><%- include('partials/csrf-field') %>
          <button type="submit" class="link-btn-danger">Remove</button>
        </form>
      </p>
    <% } else { %>
      <form action="/cart/apply-coupon" method="POST" class="inline-form"><%- include('partials/csrf-field') %>
        <input type="text" name="coupon_code" placeholder="Have a coupon code?">
        <button type="submit" class="btn-primary">Apply</button>
      </form>
    <% } %>
  </div>

  <div class="cart-summary">
    <p>Subtotal: <%= _tk(subtotal) %></p>
    <% if (discount > 0) { %><p>Discount: -<%= _tk(discount) %></p><% } %>
    <h3>Total: <%= _tk(total) %></h3>
    <a href="/" class="back-link">&larr; Continue Shopping</a>
    <a href="/checkout" class="btn-primary">Proceed to Checkout</a>
    <% /* E6 (feat/payments-messaging): express checkout — sudhu
          gateway configure thakle dekhay. /checkout?pay=gateway-e
          giye gateway method age thekei beche neya thake. */ %>
    <% if (typeof gateway !== 'undefined' && gateway && gateway.configured) { %>
      <a href="/checkout?pay=gateway" class="btn-primary" style="margin-top:8px;">⚡ Pay with SSLCommerz</a>
      <p class="field-hint" style="margin-top:4px;">Pay online by card / bKash / Nagad — no Transaction ID needed.</p>
    <% } %>
  </div>
<% } %>

<% if (relatedProducts && relatedProducts.length > 0) { %>
  <div class="section-heading"><h2>You might also like</h2></div>
  <div class="product-grid">
    <% relatedProducts.forEach(p => { %>
      <div class="product-card">
        <a href="/product/<%= p.id %>">
          <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" onerror="this.src='/uploads/no-image.png'">
          <h3><%= p.name %></h3>
        </a>
        <div class="product-card-foot">
          <p class="price">৳<%= p.price %></p>
          <%- include('partials/delivery-badge', { p: p, deliveryInside: (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.inside_dhaka : 60, deliveryOutside: (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.outside_dhaka : 120 }) %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
