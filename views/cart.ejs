<%- include('partials/header') %>

<h1 class="page-title">Your Cart</h1>

<% if (cart.length === 0) { %>
  <p>Your cart is empty. <a href="/">Continue shopping</a></p>
<% } else { %>
  <p class="delivery-estimate">🚚 Estimated Delivery: <strong><%= estimatedDelivery %></strong></p>

  <div class="table-responsive">
  <table class="cart-table">
    <thead>
      <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th></th></tr>
    </thead>
    <tbody>
      <% cart.forEach(item => { %>
        <tr>
          <td>
            <img src="/uploads/<%= item.image %>" class="cart-thumb" onerror="this.src='/uploads/no-image.png'">
            <%= item.name %>
            <% if (item.variantLabel) { %>
              <br><span style="font-size:12px; color:#888;"><%= item.variantLabel %></span>
            <% } %>
            <% if (item.overStock) { %>
              <p class="stock-warning">⚠️ Only <%= item.availableStock %> left in stock — quantity adjusted needed</p>
            <% } %>
          </td>
          <td>৳<%= item.price %></td>
          <td>
            <form action="/cart/update/<%= item.cartKey %>" method="POST" class="qty-stepper">
              <button type="submit" name="quantity" value="<%= Math.max(1, item.quantity - 1) %>" class="qty-btn">−</button>
              <input type="number" name="quantity" value="<%= item.quantity %>" min="1" max="<%= item.availableStock %>" class="qty-input">
              <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="qty-btn" <%= item.quantity >= item.availableStock ? 'disabled' : '' %>>+</button>
            </form>
          </td>
          <td>৳<%= (item.price * item.quantity).toFixed(2) %></td>
          <td class="cart-actions">
            <form action="/cart/remove/<%= item.cartKey %>" method="POST">
              <button type="submit" class="btn-remove">Remove</button>
            </form>
            <form action="/cart/save-for-later/<%= item.cartKey %>" method="POST">
              <button type="submit" class="btn-save-later">Save for later</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>

  <div class="coupon-box">
    <% if (coupon) { %>
      <p>✅ Coupon <strong><%= coupon.code %></strong> applied (<%= coupon.discount_percent %>% off)
        <form action="/cart/remove-coupon" method="POST" style="display:inline">
          <button type="submit" class="link-btn-danger">Remove</button>
        </form>
      </p>
    <% } else { %>
      <form action="/cart/apply-coupon" method="POST" class="inline-form">
        <input type="text" name="coupon_code" placeholder="Have a coupon code?">
        <button type="submit" class="btn-primary">Apply</button>
      </form>
    <% } %>
  </div>

  <div class="cart-summary">
    <p>Subtotal: ৳<%= subtotal.toFixed(2) %></p>
    <% if (discount > 0) { %><p>Discount: -৳<%= discount.toFixed(2) %></p><% } %>
    <h3>Total: ৳<%= total.toFixed(2) %></h3>
    <a href="/" class="back-link">&larr; Continue Shopping</a>
    <a href="/checkout" class="btn-primary">Proceed to Checkout</a>
  </div>
<% } %>

<% if (relatedProducts && relatedProducts.length > 0) { %>
  <div class="section-heading"><h2>You might also like</h2></div>
  <div class="product-grid">
    <% relatedProducts.forEach(p => { %>
      <div class="product-card">
        <a href="/product/<%= p.id %>">
          <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" onerror="this.src='/uploads/no-image.png'">
          <h3><%= p.name %></h3>
          <p class="price">৳<%= p.price %></p>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
