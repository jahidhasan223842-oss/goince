<%- include('partials/header') %>

<% if (!selectedCategory && !search) { %>
<section class="hero">
  <div class="hero-text">
    <span class="hero-badge">✅ Cash on Delivery</span>
    <h1><%= siteSettings.hero_title %></h1>
    <p><%= siteSettings.hero_subtitle %></p>
    <a href="#products" class="btn-primary hero-cta">Shop Now ↓</a>
    <a href="/track-order" class="btn-hero-outline">Track Order</a>
  </div>
  <% if (typeof heroProduct !== 'undefined' && heroProduct) { %>
    <a href="/product/<%= heroProduct.id %>" class="hero-image">
      <img src="/uploads/<%= heroProduct.image %>" alt="<%= heroProduct.name %>" onerror="this.src='/uploads/no-image.png'">
      <span class="hero-image-caption"><%= heroProduct.name %> — ৳<%= heroProduct.price %></span>
    </a>
  <% } %>
</section>
<section class="trust-bar">
  <div>✅ Cash on Delivery</div>
  <div>🚚 Fast Delivery</div>
  <div>🔄 24h Return <span>(defective / wrong product)</span></div>
  <div>💬 WhatsApp Support</div>
</section>
<% if (typeof banners !== 'undefined' && banners && banners.length > 0) { %>
  <% banners.forEach(b => { %>
    <section class="home-banner" style="margin:16px 0; border-radius:10px; overflow:hidden; position:relative;">
      <% if (b.image) { %><img src="<%= b.image %>" alt="<%= b.title %>" style="width:100%; display:block; max-height:320px; object-fit:cover;"><% } %>
      <div style="position:absolute; left:0; right:0; bottom:0; padding:14px 18px; background:linear-gradient(transparent, rgba(0,0,0,0.65)); color:#fff;">
        <h2 style="margin:0; font-size:22px; color:#fff;"><%= b.title %></h2>
        <% if (b.subtitle) { %><p style="margin:4px 0 8px; color:#eee;"><%= b.subtitle %></p><% } %>
        <% if (b.link_url) { %><a href="<%= b.link_url %>" class="btn-primary" style="display:inline-block;">Shop Now →</a><% } %>
      </div>
    </section>
  <% }) %>
<% } %>
<% } %>

<div class="category-bar" id="products">
  <a href="/" class="<%= !selectedCategory ? 'active' : '' %>"><span class="cat-letter">A</span><span class="cat-name">All</span></a>
  <% displayCategories.forEach(cat => {
    // Pill-er sub-category thakle hover-e dropdown khulbe (menuById server.js
    // middleware theke ashe — lukano category/subtree age thekei bad, count
    // soho). Sub-category na thakle pill ager motoi sadharon link thakbe.
    const menuNode = (typeof menuById !== 'undefined' && menuById) ? menuById[cat.id] : null;
    const pillKids = (menuNode && menuNode.children) ? menuNode.children : [];
  %>
    <% if (pillKids.length) { %>
      <div class="cat-pill-wrap">
        <a href="/?category=<%= cat.id %>&sort=<%= sort %>" class="<%= selectedCategory == cat.id ? 'active' : '' %>" aria-haspopup="true"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" alt="" class="cat-thumb"><% } else { %><span class="cat-letter"><%= (cat.display_name || cat.name).charAt(0).toUpperCase() %></span><% } %><span class="cat-name"><%= cat.display_name || cat.name %></span> <span class="cat-caret" aria-hidden="true">▾</span></a>
        <div class="cat-pill-menu">
          <ul>
            <% pillKids.forEach(sub => { %>
              <li>
                <a href="/?category=<%= sub.id %>&sort=<%= sort %>"><%= sub.name %> <span class="cat-count">(<%= sub.totalProductCount %>)</span></a>
                <% if (sub.children && sub.children.length) { %>
                  <ul class="cat-pill-sub">
                    <% sub.children.forEach(g => { %>
                      <li><a href="/?category=<%= g.id %>&sort=<%= sort %>"><%= g.name %> <span class="cat-count">(<%= g.totalProductCount %>)</span></a></li>
                    <% }) %>
                  </ul>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } else { %>
      <a href="/?category=<%= cat.id %>&sort=<%= sort %>" class="<%= selectedCategory == cat.id ? 'active' : '' %>"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" alt="" class="cat-thumb"><% } else { %><span class="cat-letter"><%= (cat.display_name || cat.name).charAt(0).toUpperCase() %></span><% } %><span class="cat-name"><%= cat.display_name || cat.name %></span></a>
    <% } %>
    <% /* Sub-category pill: top-level pill-er dropdown-e thaka sub-category (jemon Kitchen, Home Utility) bar-eo sorasori pill hisebe dekhabe, jate touch-eo khuje paoa jay. */ %>
    <% pillKids.forEach(function (sub) { %>
      <a href="/?category=<%= sub.id %>&sort=<%= sort %>" class="cat-sub-pill <%= selectedCategory == sub.id ? 'active' : '' %>"><span class="cat-name"><%= sub.name %></span> <span class="cat-count">(<%= sub.totalProductCount %>)</span></a>
    <% }) %>
  <% }) %>
</div>

<% if (subCategories && subCategories.length > 0) { %>
  <div class="subcategory-bar">
    <span class="subcategory-label">In this category:</span>
    <% subCategories.forEach(sub => { %>
      <a href="/?category=<%= sub.id %>&sort=<%= sort %>" class="<%= selectedCategory == sub.id ? 'active' : '' %>"><%= sub.name.replace(/ Collection$/i, ' Products') %></a>
    <% }) %>
  </div>
<% } %>

<% if (typeof breadcrumb !== 'undefined' && breadcrumb && breadcrumb.length > 1) { %>
  <nav class="breadcrumb" aria-label="Category path">
    <a href="/">Home</a><% breadcrumb.forEach((b, i) => { %> › <% if (i < breadcrumb.length - 1) { %><a href="/?category=<%= b.id %>"><%= b.name %></a><% } else { %><span><%= b.name %></span><% } %><% }) %>
  </nav>
<% } %>

<% if (typeof selectedCategoryObj !== 'undefined' && selectedCategoryObj && selectedCategoryObj.banner_url) { %>
  <div class="cat-banner"><img src="<%= selectedCategoryObj.banner_url %>" alt="<%= selectedCategoryObj.name %>"></div>
<% } %>

<div class="toolbar-row">
  <h1 class="page-title"><% if (typeof selectedCategoryObj !== 'undefined' && selectedCategoryObj) { %><%= selectedCategoryObj.name %><% } else { %><%= search ? 'Search results' : 'All Products' %><% } %></h1>

  <form action="/" method="GET" class="sort-form">
    <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>"><% } %>
    <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
    <% if (isSeasonalCategory) { %>
      <label for="audience">Show:</label>
      <select name="audience" id="audience" onchange="this.form.submit()">
        <option value="" <%= !selectedAudience ? 'selected' : '' %>>All Audiences</option>
        <option value="men" <%= selectedAudience === 'men' ? 'selected' : '' %>>Men</option>
        <option value="women" <%= selectedAudience === 'women' ? 'selected' : '' %>>Women</option>
        <option value="kids" <%= selectedAudience === 'kids' ? 'selected' : '' %>>Kids</option>
        <option value="unisex" <%= selectedAudience === 'unisex' ? 'selected' : '' %>>Unisex</option>
      </select>
    <% } %>
    <label for="min_price">Price:</label>
    <input type="number" name="min_price" id="min_price" placeholder="Min ৳" aria-label="Minimum price" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" style="width:80px; padding:8px; border:1px solid var(--border-strong); border-radius:4px;">
    <span>–</span>
    <input type="number" name="max_price" id="max_price" placeholder="Max ৳" aria-label="Maximum price" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" style="width:80px; padding:8px; border:1px solid var(--border-strong); border-radius:4px;">
    <button type="submit" class="btn-primary" style="padding:8px 14px;">Filter</button>
    <label for="sort">Sort by:</label>
    <select name="sort" id="sort" onchange="this.form.submit()">
      <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
      <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
      <option value="price_low" <%= sort === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
      <option value="price_high" <%= sort === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
    </select>
  </form>
</div>

<% if (typeof selectedCategoryObj !== 'undefined' && selectedCategoryObj && selectedCategoryObj.description) { %>
  <p class="cat-desc"><%= selectedCategoryObj.description %></p>
<% } %>

<div class="product-grid">
  <% if (products.length === 0) { %>
    <p>No products found.</p>
  <% } %>
  <% products.forEach(p => {
       // compare_at_price thakle ebong seta price theke beshi hole discount hishab kora
       let discountPercent = 0;
       if (p.compare_at_price && p.compare_at_price > p.price) {
         discountPercent = Math.round((1 - p.price / p.compare_at_price) * 100);
       }
  %>
    <div class="product-card">
      <a href="/product/<%= p.id %>">
        <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/uploads/no-image.png'">
        <h3><%= p.name %></h3>
        <% if (p.avg_rating) { %><p class="card-rating">⭐ <%= Number(p.avg_rating).toFixed(1) %> (<%= p.review_count %>)</p><% } %>
        <div class="price-row">
          <p class="price">৳<%= p.price %></p>
          <% if (discountPercent) { %>
            <p class="compare-price">৳<%= p.compare_at_price %></p>
            <span class="discount-badge">-<%= discountPercent %>%</span>
          <% } %>
        </div>
        <% if (p.stock > 0 && p.stock <= 5) { %><p class="card-stock-low">⚠️ Only <%= p.stock %> left!</p><% } else if (p.stock === 0) { %><p class="card-stock-out">Out of stock</p><% } %>
      </a>
      <% if (p.stock > 0) { %>
        <% if (typeof variantProductIds !== 'undefined' && (variantProductIds.includes(p.id) || optionProductIds.includes(p.id))) { %>
          <a href="/product/<%= p.id %>" class="btn-card">Choose Option →</a>
        <% } else { %>
          <form action="/cart/add/<%= p.id %>" method="POST"><%- include('partials/csrf-field') %><input type="hidden" name="quantity" value="1"><button type="submit" class="btn-card">🛒 Add to Cart</button></form>
        <% } %>
      <% } %>
    </div>
  <% }) %>
</div>

<% if (typeof bestSellers !== 'undefined' && bestSellers && bestSellers.length > 0 && !selectedCategory && !search) { %>
  <div class="section-heading"><h2>🔥 Best Sellers</h2></div>
  <div class="product-grid">
    <% bestSellers.forEach(p => { %>
      <div class="product-card">
        <a href="/product/<%= p.id %>">
          <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/uploads/no-image.png'">
          <h3><%= p.name %></h3>
          <p class="price">৳<%= p.price %></p>
        </a>
      </div>
    <% }) %>
  </div>
<% } %>

<div id="recently-viewed" hidden>
  <div class="section-heading"><h2>👀 Recently Viewed</h2></div>
  <div class="product-grid" id="recently-viewed-grid"></div>
</div>

<section class="why-shop">
  <div class="section-heading"><h2>গোইন্স থেকে কেন কিনবেন?</h2></div>
  <div class="why-grid">
    <div><strong>✅ ক্যাশ অন ডেলিভারি</strong><p>পণ্য হাতে পেয়ে টাকা দিন — আগে টাকা দিতে হয় না।</p></div>
    <div><strong>🚚 দ্রুত ডেলিভারি</strong><p>ঢাকায় ১–২ দিনে, ঢাকার বাইরে ৩–৫ দিনে ডেলিভারি। অর্ডারের আগে ফোনে কনফার্ম করা হয়।</p></div>
    <div><strong>🔄 সহজ রিটার্ন</strong><p>ত্রুটিপূর্ণ বা ভুল পণ্য পেলে ২৪ ঘণ্টার ভিতরে জানালেই হবে।</p></div>
    <div><strong>💬 হোয়াটসঅ্যাপ সাপোর্ট</strong><p>যেকোনো প্রশ্নে হোয়াটসঅ্যাপে লিখুন, আমরা উত্তর দেবো।</p></div>
  </div>
</section>

<script>
  // Recently viewed: product page-e save kora list ekhane dekhano
  (function () {
    try {
      var items = JSON.parse(localStorage.getItem('goince-recent') || '[]');
      // Shudhu purno entry (id, naam, chobi) rakhbo — vanga/text-only entry dekhabe na.
      items = (items || []).filter(function (it) { return it && it.id && it.name && it.image; });
      if (!items.length) return;
      var grid = document.getElementById('recently-viewed-grid');
      grid.innerHTML = items.map(function (it) {
        return '<div class="product-card"><a href="/product/' + it.id + '"><img src="/uploads/' + it.image + '" alt="" loading="lazy" onerror="this.src=\'/uploads/no-image.png\'"><h3>' + it.name.replace(/</g, '&lt;') + '</h3><p class="price">৳' + it.price + '</p></a></div>';
      }).join('');
      document.getElementById('recently-viewed').hidden = false;
    } catch (e) {}
  })();
</script>

<%- include('partials/footer') %>
