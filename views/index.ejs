<%- include('partials/header') %>

<% if (!selectedCategory && !search) { %>
<section class="hero">
  <div class="hero-text">
    <span class="hero-badge">✅ Cash on Delivery</span>
    <h1><%= siteSettings.hero_title %></h1>
    <p><%= siteSettings.hero_subtitle %></p>
    <a href="#products" class="btn-primary hero-cta">Shop Now ↓</a>
    <a href="/track-order" class="btn-hero-outline">Track Order</a>
  </div>
  <% if (typeof heroProduct !== 'undefined' && heroProduct) { %>
    <a href="/product/<%= heroProduct.id %>" class="hero-image">
      <img src="/uploads/<%= heroProduct.image %>" alt="<%= heroProduct.name %>" onerror="this.src='/uploads/no-image.png'">
      <span class="hero-image-caption"><%= heroProduct.name %> — ৳<%= heroProduct.price %></span>
    </a>
  <% } %>
</section>
<section class="trust-bar">
  <div>✅ Cash on Delivery</div>
  <div>🚚 Fast Delivery</div>
  <div>🔄 24h Return</div>
  <div>💬 WhatsApp Support</div>
</section>
<% if (typeof banners !== 'undefined' && banners && banners.length > 0) { %>
  <% banners.forEach(b => { %>
    <section class="home-banner" style="margin:16px 0; border-radius:10px; overflow:hidden; position:relative;">
      <% if (b.image) { %><img src="<%= b.image %>" alt="<%= b.title %>" style="width:100%; display:block; max-height:320px; object-fit:cover;"><% } %>
      <div style="position:absolute; left:0; right:0; bottom:0; padding:14px 18px; background:linear-gradient(transparent, rgba(0,0,0,0.65)); color:#fff;">
        <h2 style="margin:0; font-size:22px; color:#fff;"><%= b.title %></h2>
        <% if (b.subtitle) { %><p style="margin:4px 0 8px; color:#eee;"><%= b.subtitle %></p><% } %>
        <% if (b.link_url) { %><a href="<%= b.link_url %>" class="btn-primary" style="display:inline-block;">Shop Now →</a><% } %>
      </div>
    </section>
  <% }) %>
<% } %>
<% /* I11 (feat/admin-ops): flash offers — only active offers reach
      the template (expired ones are filtered in the route), with a
      live countdown to ends_at. */ %>
<% if (typeof flashOffers !== 'undefined' && flashOffers && flashOffers.length > 0) { %>
  <section class="flash-offers" style="margin:16px 0;">
    <div class="section-heading"><h2>⚡ Flash Offers — limited time!</h2></div>
    <div class="product-grid product-grid--fill">
      <% flashOffers.forEach(o => { %>
        <% const _fp = (typeof flashOfferByProduct !== 'undefined' && flashOfferByProduct[o.product_id]) ? flashOfferByProduct[o.product_id] : o; %>
        <% const _prod = (typeof products !== 'undefined' ? products.find(pp => pp.id == o.product_id) : null) || (typeof bestSellers !== 'undefined' ? bestSellers.find(pp => pp.id == o.product_id) : null); %>
        <% if (_prod) { %>
          <div class="product-card">
            <a href="/product/<%= _prod.id %>">
              <img src="/uploads/<%= _prod.image %>" alt="<%= _prod.name %>" loading="lazy" onerror="this.src='/uploads/no-image.png'">
              <h3><%= _prod.name %></h3>
            </a>
            <div class="product-card-foot">
              <div class="price-row">
                <p class="price">৳<%= (o.sale_price !== null && o.sale_price !== undefined) ? o.sale_price : (Number(_prod.price) * (1 - Number(o.discount_percent || 0) / 100)).toFixed(2) %></p>
                <p class="compare-price">৳<%= _prod.price %></p>
              </div>
              <% if (o.title) { %><p><strong><%= o.title %></strong></p><% } %>
              <% if (o.ends_at) { %><p class="flash-countdown" data-ends="<%= new Date(o.ends_at).toISOString() %>">Ends soon — hurry!</p><% } %>
              <a href="/product/<%= _prod.id %>" class="btn-card">View Offer →</a>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  </section>
  <script>
    (function () {
      function tick() {
        document.querySelectorAll('.flash-countdown[data-ends]').forEach(function (el) {
          var ms = new Date(el.getAttribute('data-ends')).getTime() - Date.now();
          if (ms <= 0) { el.textContent = 'Offer ended'; return; }
          var h = Math.floor(ms / 3600000), m = Math.floor(ms % 3600000 / 60000), s = Math.floor(ms % 60000 / 1000);
          el.textContent = 'Ends in ' + h + 'h ' + String(m).padStart(2, '0') + 'm ' + String(s).padStart(2, '0') + 's';
        });
      }
      tick(); setInterval(tick, 1000);
    })();
  </script>
<% } %>
<% } %>

<div class="category-bar" id="products">
  <a href="/" class="<%= !selectedCategory ? 'active' : '' %>"><span class="cat-letter">A</span><span class="cat-name">All</span></a>
  <% displayCategories.forEach(cat => {
    // Pill-er sub-category thakle hover-e dropdown khulbe (menuById server.js
    // middleware theke ashe — lukano category/subtree age thekei bad, count
    // soho). Sub-category na thakle pill ager motoi sadharon link thakbe.
    const menuNode = (typeof menuById !== 'undefined' && menuById) ? menuById[cat.id] : null;
    const pillKids = (menuNode && menuNode.children) ? menuNode.children : [];
  %>
    <% if (pillKids.length) { %>
      <div class="cat-pill-wrap">
        <a href="/?category=<%= cat.id %>&sort=<%= sort %>" class="<%= selectedCategory == cat.id ? 'active' : '' %>" aria-haspopup="true"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" alt="" class="cat-thumb"><% } else { %><span class="cat-letter"><%= (cat.display_name || cat.name).charAt(0).toUpperCase() %></span><% } %><span class="cat-name"><%= cat.display_name || cat.name %></span> <span class="cat-caret" aria-hidden="true">▾</span></a>
        <div class="cat-pill-menu">
          <ul>
            <% pillKids.forEach(sub => { %>
              <li>
                <a href="/?category=<%= sub.id %>&sort=<%= sort %>"><%= sub.name %> <span class="cat-count">(<%= sub.totalProductCount %>)</span></a>
                <% if (sub.children && sub.children.length) { %>
                  <ul class="cat-pill-sub">
                    <% sub.children.forEach(g => { %>
                      <li><a href="/?category=<%= g.id %>&sort=<%= sort %>"><%= g.name %> <span class="cat-count">(<%= g.totalProductCount %>)</span></a></li>
                    <% }) %>
                  </ul>
                <% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } else { %>
      <a href="/?category=<%= cat.id %>&sort=<%= sort %>" class="<%= selectedCategory == cat.id ? 'active' : '' %>"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" alt="" class="cat-thumb"><% } else { %><span class="cat-letter"><%= (cat.display_name || cat.name).charAt(0).toUpperCase() %></span><% } %><span class="cat-name"><%= cat.display_name || cat.name %></span></a>
    <% } %>
  <% }) %>
</div>

<% if (subCategories && subCategories.length > 0) { %>
  <div class="subcategory-bar">
    <span class="subcategory-label">In this category:</span>
    <% subCategories.forEach(sub => { %>
      <a href="/?category=<%= sub.id %>&sort=<%= sort %>" class="<%= selectedCategory == sub.id ? 'active' : '' %>"><%= sub.name.replace(/ Collection$/i, ' Products') %></a>
    <% }) %>
  </div>
<% } %>

<% if (typeof breadcrumb !== 'undefined' && breadcrumb && breadcrumb.length > 1) { %>
  <nav class="breadcrumb" aria-label="Category path">
    <a href="/">Home</a><% breadcrumb.forEach((b, i) => { %> › <% if (i < breadcrumb.length - 1) { %><a href="/?category=<%= b.id %>"><%= b.name %></a><% } else { %><span><%= b.name %></span><% } %><% }) %>
  </nav>
<% } %>

<% if (typeof selectedCategoryObj !== 'undefined' && selectedCategoryObj && selectedCategoryObj.banner_url) { %>
  <div class="cat-banner"><img src="<%= selectedCategoryObj.banner_url %>" alt="<%= selectedCategoryObj.name %>"></div>
<% } %>

<div class="toolbar-row">
  <h1 class="page-title"><% if (typeof selectedCategoryObj !== 'undefined' && selectedCategoryObj) { %><%= selectedCategoryObj.name %><% } else { %><%= search ? 'Search results' : 'All Products' %><% } %></h1>

  <form action="/" method="GET" class="sort-form">
    <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>"><% } %>
    <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
    <% if (isSeasonalCategory) { %>
      <label for="audience">Show:</label>
      <select name="audience" id="audience" onchange="this.form.submit()">
        <option value="" <%= !selectedAudience ? 'selected' : '' %>>All Audiences</option>
        <option value="men" <%= selectedAudience === 'men' ? 'selected' : '' %>>Men</option>
        <option value="women" <%= selectedAudience === 'women' ? 'selected' : '' %>>Women</option>
        <option value="kids" <%= selectedAudience === 'kids' ? 'selected' : '' %>>Kids</option>
        <option value="unisex" <%= selectedAudience === 'unisex' ? 'selected' : '' %>>Unisex</option>
      </select>
    <% } %>
    <label for="min_price">Price:</label>
    <input type="number" name="min_price" id="min_price" placeholder="Min ৳" aria-label="Minimum price" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>" class="price-input">
    <span>–</span>
    <input type="number" name="max_price" id="max_price" placeholder="Max ৳" aria-label="Maximum price" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>" class="price-input">
    <button type="submit" class="btn-primary" style="padding:8px 14px;">Filter</button>
    <% /* C1 faceted filters (feat/discovery-search, PR #85): brand /
          rating / in-stock / discount — price-er pashe, eki form-e,
          tai category/search/sort-er sathe compose kore. Shob
          typeof-guard diye lekha, jate purono direct render-e
          (test) egulo na thakleo na vange. */ %>
    <label for="brand">Brand:</label>
    <select name="brand" id="brand" onchange="this.form.submit()">
      <option value="" <%= (typeof selectedBrand === 'undefined' || !selectedBrand) ? 'selected' : '' %>>All Brands</option>
      <% if (typeof brands !== 'undefined' && brands) { brands.forEach(b => { %>
        <option value="<%= b %>" <%= (typeof selectedBrand !== 'undefined' && selectedBrand === b) ? 'selected' : '' %>><%= b %></option>
      <% }) } %>
    </select>
    <label for="rating">Rating:</label>
    <select name="rating" id="rating" onchange="this.form.submit()">
      <option value="" <%= (typeof minRating === 'undefined' || minRating === null || minRating === '') ? 'selected' : '' %>>Any rating</option>
      <option value="4" <%= (typeof minRating !== 'undefined' && Number(minRating) === 4) ? 'selected' : '' %>>4★ &amp; up</option>
      <option value="3" <%= (typeof minRating !== 'undefined' && Number(minRating) === 3) ? 'selected' : '' %>>3★ &amp; up</option>
    </select>
    <label class="filter-check"><input type="checkbox" name="in_stock" value="1" onchange="this.form.submit()" <%= (typeof inStockOnly !== 'undefined' && inStockOnly) ? 'checked' : '' %>> In stock only</label>
    <label class="filter-check"><input type="checkbox" name="discount" value="1" onchange="this.form.submit()" <%= (typeof onDiscount !== 'undefined' && onDiscount) ? 'checked' : '' %>> On discount</label>
    <% if (typeof hasActiveFilters !== 'undefined' && hasActiveFilters) { %><a href="<%= (typeof clearFiltersUrl !== 'undefined' && clearFiltersUrl) ? clearFiltersUrl : '/' %>" class="filter-clear">Clear filters ✕</a><% } %>
    <label for="sort">Sort by:</label>
    <select name="sort" id="sort" onchange="this.form.submit()">
      <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest</option>
      <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Most Popular</option>
      <option value="price_low" <%= sort === 'price_low' ? 'selected' : '' %>>Price: Low to High</option>
      <option value="price_high" <%= sort === 'price_high' ? 'selected' : '' %>>Price: High to Low</option>
    </select>
  </form>
</div>

<% if (typeof selectedCategoryObj !== 'undefined' && selectedCategoryObj && selectedCategoryObj.description) { %>
  <p class="cat-desc"><%= selectedCategoryObj.description %></p>
<% } %>

<% /* C2 (feat/discovery-search): exact search-e kichu na mille
      fuzzy fallback-er note + "Did you mean" suggestion — click
      korle corrected search-ta abar cholbe. */ %>
<% if (typeof fuzzyApplied !== 'undefined' && fuzzyApplied && search) { %>
  <p class="search-note">No exact matches for “<%= search %>” — showing the closest matches.</p>
<% } %>
<% if (typeof didYouMean !== 'undefined' && didYouMean) { %>
  <p class="did-you-mean">Did you mean: <a href="/?search=<%= encodeURIComponent(didYouMean) %>"><%= didYouMean %></a>?</p>
<% } %>

<div id="product-grid-wrap">
<div class="product-grid">
  <!-- grid-items-start -->
  <% if (products.length === 0) { %>
    <p>No products found.</p>
  <% } %>
  <% products.forEach(p => {
       // compare_at_price thakle ebong seta price theke beshi hole discount hishab kora
       let discountPercent = 0;
       if (p.compare_at_price && p.compare_at_price > p.price) {
         discountPercent = Math.round((1 - p.price / p.compare_at_price) * 100);
       }
  %>
    <div class="product-card">
      <a href="/product/<%= p.id %>">
        <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/uploads/no-image.png'">
        <% /* A5 hover preview: 2nd gallery chobi thakle hover-e etai
              dekhabe (CSS opacity swap); na thakle kichui na — ektai
              chobi thake. DOM-e thakay browser age thekei load kore,
              tai swap-e flash hoy na. Chobi na pele nijeke soriye
              ney, jate hover-e main chobi-i thake. */ %>
        <% if (typeof secondImages !== 'undefined' && secondImages && secondImages[p.id]) { %><img class="product-card-img-alt" src="/uploads/<%= secondImages[p.id] %>" alt="" aria-hidden="true" loading="lazy" onerror="this.remove()"><% } %>
        <h3><%= p.name %></h3>
        <% if (p.avg_rating) { %><p class="card-rating">⭐ <%= Number(p.avg_rating).toFixed(1) %> (<%= p.review_count %>)</p><% } %>
      </a>
      <div class="product-card-foot">
        <div class="price-row">
          <p class="price">৳<%= p.price %></p>
          <% if (discountPercent) { %>
            <p class="compare-price">৳<%= p.compare_at_price %></p>
            <span class="discount-badge">-<%= discountPercent %>%</span>
          <% } %>
        </div>
        <% if (p.stock > 0 && p.stock <= 5) { %><p class="card-stock-low">⚠️ Only <%= p.stock %> left!</p><% } else if (p.stock === 0) { %><p class="card-stock-out">Out of stock</p><% } %>
        <%- include('partials/delivery-badge', { p: p, deliveryInside: (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.inside_dhaka : 60, deliveryOutside: (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.outside_dhaka : 120 }) %>
        <% if (p.stock > 0) { %>
          <% if (typeof variantProductIds !== 'undefined' && (variantProductIds.includes(p.id) || optionProductIds.includes(p.id))) { %>
            <a href="/product/<%= p.id %>" class="btn-card">Choose Option →</a>
          <% } else { %>
            <form action="/cart/add/<%= p.id %>" method="POST"><%- include('partials/csrf-field') %><input type="hidden" name="quantity" value="1"><button type="submit" class="btn-card">🛒 Add to Cart</button></form>
          <% } %>
        <% } %>
        <button type="button" class="btn-card btn-card--compare" data-compare-id="<%= p.id %>" style="margin-top:6px; background:transparent; color:var(--text-muted); border:1px solid var(--border);">⇄ Compare</button>
      </div>
    </div>
  <% }) %>
  <!-- grid-items-end -->
</div>
</div>

<% /* C4 (feat/discovery-search): "Load more" — porer page thaklei
      dekhabe. JS na cholle sadharon link hisebe ?page= khule (full
      page, server-er paginated list); JS cholle public/js/load-more.js
      click-ta dhore oi page-er card-gulo reload charai bosiye dey. */ %>
<% if (typeof pagination !== 'undefined' && pagination && pagination.hasMore) { %>
  <div class="load-more-wrap">
    <a href="<%= pagination.nextPageUrl %>" class="btn-primary" id="load-more-btn" data-next-url="<%= pagination.nextPageUrl %>">Load more</a>
  </div>
<% } %>

<% if (typeof bestSellers !== 'undefined' && bestSellers && bestSellers.length > 0 && !selectedCategory && !search) { %>
  <div class="section-heading" data-reveal><h2>🔥 Best Sellers</h2></div>
  <div class="product-grid product-grid--fill">
    <% bestSellers.forEach(p => { %>
      <div class="product-card">
        <a href="/product/<%= p.id %>">
          <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" loading="lazy" onerror="this.src='/uploads/no-image.png'">
          <% if (typeof secondImages !== 'undefined' && secondImages && secondImages[p.id]) { %><img class="product-card-img-alt" src="/uploads/<%= secondImages[p.id] %>" alt="" aria-hidden="true" loading="lazy" onerror="this.remove()"><% } %>
          <h3><%= p.name %></h3>
        </a>
        <div class="product-card-foot">
          <p class="price">৳<%= p.price %></p>
          <%- include('partials/delivery-badge', { p: p, deliveryInside: (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.inside_dhaka : 60, deliveryOutside: (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.outside_dhaka : 120 }) %>
          <% if (p.stock > 0) { %>
            <% if (typeof variantProductIds !== 'undefined' && (variantProductIds.includes(p.id) || optionProductIds.includes(p.id))) { %>
              <a href="/product/<%= p.id %>" class="btn-card">Choose Option →</a>
            <% } else { %>
              <form action="/cart/add/<%= p.id %>" method="POST"><%- include('partials/csrf-field') %><input type="hidden" name="quantity" value="1"><button type="submit" class="btn-card">🛒 Add to Cart</button></form>
            <% } %>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<div id="recently-viewed" hidden>
  <div class="section-heading" data-reveal><h2>👀 Recently Viewed</h2></div>
  <div class="product-grid product-grid--fill" id="recently-viewed-grid" data-csrf="<%= (typeof csrfToken !== 'undefined' && csrfToken) ? csrfToken : '' %>" data-products='<%- JSON.stringify(typeof recentlyViewedMap !== "undefined" ? recentlyViewedMap : {}) %>' data-delivery-inside="<%= (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.inside_dhaka : 60 %>" data-delivery-outside="<%= (typeof deliveryCharges !== 'undefined' && deliveryCharges) ? deliveryCharges.outside_dhaka : 120 %>">
    <% /* A2 skeleton: card gulo JS-e localStorage theke toiri hoy —
          toiri howar age ei shimmer card gulo jayga dhore rakhe.
          JS render korlei innerHTML bodle jay (skeleton sore jay);
          kono recent item na thakle section-tai hidden thake, tai
          skeleton kokhono dekha jay na. Main grid server-rendered,
          tai okhane skeleton NEI (fake loading dekhano hobe na). */ %>
    <% for (let s = 0; s < 4; s++) { %><div class="skeleton-card" aria-hidden="true"><div class="skeleton-img"></div><div class="skeleton-line"></div><div class="skeleton-line skeleton-line--short"></div><div class="skeleton-btn"></div></div><% } %>
  </div>
</div>

<section class="why-shop">
  <div class="section-heading" data-reveal><h2>Why Shop With Goince?</h2></div>
  <div class="why-grid">
    <div data-reveal><strong>✅ Cash on Delivery</strong><p>Product hate peye taka dao — age taka dite hoy na.</p></div>
    <div data-reveal><strong>🚚 Fast Delivery</strong><p>Dhaka 1–2 din, baire 3–5 din. Order-er age phone-e confirm.</p></div>
    <div data-reveal><strong>🔄 Easy Return</strong><p>Defective ba vul product pele 24 ghontar vitore janalei hobe.</p></div>
    <div data-reveal><strong>💬 WhatsApp Support</strong><p>Jekono proshne WhatsApp-e likho, amra uttor dibo.</p></div>
  </div>
</section>

<script>
  // Recently viewed: product page-e save kora list ekhane dekhano.
  // Card-e All Products-er motoi button thake (fix/product-hover-gallery):
  // variant/option thakle "Choose Option →" (product page-e giye beche
  // nite hobe), na thakle stock thakle direct Add to Cart form — CSRF
  // token grid-er data-csrf theke neya (form-eo oi token-i thake, notun
  // kono exposure na). Notun save-e stock + hasOptions flag thake
  // (primary); purono save-e (PR #69-er age) flag nei — tokhon server
  // map (grid-er data-products: id -> { stock, hasOptions }) theke neya
  // hoy fallback hishebe. Map-eo na thakle (product muche geche) safe
  // route: "Choose Option →". Stock 0 hole kono button nei.
  (function () {
    try {
      var items = JSON.parse(localStorage.getItem('goince-recent') || '[]');
      if (!items.length) return;
      var grid = document.getElementById('recently-viewed-grid');
      var csrf = grid.getAttribute('data-csrf') || '';
      var serverMap = {};
      try { serverMap = JSON.parse(grid.getAttribute('data-products') || '{}'); } catch (e) { serverMap = {}; }
      // Delivery badge (feat/cart-buying, B4): server-rendered card-er
      // partial-er motoi lekha — Free Delivery hole sobuj badge, na
      // hole zone charge-er range. Charge duto grid-er data attribute
      // theke ase (settings theke), na thakle ৳60/৳120 default.
      var delIn = parseFloat(grid.getAttribute('data-delivery-inside')) || 60;
      var delOut = parseFloat(grid.getAttribute('data-delivery-outside')) || 120;
      function deliveryBadgeHTML(free) {
        if (free) return '<span class="delivery-badge delivery-badge--free">🚚 Free Delivery</span>';
        return '<span class="delivery-badge" title="Delivery: ৳' + delIn + ' inside Dhaka / ৳' + delOut + ' outside Dhaka">🚚 Delivery ৳' + delIn + '–৳' + delOut + '</span>';
      }
      grid.innerHTML = items.map(function (it) {
        var card = '<div class="product-card"><a href="/product/' + it.id + '"><img src="/uploads/' + it.image + '" alt="" loading="lazy" onerror="this.src=\'/uploads/no-image.png\'"><h3>' + it.name.replace(/</g, '&lt;') + '</h3></a><div class="product-card-foot"><p class="price">৳' + it.price + '</p>';
        // Saved flags primary; na thakle server map fallback.
        var flags = (typeof it.hasOptions === 'boolean' && typeof it.stock === 'number')
          ? { hasOptions: it.hasOptions, stock: it.stock }
          : (serverMap[it.id] || null);
        var isFree = (typeof it.freeDelivery === 'boolean')
          ? it.freeDelivery
          : (serverMap[it.id] ? !!serverMap[it.id].freeDelivery : false);
        card += deliveryBadgeHTML(isFree);
        if (flags && flags.hasOptions) {
          card += '<a href="/product/' + it.id + '" class="btn-card">Choose Option →</a>';
        } else if (flags && flags.stock > 0 && csrf) {
          card += '<form action="/cart/add/' + it.id + '" method="POST"><input type="hidden" name="_csrf" value="' + csrf + '"><input type="hidden" name="quantity" value="1"><button type="submit" class="btn-card">🛒 Add to Cart</button></form>';
        } else if (flags && flags.stock > 0) {
          card += '<a href="/product/' + it.id + '" class="btn-card">Choose Option →</a>';
        } else if (!flags) {
          card += '<a href="/product/' + it.id + '" class="btn-card">Choose Option →</a>';
        }
        return card + '</div></div>';
      }).join('');
      document.getElementById('recently-viewed').hidden = false;
    } catch (e) {}
  })();
</script>

<%- include('partials/footer') %>
