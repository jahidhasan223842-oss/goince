<%- include('../partials/header') %>

<h1 class="page-title">Order #<%= order.id %></h1>

<div class="order-detail-box">
  <p><strong>Status:</strong> <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span></p>
  <p><strong>Payment Status:</strong> <span class="status-badge <%= order.payment_status === 'Paid' ? 'status-delivered' : 'status-pending' %>"><%= order.payment_status || 'Unpaid' %></span></p>
  <p><strong>Delivery Address:</strong> <%= order.address %></p>
  <p><strong>Payment Method:</strong> <%= order.payment_method %></p>
  <% if (order.transaction_id) { %><p><strong>Transaction ID:</strong> <%= order.transaction_id %></p><% } %>
  <% if (order.courier_name) { %><p><strong>Courier:</strong> <%= order.courier_name %><% if (order.tracking_number) { %> (Tracking: <%= order.tracking_number %>)<% } %></p><% } %>
  <p><strong>Order Date:</strong> <%= new Date(order.created_at).toLocaleString() %></p>
</div>

<div class="table-responsive">
<table class="cart-table">
  <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Subtotal</th></tr></thead>
  <tbody>
    <% items.forEach(item => { %>
      <tr>
        <td><%= item.product_name %><% if (item.variant_label) { %><br><span style="font-size:12px; color:#888;"><%= item.variant_label %></span><% } %></td>
        <td>৳<%= item.price %></td>
        <td><%= item.quantity %></td>
        <td>৳<%= (item.price * item.quantity).toFixed(2) %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>

<div class="cart-summary">
  <% if (order.discount_amount > 0) { %>
    <p>Coupon (<%= order.coupon_code %>): -৳<%= order.discount_amount %></p>
  <% } %>
  <p>Delivery Charge: ৳<%= Number(order.delivery_charge || 0).toFixed(2) %></p>
  <h3>Total: ৳<%= order.total_amount %></h3>
</div>

<% if (typeof returnMsg !== 'undefined' && returnMsg) { %><p class="success-msg" style="text-align:left;"><%= returnMsg %></p><% } %>
<% if (typeof returnErr !== 'undefined' && returnErr) { %><p class="error-msg" style="text-align:left;"><%= returnErr %></p><% } %>

<% const _returns = (typeof returns !== 'undefined' && returns) ? returns : []; %>
<% if (_returns.length) { %>
  <h2>Return / Cancel Requests</h2>
  <ul>
    <% _returns.forEach(r => { %>
      <li><strong><%= r.status %></strong> — <%= (r.request_type === 'cancel' ? 'Cancel request' : 'Return request') %> — <%= r.reason %> <small>(<%= new Date(r.created_at).toLocaleString() %>)</small></li>
    <% }) %>
  </ul>
<% } %>

<% if (order.status !== 'Cancelled' && order.status !== 'Delivered') { %>
  <h2>Request a Return or Cancellation</h2>
  <p class="field-hint">Changed your mind or need to return something? Tell us why — the shop will review your request. Our return policy: you may request a return within <strong>24 hours</strong> of delivery. <a href="/return-policy">Read the full return policy</a>.</p>
  <form action="/account/orders/<%= order.id %>/return" method="POST" class="admin-form" style="max-width:500px;"><%- include('../partials/csrf-field') %>
    <label>What do you want to do?</label>
    <select name="request_type">
      <option value="return">Return this order</option>
      <option value="cancel">Cancel this order</option>
    </select>
    <label>Reason</label>
    <textarea name="reason" rows="3" placeholder="e.g. Wrong size — I need a bigger one." required></textarea>
    <button type="submit" class="btn-primary">Send Request</button>
  </form>
<% } else if (order.status === 'Delivered') { %>
  <h2>Request a Return</h2>
  <p class="field-hint">This order was delivered. You may request a return within <strong>24 hours</strong> of delivery — <a href="/return-policy">read the full return policy</a>.</p>
  <form action="/account/orders/<%= order.id %>/return" method="POST" class="admin-form" style="max-width:500px;"><%- include('../partials/csrf-field') %>
    <input type="hidden" name="request_type" value="return">
    <label>Reason</label>
    <textarea name="reason" rows="3" placeholder="e.g. The product arrived damaged." required></textarea>
    <button type="submit" class="btn-primary">Request Return</button>
  </form>
<% } %>

<a href="/account" class="back-link">&larr; Back to My Orders</a>

<%- include('../partials/footer') %>
