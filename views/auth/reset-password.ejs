<%- include('../partials/header') %>

<div class="auth-box">
  <h1>Reset Password</h1>
  <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

  <% if (token) { %>
    <form action="/reset-password/<%= token %>" method="POST">
      <label>New Password</label>
      <div class="password-wrapper">
        <input type="password" name="password" id="reset-password-1" minlength="6" required>
        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this, 'reset-password-1')">Show</button>
      </div>
      <label>Confirm New Password</label>
      <div class="password-wrapper">
        <input type="password" name="confirm_password" id="reset-password-2" minlength="6" required>
        <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility(this, 'reset-password-2')">Show</button>
      </div>
      <button type="submit" class="btn-primary">Reset Password</button>
    </form>
  <% } else { %>
    <p><a href="/forgot-password">Try requesting a new link</a></p>
  <% } %>
</div>

<%- include('../partials/footer') %>
