<%- include('../partials/header') %>

<div class="admin-page-header">
  <h1 class="page-title">My Orders</h1>
  <a href="/account/profile" class="btn-primary">Edit Profile</a>
</div>

<% if (orders.length === 0) { %>
  <p>You haven't placed any orders yet. <a href="/">Start Shopping</a></p>
<% } else { %>
  <div class="table-responsive">
  <table class="cart-table">
    <thead><tr><th>Order ID</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr></thead>
    <tbody>
      <% orders.forEach(o => { %>
        <tr>
          <td>#<%= o.id %></td>
          <td>৳<%= o.total_amount %></td>
          <td><span class="status-badge status-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
          <td><%= new Date(o.created_at).toLocaleDateString() %></td>
          <td><a href="/account/orders/<%= o.id %>">View Details</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
