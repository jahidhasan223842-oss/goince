</script>

<!-- Google Analytics: add_to_cart event (form submit howar age fire hoy) -->
<script>
  (function () {
    const cartForm = document.getElementById('add-to-cart-form');
    if (cartForm) {
      cartForm.addEventListener('submit', function () {
        const qtyInput = document.getElementById('quantity');
        const qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;
        gtag('event', 'add_to_cart', {
          currency: 'BDT',
          value: <%= product.price %> * qty,
          items: [{
            item_id: '<%= product.id %>',
            item_name: <%- JSON.stringify(product.name) %>,
            price: <%= product.price %>,
            quantity: qty
          }]
        });
        fbq('track', 'AddToCart', {
          content_ids: ['<%= product.id %>'],
          content_type: 'product',
          value: <%= product.price %> * qty,
          currency: 'BDT'
        });
      });
    }
  })();
</script>

<% /* G2 recent-purchase popup (feat/product-page): SUDHU ashol
      order theke ase (server route-e DB theke) — kono recent order
      na thakle ei div-ta ekebarei render hoy na. 4s pore ase, 10s
      pore nije theke jay, × diye bondho kora jay. */ %>
<% if (typeof recentPurchase !== 'undefined' && recentPurchase) { %>
  <div class="recent-purchase-popup" id="recent-purchase-popup" hidden>
    <span aria-hidden="true">🛍️</span>
    <p><%= recentPurchase %></p>
    <button type="button" class="recent-purchase-close" id="recent-purchase-close" aria-label="Dismiss">×</button>
  </div>
  <script>
    (function () {
      var pop = document.getElementById('recent-purchase-popup');
      var closeBtn = document.getElementById('recent-purchase-close');
      if (!pop) return;
      function show() { pop.hidden = false; if (pop.classList) pop.classList.add('is-visible'); }
      function hide() { pop.hidden = true; if (pop.classList) pop.classList.remove('is-visible'); }
      if (closeBtn) closeBtn.addEventListener('click', hide);
      setTimeout(show, 4000);
      setTimeout(hide, 14000);
    })();
  </script>
<% } %>

<script>
  // D3 helpful vote (feat/product-page): button chaple POST
  // /product/review/:id/helpful — CSRF token x-csrf-token header-e
  // (reviews-section-er data-csrf-token theke). Toggle: vote dile
  // count bare + button highlight hoy, abar chaple vote tule neoa
  // hoy + count kome. Ekjon-ekbar — route + DB UNIQUE key diye.
  (function () {
    var section = document.querySelector('.reviews-section');
    if (!section) return;
    var token = section.getAttribute('data-csrf-token') || '';
    section.addEventListener('click', function (e) {
      var btn = e.target && e.target.closest ? e.target.closest('.helpful-btn') : null;
      if (!btn) return;
      var id = btn.getAttribute('data-review-id');
      if (!id) return;
      fetch('/product/review/' + id + '/helpful', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'x-csrf-token': token, 'Accept': 'application/json' },
        credentials: 'same-origin'
      }).then(function (r) { return r.json(); }).then(function (d) {
        if (!d || !d.ok) return;
        var countEl = btn.querySelector('.helpful-count');
        if (countEl) countEl.textContent = String(d.count);
        if (btn.classList) btn.classList.toggle('is-voted', !!d.helpful);
      }).catch(function () {});
    });
  })();
  // D2 "Add all to cart" (feat/product-page): ei product + bundle-er
  // prottekta complement — ekta kore fetch POST /cart/add/:id
  // (PR #80-er AJAX flow: page reload noy). Sesh uttor-er
  // drawerHtml + cartCount diye footer-er mini-cart bridge
  // (window.GoinceMiniCart) drawer refresh kore + khole + toast
  // dekhay. Bridge na thakle (footer JS bondho) page reload kore
  // cart-er notun obostha dekhano hoy.
  (function () {
    var btn = document.getElementById('bundle-add-all');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var ids = (btn.getAttribute('data-bundle-ids') || '').split(',').filter(Boolean);
      var allIds = [String(<%= product.id %>)].concat(ids);
      var tokenEl = document.getElementById('bundle-csrf');
      var token = tokenEl ? tokenEl.value : '';
      var i = 0;
      var last = null;
      var failed = 0;
      btn.disabled = true;
      var origText = btn.textContent;
      btn.textContent = 'Adding…';
      function finish() {
        btn.disabled = false;
        btn.textContent = origText;
        if (last && window.GoinceMiniCart) {
          window.GoinceMiniCart.refresh(last.cartCount, last.drawerHtml);
          window.GoinceMiniCart.open();
          window.GoinceMiniCart.toast(failed ? '✓ Bundle added to cart (' + failed + ' item(s) could not be added)' : '✓ Bundle added to cart', failed > 0);
        } else if (last) {
          window.location.reload();
        } else if (window.GoinceMiniCart) {
          window.GoinceMiniCart.toast('Could not add bundle to cart. Please try again.', true);
        }
      }
      function next() {
        if (i >= allIds.length) { finish(); return; }
        var id = allIds[i++];
        fetch('/cart/add/' + id, {
          method: 'POST',
          headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
          body: '_csrf=' + encodeURIComponent(token) + '&quantity=1',
          credentials: 'same-origin'
        }).then(function (r) {
          return r.json().catch(function () { return null; }).then(function (d) { return { ok: r.ok, data: d }; });
        }).then(function (r) {
          if (r.ok && r.data && r.data.ok) last = r.data; else failed++;
          next();
        }).catch(function () { failed++; next(); });
      }
      next();
    });
  })();
</script>

