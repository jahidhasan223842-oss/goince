<script>
  function copyProductLink() {
    navigator.clipboard.writeText(location.href).then(function () { alert('Link copied!'); });
  }
  // Recently viewed-e save kora (homepage-e dekhabe). stock + hasOptions-o
  // save kora hoy — homepage-e Recently Viewed card-er button (Add to
  // Cart na Choose Option) ei duto diye thik hoy (fix/product-hover-gallery).
  try {
    var recent = JSON.parse(localStorage.getItem('goince-recent') || '[]');
    recent = recent.filter(function (it) { return it.id !== <%= product.id %>; });
    recent.unshift({ id: <%= product.id %>, name: <%- JSON.stringify(product.name) %>, price: <%= product.price %>, image: <%- JSON.stringify(product.image || 'no-image.png') %>, stock: <%= product.stock %>, freeDelivery: <%= product.free_shipping ? 'true' : 'false' %>, hasOptions: <%= ((variants && variants.length > 0) || (options && options.length > 0)) ? 'true' : 'false' %> });
    localStorage.setItem('goince-recent', JSON.stringify(recent.slice(0, 4)));
  } catch (e) {}
  function swapImage(el, src) {
    // D1: chobi-te firle video lukay + pause hoy, chobi abar dekha jay.
    var _video = document.getElementById('product-video');
    if (_video) { _video.hidden = true; if (_video.pause) _video.pause(); }
    var _img = document.getElementById('main-product-image');
    if (_img) _img.hidden = false;
    // Gallery module thakle shetai chobi bodlay (index + zoom reset
    // soho); na thakle purono upay (direct src bodol + active class).
    if (window.GoinceGallery) { window.GoinceGallery.showBySrc(src, el); return; }
    document.getElementById('main-product-image').src = src;
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }
  // D1: video thumbnail chaple chobi lukay, video player ase + play hoy.
  function showProductVideo(el) {
    var video = document.getElementById('product-video');
    var img = document.getElementById('main-product-image');
    if (!video || !img) return;
    img.hidden = true;
    video.hidden = false;
    document.querySelectorAll('.thumbnail').forEach(function (t) { t.classList.remove('active'); });
    if (el) el.classList.add('active');
    if (video.play) { var p = video.play(); if (p && p.catch) p.catch(function () {}); }
  }

  function selectOption(el) {
    document.querySelectorAll('.option-pill').forEach(s => s.style.borderColor = '#ddd');
    el.style.borderColor = '#f0a500';
    document.getElementById('option_id_input').value = el.dataset.optionId;
    document.getElementById('selected-option-name').textContent = el.dataset.optionName;
    if (el.dataset.optionImage) {
      document.getElementById('main-product-image').src = el.dataset.optionImage;
      document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    }
  }

  <% if (options && options.length > 0) { %>
  // Page load hote-i prothom option-ta selected dekhano
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('selected-option-name').textContent = <%- JSON.stringify(options[0].value_name) %>;
  });
  <% } %>

  <% if (variants && variants.length > 0) { %>
  // Product-er shob variant, prottekta-r attribute combination shoho
  const variantData = <%- JSON.stringify(variants.map(v => ({
    id: v.id,
    price: v.price,
    compare_at_price: v.compare_at_price,
    image: v.image,
    stock: v.stock,
    attrs: v.attrs.reduce((acc, a) => { acc[a.attribute_id] = a.value_id; return acc; }, {})
  }))) %>;
  const allowBackorder = <%= product.allow_backorder ? 'true' : 'false' %>;

  const selects = document.querySelectorAll('.variant-attr-select');
  const form = document.getElementById('add-to-cart-form');
  const msg = document.getElementById('variant-message');
  const priceEl = document.getElementById('display-price');
  const stockEl = document.getElementById('display-stock');
  const variantIdInput = document.getElementById('variant_id_input');
  const qtyInput = document.getElementById('quantity');
  const addBtn = document.getElementById('add-to-cart-btn');
  const buyNowBtn = document.getElementById('buy-now-btn');
  const stickyPriceEl = document.getElementById('sticky-buy-price');
  const stickyBuyBtn = document.getElementById('sticky-buy-btn');

  function updateVariantSelection() {
    const selection = {};
    let allSelected = true;
    selects.forEach(sel => {
      if (sel.value) {
        selection[sel.dataset.attributeId] = sel.value;
      } else {
        allSelected = false;
      }
    });

    if (!allSelected) {
      form.style.display = 'none';
      msg.textContent = '';
      return;
    }

    const match = variantData.find(v => {
      return Object.keys(selection).every(attrId => String(v.attrs[attrId]) === String(selection[attrId]));
    });

    if (!match) {
      form.style.display = 'none';
      msg.textContent = 'This combination is currently unavailable.';
      return;
    }

    msg.textContent = '';
    variantIdInput.value = match.id;
    priceEl.textContent = '৳' + Number(match.price).toFixed(2);
    // B2: sticky bar-er daam-o variant-er sathe bodlay.
    if (stickyPriceEl) stickyPriceEl.textContent = '৳' + Number(match.price).toFixed(2);
    // Variant-er nijer chobi thakle main chobi bodle jabe (lal/nil alada chobi)
    if (match.image) {
      const mainImg = document.getElementById('main-product-image');
      if (mainImg) mainImg.src = '/uploads/' + match.image;
    }
    // Variant-er chhar thakle purono dam kata dam-e dekhabe
    const compareEl = document.getElementById('display-compare-price');
    const badgeEl = document.getElementById('display-discount-badge');
    if (match.compare_at_price && Number(match.compare_at_price) > Number(match.price)) {
      compareEl.textContent = '৳' + Number(match.compare_at_price).toFixed(2);
      compareEl.style.display = '';
      const pct = Math.round((1 - Number(match.price) / Number(match.compare_at_price)) * 100);
      badgeEl.textContent = '-' + pct + '%';
      badgeEl.style.display = '';
    } else {
      compareEl.style.display = 'none';
      badgeEl.style.display = 'none';
    }
    if (match.stock > 0) {
      stockEl.textContent = match.stock + ' in stock';
      qtyInput.max = match.stock;
      qtyInput.value = 1;
      addBtn.disabled = false;
      addBtn.textContent = 'Add to Cart';
      // B3: Buy Now-o variant-er sathe chalu/bondho hoy — stock
      // na thakle Buy Now-eo vul variant jabe na.
      if (buyNowBtn) buyNowBtn.disabled = false;
      if (stickyBuyBtn) stickyBuyBtn.disabled = false;
      form.style.display = '';
    } else if (allowBackorder) {
      stockEl.textContent = 'Pre-order — stock asle delivery hobe';
      qtyInput.removeAttribute('max');
      qtyInput.value = 1;
      addBtn.disabled = false;
      addBtn.textContent = 'Pre-order Now';
      if (buyNowBtn) buyNowBtn.disabled = false;
      if (stickyBuyBtn) stickyBuyBtn.disabled = false;
      form.style.display = '';
    } else {
      stockEl.textContent = 'Out of stock — ei combination-ti ekhon nei';
      addBtn.disabled = true;
      addBtn.textContent = 'Out of Stock';
      if (buyNowBtn) buyNowBtn.disabled = true;
      if (stickyBuyBtn) stickyBuyBtn.disabled = true;
      form.style.display = '';
    }
  }

  selects.forEach(sel => sel.addEventListener('change', updateVariantSelection));
  <% } %>
</script>

<script>
  // B2 sticky buy bar (feat/cart-buying): buy box (#buy-box-sentinel)
  // viewport-er upore beriye gele bar dekhabe, na hole lukabe.
  // Scroll listener rAF-throttle kora (footer-er guard gulor motoi).
  // Bar-er button asol form-tai submit kore — alada kono add logic
  // nei, tai PR #80-er AJAX flow (drawer + toast) ekhanei chole.
  // Variant bechha na hole kichu add hoy na: buy box-e scroll kore
  // selector-gulo dekhiye deya hoy (vul variant add hobe na).
  // prefers-reduced-motion hole scroll smooth noy, instant.
  (function () {
    var bar = document.getElementById('sticky-buy-bar');
    var btn = document.getElementById('sticky-buy-btn');
    var form = document.getElementById('add-to-cart-form');
    var sentinel = document.getElementById('buy-box-sentinel');
    if (!bar || !form) return;
    var header = document.querySelector('.site-header');
    var raf = window.requestAnimationFrame || function (fn) { fn(); };
    var ticking = false;
    var reduced = false;
    try {
      reduced = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    } catch (e) { reduced = false; }
    function setBarTop() {
      // Desktop-e bar header-er NICHE boshe; header-er asol height
      // mepe neya hoy (mobile-e bar niche thake, top lage na).
      if (window.matchMedia && window.matchMedia('(min-width: 769px)').matches && header) {
        bar.style.top = header.offsetHeight + 'px';
      } else {
        bar.style.top = '';
      }
    }
    function update() {
      ticking = false;
      var anchor = sentinel || form;
      var r = anchor.getBoundingClientRect();
      bar.hidden = !(r.bottom < 0);
    }
    function onScroll() {
      if (!ticking) { ticking = true; raf(update); }
    }
    if (btn) {
      btn.addEventListener('click', function () {
        var variantInput = document.getElementById('variant_id_input');
        var hasVariants = !!document.querySelector('.variant-attr-select');
        if (hasVariants && variantInput && !variantInput.value) {
          var target = document.querySelector('.variant-selectors') || form;
          if (target.scrollIntoView) target.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
          var first = document.querySelector('.variant-attr-select');
          if (first && first.focus) first.focus({ preventScroll: true });
          return;
        }
        // Asol form submit — footer-er AJAX delegation dhore ney
        // (drawer + toast); requestSubmit na thakle main button-e
        // click (submit event cholbe, tai AJAX-o cholbe).
        if (form.requestSubmit) form.requestSubmit();
        else {
          var mainBtn = document.getElementById('add-to-cart-btn');
          if (mainBtn && mainBtn.click) mainBtn.click();
        }
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { setBarTop(); onScroll(); }, { passive: true });
    if (window.addEventListener) window.addEventListener('load', function () { setBarTop(); update(); });
    setBarTop();
    raf(function () { update(); });
    update();
  })();
</script>

<!-- Google Analytics: view_item event -->
