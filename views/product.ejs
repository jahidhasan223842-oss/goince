<% /* C3 (feat/discovery-search): "Customers also viewed" — ei
      product-ta jara dekhechhe tara ar ki dekhechhe, ashol view
      history theke (routes/shop.js). Kono co-view na thakle
      section-ta ekebarei thake na; nijer product kokhono ase na. */ %>
<% if (typeof alsoViewed !== 'undefined' && alsoViewed && alsoViewed.length > 0) { %>
  <div class="section-heading"><h2>Customers also viewed</h2></div>
  <div class="product-grid">
    <% alsoViewed.forEach(p => { %>
      <div class="product-card">
        <a href="/product/<%= p.id %>">
