          <% if (typeof secondImages !== 'undefined' && secondImages && secondImages[p.id]) { %><img class="product-card-img-alt" src="/uploads/<%= secondImages[p.id] %>" alt="" aria-hidden="true" loading="lazy" onerror="this.remove()"><% } %>
          <h3><%= p.name %></h3>
        </a>
        <div class="product-card-foot">
          <p class="price">৳<%= p.price %></p>
