<%- include('partials/header') %>

<div class="product-details">
  <div class="product-image">
    <div class="gallery-stage" id="gallery-stage" tabindex="0" role="group" aria-label="Product photos">
      <img src="/uploads/<%= product.image %>" alt="<%= product.name %>" id="main-product-image" onerror="this.src='/uploads/no-image.png'">
      <% /* D1 product video (feat/product-page): Admin > Products >
            Edit-er video field-e (product_videos table) video thakle
            gallery-te player hisebe ase — ekta slide-er motoi.
            Video na thakle gallery ager motoi thake, kichu bodlay
            na. Video file ekhane banano/upload kora hoy na — donal-ke
            ashol phone-e tola video upload korte hobe. */ %>
      <% if (typeof productVideo !== 'undefined' && productVideo) { %>
        <video id="product-video" class="gallery-video" src="/uploads/<%= productVideo %>" controls preload="metadata" playsinline hidden></video>
      <% } %>
      <% if (galleryImages && galleryImages.length > 0) { %>
        <button type="button" class="gallery-arrow gallery-prev" id="gallery-prev" aria-label="Previous photo">‹</button>
        <button type="button" class="gallery-arrow gallery-next" id="gallery-next" aria-label="Next photo">›</button>
      <% } %>
      <div class="gallery-zoom-controls">
        <button type="button" class="gallery-zoom-btn" id="gallery-zoom-out" aria-label="Zoom out">−</button>
        <button type="button" class="gallery-zoom-btn" id="gallery-zoom-in" aria-label="Zoom in">+</button>
        <button type="button" class="gallery-zoom-btn gallery-zoom-reset" id="gallery-zoom-reset" aria-label="Reset zoom">⟲</button>
      </div>
      <span class="gallery-zoom-hint"><span class="zoom-hint-hover">Hover to zoom · Click to toggle</span><span class="zoom-hint-touch">Tap to zoom</span></span>
    </div>

    <% if ((galleryImages && galleryImages.length > 0) || (typeof productVideo !== 'undefined' && productVideo)) { %>
      <div class="thumbnail-row">
        <img src="/uploads/<%= product.image %>" class="thumbnail active" data-index="0" data-full="/uploads/<%= product.image %>" onclick="swapImage(this, '/uploads/<%= product.image %>')" onerror="this.src='/uploads/no-image.png'" alt="">
        <% if (galleryImages && galleryImages.length > 0) { %>
        <% galleryImages.forEach((img, i) => { %>
          <img src="/uploads/<%= img.image %>" class="thumbnail" data-index="<%= i + 1 %>" data-full="/uploads/<%= img.image %>" onclick="swapImage(this, '/uploads/<%= img.image %>')" onerror="this.src='/uploads/no-image.png'" alt="">
        <% }) %>
        <% } %>
        <% if (typeof productVideo !== 'undefined' && productVideo) { %>
          <button type="button" class="thumbnail thumbnail-video" onclick="showProductVideo(this)" aria-label="Play product video">▶ Video</button>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="product-info">
    <h1><%= product.name %></h1>
    <% if (product.target_audience && product.target_audience !== 'all') { %>
      <p style="display:inline-block; margin:0 0 10px; padding:4px 10px; border-radius:14px; background:var(--surface); border:1px solid var(--border-strong); font-size:12px;">
        <%= product.target_audience === 'men' ? 'For Men' : product.target_audience === 'women' ? 'For Women' : product.target_audience === 'kids' ? 'For Kids' : 'Unisex' %>
      </p>
    <% } %>
    <% if (product.short_description) { %>
      <p class="short-description"><%= product.short_description %></p>
    <% } %>

    <% if (avgRating) { %>
      <p class="avg-rating">⭐ <%= avgRating %> / 5 (<%= reviewCount %> review<%= reviewCount != 1 ? 's' : '' %>)</p>
    <% } else { %>
      <p class="avg-rating avg-rating-empty">☆☆☆☆☆ No reviews yet</p>
    <% } %>

    <% /* I11 (feat/admin-ops): active flash offer — offer price +
          live countdown; expired offers never reach this template. */ %>
    <% if (typeof flashOffer !== 'undefined' && flashOffer && typeof flashPrice !== 'undefined' && flashPrice !== null) { %>
      <div class="flash-offer-box" style="background:#fff7e0; border:1px solid #f0a500; border-radius:10px; padding:12px 16px; margin:10px 0;">
        <strong>⚡ <%= flashOffer.title || 'Flash Offer' %> — now ৳<%= flashPrice %> <span class="compare-price">৳<%= product.price %></span></strong>
        <% if (flashOffer.ends_at) { %><p class="flash-countdown" data-ends="<%= new Date(flashOffer.ends_at).toISOString() %>" style="margin:4px 0 0;">Ends soon — hurry!</p><% } %>
      </div>
      <script>
        (function () {
          function tick() {
            document.querySelectorAll('.flash-countdown[data-ends]').forEach(function (el) {
              var ms = new Date(el.getAttribute('data-ends')).getTime() - Date.now();
              if (ms <= 0) { el.textContent = 'Offer ended'; return; }
              var h = Math.floor(ms / 3600000), m = Math.floor(ms % 3600000 / 60000), s = Math.floor(ms % 60000 / 1000);
              el.textContent = 'Ends in ' + h + 'h ' + String(m).padStart(2, '0') + 'm ' + String(s).padStart(2, '0') + 's';
            });
          }
          tick(); setInterval(tick, 1000);
        })();
      </script>
    <% } %>

    <div class="price-row">
      <p class="price" id="display-price">৳<%= (typeof flashPrice !== 'undefined' && flashPrice !== null) ? flashPrice : product.price %></p>
      <% if (discountPercent) { %>
        <p class="compare-price" id="display-compare-price">৳<%= product.compare_at_price %></p>
        <span class="discount-badge" id="display-discount-badge">-<%= discountPercent %>%</span>
      <% } else { %>
        <p class="compare-price" id="display-compare-price" style="display:none;"></p>
        <span class="discount-badge" id="display-discount-badge" style="display:none;"></span>
      <% } %>
    </div>

    <p class="stock" id="display-stock"><%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %></p>

    <% /* G5 sold counter (feat/product-page): ashol order count
          theke ase; 0 sold hole kichu dekhabe na. */ %>
    <% if (typeof soldLine !== 'undefined' && soldLine) { %>
      <p class="sold-line">🔥 <%= soldLine %></p>
    <% } %>
    <% /* G1 live viewers (feat/product-page): REAL count — goto 5
          minute-e kotogulo alada session ei product dekhchhe.
          0 ba 1 (shudhu apni) hole kichu dekhabe na. */ %>
    <% if (typeof viewerLine !== 'undefined' && viewerLine) { %>
      <p class="viewer-line">👀 <%= viewerLine %></p>
    <% } %>
    <% /* D8 honest low-stock bar (feat/product-page): sold /
          (sold + remaining) — ashol number diye; stock plentiful
          hole (bar-er threshold-er upore) ekebarei dekhabe na. */ %>
    <% if (typeof stockBar !== 'undefined' && stockBar) { %>
      <div class="low-stock" role="status">
        <p class="low-stock-text">⚠️ Hurry — only <strong><%= stockBar.remaining %> left</strong> (<%= stockBar.percent %>% sold)</p>
        <div class="low-stock-bar"><div class="low-stock-fill" style="width:<%= stockBar.percent %>%"></div></div>
      </div>
    <% } %>

    <% if (options && options.length > 0) { %>
      <div class="option-selectors" style="margin-bottom:15px;">
        <label style="font-weight:600; display:block; margin-bottom:6px;"><%= optionLabel %>: <span id="selected-option-name">-</span></label>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <% options.forEach((o, i) => { %>
            <button type="button" class="option-pill<%= i === 0 ? ' active' : '' %>"
                 data-option-id="<%= o.id %>"
                 data-option-name="<%= o.value_name %>"
                 data-option-image="<%= o.image ? '/uploads/' + o.image : '' %>"
                 onclick="selectOption(this)"
                 style="cursor:pointer; display:flex; align-items:center; gap:6px; padding:7px 14px; border-radius:20px; border:2px solid <%= i === 0 ? '#f0a500' : '#ddd' %>; background:#fff; font-size:13px;">
              <% if (o.color_hex) { %><span style="display:inline-block; width:16px; height:16px; border-radius:50%; background:<%= o.color_hex %>; border:1px solid #ccc;"></span><% } %>
              <%= o.value_name %>
            </button>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (variants && variants.length > 0) { %>
      <div class="variant-selectors" style="margin-bottom:15px;">
        <% variantAttributes.forEach(attr => { %>
          <div style="margin-bottom:10px;">
            <label style="font-weight:600; display:block; margin-bottom:4px;"><%= attr.name %></label>
            <select class="variant-attr-select" data-attribute-id="<%= attr.id %>" style="padding:8px 12px; border:1px solid #ccc; border-radius:4px;">
              <option value="">-- Select <%= attr.name %> --</option>
              <% attr.values.forEach(v => { %>
                <option value="<%= v.id %>"><%= v.value %></option>
              <% }) %>
            </select>
          </div>
        <% }) %>
        <p id="variant-message" style="color:#e63946; font-size:13px;"></p>
      </div>
    <% } %>

    <form action="/cart/add/<%= product.id %>" method="POST" class="add-to-cart-form" id="add-to-cart-form" <%= (variants && variants.length > 0) ? 'style="display:none;"' : '' %>><%- include('partials/csrf-field') %>
      <input type="hidden" name="variant_id" id="variant_id_input" value="">
      <input type="hidden" name="option_id" id="option_id_input" value="<%= (options && options.length > 0) ? options[0].id : '' %>">
      <label for="quantity">Quantity:</label>
      <input type="number" name="quantity" id="quantity" value="1" min="1" max="<%= product.stock %>">
      <button type="submit" class="btn-primary" id="add-to-cart-btn" <%= product.stock === 0 && !product.allow_backorder ? 'disabled' : '' %>><%= product.stock > 0 ? 'Add to Cart' : (product.allow_backorder ? 'Pre-order Now' : 'Out of Stock') %></button>
      <button type="button" class="btn-card btn-card--compare" data-compare-id="<%= product.id %>" style="margin-top:8px;">⇄ Compare</button>
      <% /* B3 Buy Now (feat/cart-buying): ekoi form, ditiyo submit
            button — name="buy_now" dekhe route item-ta cart-e jog
            kore (ager item thake) sorasori /checkout-e pathay; footer
            JS ei button-ke AJAX-e dhore na, tai sadharon POST-e
            /checkout-e jay (no-JS-eo eki). Variant na bechle form-ta
            lukano thake, tai vul variant-e Buy Now chapa jay na. */ %>
      <button type="submit" name="buy_now" value="1" class="btn-buy-now" id="buy-now-btn" <%= product.stock === 0 && !product.allow_backorder ? 'disabled' : '' %>>Buy Now</button>
    </form>
    <% /* G3 trust badges (feat/product-page): shop-er ashol
          sotto gulo — Cash on Delivery, manual bKash/Nagad/Rocket,
          24h return (defective/wrong only), ashol phone number.
          Kono gateway nei, tai "secure online payment" bole kono
          badge nei. */ %>
    <div class="trust-badges" aria-label="Why shop with Goince">
      <span class="trust-badge">💵 Cash on Delivery available</span>
      <span class="trust-badge">📱 Pay by bKash / Nagad / Rocket (manual)</span>
      <span class="trust-badge">↩️ Easy return — within 24 hours if defective or wrong item</span>
      <span class="trust-badge">📞 Phone support: <a href="tel:<%= (typeof shopPhone !== 'undefined' && shopPhone) ? String(shopPhone).replace(/[^0-9+]/g, '') : '01814697896' %>"><%= (typeof shopPhone !== 'undefined' && shopPhone) ? shopPhone : '01814697896' %></a></span>
    </div>
    <% /* B2 sticky bar-er anchor: buy box viewport-er upore beriye
          gelei bar dekhabe. Form lukano thakleo (variant bechha
          hoy ni) ei khali div-er obosthan thik thake. */ %>
    <div id="buy-box-sentinel" aria-hidden="true"></div>

    <% if (product.stock === 0 && !product.allow_backorder) { %>
    <div class="notify-me-box" style="margin-top:16px; padding:14px; border:1px solid #f0a500; border-radius:8px; background:#fff8e6;">
      <p style="margin:0 0 8px; font-weight:600;">🔔 Stock শেষ — আসলেই জানতে চান?</p>
      <% if (typeof notify !== 'undefined' && notify === 'ok') { %><p style="color:green;">ধন্যবাদ! স্টক আসলেই আপনাকে জানানো হবে।</p><% } %>
      <form action="/product/<%= product.id %>/notify-me" method="POST" style="display:flex; gap:8px; flex-wrap:wrap;"><%- include('partials/csrf-field') %>
        <input type="tel" name="phone" required pattern="^(01[3-9][0-9]{8}|\+8801[3-9][0-9]{8})$" placeholder="আপনার মোবাইল নম্বর (01XXXXXXXXX)" style="flex:1; min-width:180px; padding:10px; border:1px solid #ccc; border-radius:4px;">
        <input type="email" name="email" placeholder="Email (optional — stock asle email-e janano hobe)" style="flex:1; min-width:180px; padding:10px; border:1px solid #ccc; border-radius:4px;">
        <button type="submit" class="btn-primary">Notify Me</button>
      </form>
    </div>
    <% } %>
    <% if (product.stock === 0 && product.allow_backorder) { %>
    <p style="color:#e67e22; font-weight:600; margin-top:10px;">📦 Pre-order — স্টক নেই, তবে অর্ডার করতে পারবেন। স্টক আসলেই ডেলিভারি দেওয়া হবে।</p>
    <% } %>

    <% if (userName) { %>
      <form action="/wishlist/add/<%= product.id %>" method="POST" style="margin-top:10px;"><%- include('partials/csrf-field') %>
        <button type="submit" class="btn-wishlist">♡ Add to Wishlist</button>
      </form>
    <% } %>

    <div class="delivery-info-box">
      <% /* B4 per-product free delivery: Free Delivery hole charge-er
            line-er bodole sobuj "Free Delivery" line; na hole ager
            motoi zone charge. Sobuj-ta site-er --success. */ %>
      <% if (product.free_shipping) { %>
      <p class="delivery-free-line">🚚 <strong>Free Delivery</strong> — ei product-er kono delivery charge nei</p>
      <% } else { %>
      <p>🚚 Delivery Charge: <strong>৳<%= deliveryCharge %></strong> (Inside Dhaka) / <strong>৳<%= deliveryChargeOutside %></strong> (Outside Dhaka)</p>
      <% } %>
      <p>📦 Estimated Delivery: <%= product.delivery_time ? product.delivery_time : 'Inside Dhaka 1–2 din, Outside Dhaka 3–5 din' %></p>
      <% /* D7 delivery-date estimate (feat/product-page): "Order in
            the next X hours, get it by <date>" — ashol zone window
            (Dhaka 1–2 din / baire 3–5 din) + 5pm cut-off theke hisab
            (lib/product-page.js). Zone bechhle session-e mone thake,
            default Dhaka. */ %>
      <% if (typeof deliveryEstimate !== 'undefined' && deliveryEstimate) { %>
        <p class="delivery-estimate">⏰ Order in the next <strong><%= deliveryEstimate.hoursLeft %> hour<%= deliveryEstimate.hoursLeft != 1 ? 's' : '' %></strong> — get it by <strong><%= deliveryEstimate.getByLabel %></strong> (<%= deliveryEstimate.zoneLabel %>)</p>
      <% } %>
      <form class="delivery-zone-form" method="GET" action="/product/<%= product.id %>">
        <label for="delivery-zone">Delivery area:</label>
        <select name="zone" id="delivery-zone" onchange="this.form.submit()">
          <option value="inside_dhaka" <%= (typeof deliveryZone === 'undefined' || deliveryZone === 'inside_dhaka') ? 'selected' : '' %>>Inside Dhaka (1–2 days)</option>
          <option value="outside_dhaka" <%= (typeof deliveryZone !== 'undefined' && deliveryZone === 'outside_dhaka') ? 'selected' : '' %>>Outside Dhaka (3–5 days)</option>
        </select>
      </form>
    </div>

    <div class="share-box">
      <span>Share:</span>
      <a href="https://wa.me/?text=<%= encodeURIComponent(product.name + ' — ৳' + product.price + ' | Goince') %>" target="_blank" rel="noopener">WhatsApp</a>
      <button type="button" onclick="copyProductLink()">🔗 Copy Link</button>
    </div>
    <a href="/" class="back-link">&larr; Back to shop</a>
  </div>
</div>

<% /* ---------- B2 Sticky buy bar (feat/cart-buying) ----------
      Buy box scroll-er baire gele ei bar-ta ase — desktop-e sticky
      header-er niche (top; asol header height JS-e mepe bosano hoy),
      mobile-e niche (bottom). Chobi + naam + daam + Add to Cart.
      Variant na bechle bar-er button kichu add kore na — buy box-e
      scroll kore niye jay (vul variant add hobe na). Button-ta asol
      form-tai submit kore (requestSubmit), tai PR #80-er AJAX flow
      (drawer + toast + badge) ekhanei chole; alada kono add route
      nei. WhatsApp float / side-cart tab-er sathe overlap hole
      footer-er guard (PR #65/#75) oi float duto lukay — bar-er
      button GUARDED list-e ache. */ %>
<div class="sticky-buy-bar" id="sticky-buy-bar" hidden>
  <img src="/uploads/<%= product.image %>" alt="" aria-hidden="true" onerror="this.remove()">
  <span class="sticky-buy-name"><%= product.name %></span>
  <span class="sticky-buy-price" id="sticky-buy-price">৳<%= product.price %></span>
  <button type="button" class="btn-primary" id="sticky-buy-btn" <%= product.stock === 0 && !product.allow_backorder ? 'disabled' : '' %>>Add to Cart</button>
</div>

<% /* D2 "Frequently bought together" (feat/product-page): shudhu
      admin-er beche deya related product (related_products table)
      thaklei box-ta ase — na thakle khali box noy, kichui na.
      "Add all to cart" PR #80-er AJAX flow-ei chole (fetch POST
      /cart/add/:id, page reload noy, drawer khole); variant/option
      thaka product bundle-e dhoke na, tai prottekta add sorasori
      kora jay. */ %>
<% if (typeof bundleProducts !== 'undefined' && bundleProducts && bundleProducts.length > 0) { %>
  <% const bundleTotal = Number(product.price) + bundleProducts.reduce((s, b) => s + Number(b.price), 0); %>
  <div class="bundle-box" id="bundle-box">
    <h2>Frequently bought together</h2>
    <ul class="bundle-list">
      <li class="bundle-item bundle-item--main">
        <img src="/uploads/<%= product.image %>" alt="" onerror="this.remove()">
        <span class="bundle-item-name"><%= product.name %></span>
        <span class="bundle-item-price">৳<%= product.price %></span>
      </li>
      <% bundleProducts.forEach(bp => { %>
        <li class="bundle-item">
          <a href="/product/<%= bp.id %>"><img src="/uploads/<%= bp.image %>" alt="<%= bp.name %>" onerror="this.remove()"></a>
          <span class="bundle-item-name"><a href="/product/<%= bp.id %>"><%= bp.name %></a></span>
          <span class="bundle-item-price">৳<%= bp.price %></span>
        </li>
      <% }) %>
    </ul>
    <p class="bundle-total">Total for all <%= bundleProducts.length + 1 %> items: <strong>৳<%= bundleTotal %></strong></p>
    <button type="button" class="btn-primary" id="bundle-add-all" data-bundle-ids="<%= bundleProducts.map(b => b.id).join(',') %>">Add all to cart — ৳<%= bundleTotal %></button>
    <input type="hidden" id="bundle-csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  </div>
<% } %>

<% if (product.description) { %>
  <div class="long-description-section">
    <h2>Product Details</h2>
    <div class="description"><%- descriptionHtml %></div>
  </div>
<% } %>

<% if (specs && specs.length > 0) { %>
  <div class="specs-section">
    <h2>Specifications</h2>
    <div class="table-responsive">
    <table class="specs-table">
      <% specs.forEach(s => { %>
        <tr><td><%= s.key %></td><td><%= s.value %></td></tr>
      <% }) %>
    </table>
    </div>
  </div>
<% } %>

<% /* D5 size guide (feat/product-page, FIX PR #84): Size
      attribute (variant) thaka apparel product-e dekhabe, AR
      Size OPTION (product_options, option_label "Size") thaka
      product-eo dekhabe — jemon A.T.Z dress (/product/7), jar
      S/M/L/XL option-e ase, variant-e noy. Age shudhu variant
      attribute check kora hoto, tai A.T.Z-te size selector
      thakleo guide-ta ashto na. Chart-ta static — ei style-er
      standard approximate measurement (inch), chart-ei lekha
      ache ashol product-e ±0.5" bodol hote pare. Admin-editable
      kora hoy ni — donal chart bodlate chaile code-e ei
      table-ta bodlate hobe (PR body-te lekha ache). */ %>
<% if (typeof showSizeGuide !== 'undefined' && showSizeGuide) { %>
  <div class="size-guide-section">
    <h2>Size Guide</h2>
    <p class="size-guide-note">Standard size guide for this style — approximate measurements in inches. Actual product may vary slightly (±0.5"). When in doubt, pick the larger size.</p>
    <table class="size-guide-table">
      <thead><tr><th>Size</th><th>Chest</th><th>Length</th></tr></thead>
      <tbody>
        <tr><td>S</td><td>36"</td><td>34"</td></tr>
        <tr><td>M</td><td>38"</td><td>35"</td></tr>
        <tr><td>L</td><td>40"</td><td>36"</td></tr>
        <tr><td>XL</td><td>42"</td><td>37"</td></tr>
      </tbody>
    </table>
  </div>
<% } %>

<% /* D9 product FAQ (feat/product-page): static accordion — uttor
      gulo shop-er ashol niyom (return 24h, defective/wrong only;
      delivery Dhaka 1–2 din / baire 3–5 din; COD + manual
      bKash/Nagad/Rocket). Size-er proshno-ta shudhu Size thaka
      product-e ase. Admin-editable kora hoy ni — PR body-te lekha. */ %>
<div class="faq-section">
  <h2>Frequently Asked Questions</h2>
  <details class="faq-item">
    <summary>How long does delivery take?</summary>
    <p>Inside Dhaka 1–2 days, outside Dhaka 3–5 days. Order before 5pm and your order dispatches the same day.</p>
  </details>
  <details class="faq-item">
    <summary>Can I pay Cash on Delivery?</summary>
    <p>Yes — Cash on Delivery is available. You can also pay manually by bKash, Nagad or Rocket: send the money first, then enter the Transaction ID at checkout.</p>
  </details>
  <details class="faq-item">
    <summary>What is the return policy?</summary>
    <p>You can request a return within 24 hours of delivery if the product is defective or damaged, or you received the wrong product. Change-of-mind returns are not accepted once delivered. See the <a href="/return-policy">Return &amp; Refund Policy</a> for details.</p>
  </details>
  <% /* D5 size FAQ (FIX PR #84): Size attribute BA Size option —
        showSizeGuide sotti holei proshno-ta ase. */ %>
  <% if (typeof showSizeGuide !== 'undefined' && showSizeGuide) { %>
  <details class="faq-item">
    <summary>How do I choose the right size?</summary>
    <p>Use the Size Guide table above — match your chest measurement to the chart. Between two sizes, pick the larger one for a comfortable fit.</p>
  </details>
  <% } %>
  <details class="faq-item">
    <summary>How do I take care of this product?</summary>
    <p>Follow the care instructions on the product packaging or label. For apparel, wash gently and dry in shade; for electronics and home items, keep dry and handle with care.</p>
  </details>
  <details class="faq-item">
    <summary>Is the stock shown on this page live?</summary>
    <p>Yes — the stock count on this page comes from the shop's live stock. If it says "Out of stock", you can use Notify Me and we will let you know when it is back.</p>
  </details>
  <details class="faq-item">
    <summary>How can I track my order?</summary>
    <p>Use the Track Order page with your Order ID and phone number, or call us at <%= (typeof shopPhone !== 'undefined' && shopPhone) ? shopPhone : '01814697896' %>.</p>
  </details>
</div>

<div class="reviews-section" data-csrf-token="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <h2>Reviews</h2>
  <% if (typeof reviewPending !== 'undefined' && reviewPending) { %>
    <p style="background:#fff8e1; border:1px solid #f0a500; padding:10px; border-radius:6px;">✅ Thanks! Your review is awaiting approval and will show after the admin approves it.</p>
  <% } %>

  <% if (reviews.length === 0) { %>
    <p>Be the first to review this product!</p>
  <% } else { %>
    <% reviews.forEach(r => { %>
      <div class="review-item">
        <p class="review-stars"><%= '⭐'.repeat(r.rating) %></p>
        <p class="review-author"><strong><%= r.user_name %></strong>
          <% /* D3 verified-buyer badge: ei customer sotti ei
                product-ta kinechhe kina orders diye jachai kora —
                na kinle badge othe na. */ %>
          <% if (typeof verifiedBuyerIds !== 'undefined' && verifiedBuyerIds && verifiedBuyerIds.indexOf(r.user_id) !== -1) { %><span class="verified-badge">✓ Verified Buyer</span><% } %>
          — <%= new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
        <% if (r.comment) { %><p class="review-comment"><%= r.comment %></p><% } %>
        <% /* D3 review photo: customer-er upload kora chobi (WebP). */ %>
        <% if (typeof reviewPhotos !== 'undefined' && reviewPhotos && reviewPhotos[r.id]) { %>
          <div class="review-photos">
            <% reviewPhotos[r.id].forEach(function (ph) { %>
              <img class="review-photo" src="/uploads/<%= ph %>" alt="Customer photo" loading="lazy">
            <% }) %>
          </div>
        <% } %>
        <% /* D3 helpful vote: ekbar chaple vote, abar chaple tule
              neoa — ekjon-ekbar (route + DB UNIQUE key). */ %>
        <button type="button" class="helpful-btn<%= (typeof votedReviewIds !== 'undefined' && votedReviewIds && votedReviewIds.indexOf(r.id) !== -1) ? ' is-voted' : '' %>" data-review-id="<%= r.id %>">👍 Helpful (<span class="helpful-count"><%= (typeof helpfulCounts !== 'undefined' && helpfulCounts && helpfulCounts[r.id]) || 0 %></span>)</button>
      </div>
    <% }) %>
  <% } %>

  <% if (userName) { %>
    <h3>Write a Review</h3>
    <% /* D3 review photo: multipart form bole action URL-e ?_csrf=
          thaktei hobe (lib/csrf.js) — na hole token pora jay na. */ %>
    <form action="/product/<%= product.id %>/review?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" class="review-form" enctype="multipart/form-data"><%- include('partials/csrf-field') %>
      <label>Rating</label>
      <select name="rating" required>
        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
        <option value="4">⭐⭐⭐⭐ (4)</option>
        <option value="3">⭐⭐⭐ (3)</option>
        <option value="2">⭐⭐ (2)</option>
        <option value="1">⭐ (1)</option>
      </select>
      <label>Comment (optional)</label>
      <textarea name="comment" rows="3"></textarea>
      <label>Add a photo (optional)</label>
      <input type="file" name="review_photo" accept="image/*">
      <button type="submit" class="btn-primary">Submit Review</button>
    </form>
  <% } else { %>
    <p><a href="/login">Login</a> to write a review.</p>
  <% } %>
</div>

<% /* D4 Product Q&A (feat/product-page): shudhu admin-er uttor
      deoa proshno-guloi dekhabe; uttor na deoa proshno pending
      thake, shop-e othe na. Proshno korte login lage (review-er
      motoi). */ %>
<div class="qa-section">
  <h2>Questions &amp; Answers</h2>
  <% if (typeof questionPending !== 'undefined' && questionPending) { %>
    <p style="background:#fff8e1; border:1px solid #f0a500; padding:10px; border-radius:6px;">✅ Thanks! Your question is awaiting an answer from the shop and will show here once answered.</p>
  <% } %>
