<%- include('partials/header') %>

<div class="product-details">
  <div class="product-image">
    <div class="gallery-stage" id="gallery-stage" tabindex="0" role="group" aria-label="Product photos">
      <img src="/uploads/<%= product.image %>" alt="<%= product.name %>" id="main-product-image" onerror="this.src='/uploads/no-image.png'">
      <% if (galleryImages && galleryImages.length > 0) { %>
        <button type="button" class="gallery-arrow gallery-prev" id="gallery-prev" aria-label="Previous photo">‹</button>
        <button type="button" class="gallery-arrow gallery-next" id="gallery-next" aria-label="Next photo">›</button>
      <% } %>
      <div class="gallery-zoom-controls">
        <button type="button" class="gallery-zoom-btn" id="gallery-zoom-out" aria-label="Zoom out">−</button>
        <button type="button" class="gallery-zoom-btn" id="gallery-zoom-in" aria-label="Zoom in">+</button>
        <button type="button" class="gallery-zoom-btn gallery-zoom-reset" id="gallery-zoom-reset" aria-label="Reset zoom">⟲</button>
      </div>
      <span class="gallery-zoom-hint"><span class="zoom-hint-hover">Hover to zoom · Click to toggle</span><span class="zoom-hint-touch">Tap to zoom</span></span>
    </div>

    <% if (galleryImages && galleryImages.length > 0) { %>
      <div class="thumbnail-row">
        <img src="/uploads/<%= product.image %>" class="thumbnail active" data-index="0" data-full="/uploads/<%= product.image %>" onclick="swapImage(this, '/uploads/<%= product.image %>')" onerror="this.src='/uploads/no-image.png'" alt="">
        <% galleryImages.forEach((img, i) => { %>
          <img src="/uploads/<%= img.image %>" class="thumbnail" data-index="<%= i + 1 %>" data-full="/uploads/<%= img.image %>" onclick="swapImage(this, '/uploads/<%= img.image %>')" onerror="this.src='/uploads/no-image.png'" alt="">
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="product-info">
    <h1><%= product.name %></h1>
    <% if (product.target_audience && product.target_audience !== 'all') { %>
      <p style="display:inline-block; margin:0 0 10px; padding:4px 10px; border-radius:14px; background:var(--surface); border:1px solid var(--border-strong); font-size:12px;">
        <%= product.target_audience === 'men' ? 'For Men' : product.target_audience === 'women' ? 'For Women' : product.target_audience === 'kids' ? 'For Kids' : 'Unisex' %>
      </p>
    <% } %>
    <% if (product.short_description) { %>
      <p class="short-description"><%= product.short_description %></p>
    <% } %>

    <% if (avgRating) { %>
      <p class="avg-rating">⭐ <%= avgRating %> / 5 (<%= reviewCount %> review<%= reviewCount != 1 ? 's' : '' %>)</p>
    <% } else { %>
      <p class="avg-rating avg-rating-empty">☆☆☆☆☆ No reviews yet</p>
    <% } %>

    <div class="price-row">
      <p class="price" id="display-price">৳<%= product.price %></p>
      <% if (discountPercent) { %>
        <p class="compare-price" id="display-compare-price">৳<%= product.compare_at_price %></p>
        <span class="discount-badge" id="display-discount-badge">-<%= discountPercent %>%</span>
      <% } else { %>
        <p class="compare-price" id="display-compare-price" style="display:none;"></p>
        <span class="discount-badge" id="display-discount-badge" style="display:none;"></span>
      <% } %>
    </div>

    <p class="stock" id="display-stock"><%= product.stock > 0 ? product.stock + ' in stock' : 'Out of stock' %></p>

    <% if (options && options.length > 0) { %>
      <div class="option-selectors" style="margin-bottom:15px;">
        <label style="font-weight:600; display:block; margin-bottom:6px;"><%= optionLabel %>: <span id="selected-option-name">-</span></label>
        <div style="display:flex; gap:8px; flex-wrap:wrap;">
          <% options.forEach((o, i) => { %>
            <button type="button" class="option-pill<%= i === 0 ? ' active' : '' %>"
                 data-option-id="<%= o.id %>"
                 data-option-name="<%= o.value_name %>"
                 data-option-image="<%= o.image ? '/uploads/' + o.image : '' %>"
                 onclick="selectOption(this)"
                 style="cursor:pointer; display:flex; align-items:center; gap:6px; padding:7px 14px; border-radius:20px; border:2px solid <%= i === 0 ? '#f0a500' : '#ddd' %>; background:#fff; font-size:13px;">
              <% if (o.color_hex) { %><span style="display:inline-block; width:16px; height:16px; border-radius:50%; background:<%= o.color_hex %>; border:1px solid #ccc;"></span><% } %>
              <%= o.value_name %>
            </button>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (variants && variants.length > 0) { %>
      <div class="variant-selectors" style="margin-bottom:15px;">
        <% variantAttributes.forEach(attr => { %>
          <div style="margin-bottom:10px;">
            <label style="font-weight:600; display:block; margin-bottom:4px;"><%= attr.name %></label>
            <select class="variant-attr-select" data-attribute-id="<%= attr.id %>" style="padding:8px 12px; border:1px solid #ccc; border-radius:4px;">
              <option value="">-- Select <%= attr.name %> --</option>
              <% attr.values.forEach(v => { %>
                <option value="<%= v.id %>"><%= v.value %></option>
              <% }) %>
            </select>
          </div>
        <% }) %>
        <p id="variant-message" style="color:#e63946; font-size:13px;"></p>
      </div>
    <% } %>

    <form action="/cart/add/<%= product.id %>" method="POST" class="add-to-cart-form" id="add-to-cart-form" <%= (variants && variants.length > 0) ? 'style="display:none;"' : '' %>><%- include('partials/csrf-field') %>
      <input type="hidden" name="variant_id" id="variant_id_input" value="">
      <input type="hidden" name="option_id" id="option_id_input" value="<%= (options && options.length > 0) ? options[0].id : '' %>">
      <label for="quantity">Quantity:</label>
      <input type="number" name="quantity" id="quantity" value="1" min="1" max="<%= product.stock %>">
      <button type="submit" class="btn-primary" id="add-to-cart-btn" <%= product.stock === 0 && !product.allow_backorder ? 'disabled' : '' %>><%= product.stock > 0 ? 'Add to Cart' : (product.allow_backorder ? 'Pre-order Now' : 'Out of Stock') %></button>
    </form>

    <% if (product.stock === 0 && !product.allow_backorder) { %>
    <div class="notify-me-box" style="margin-top:16px; padding:14px; border:1px solid #f0a500; border-radius:8px; background:#fff8e6;">
      <p style="margin:0 0 8px; font-weight:600;">🔔 Stock শেষ — আসলেই জানতে চান?</p>
      <% if (typeof notify !== 'undefined' && notify === 'ok') { %><p style="color:green;">ধন্যবাদ! স্টক আসলেই আপনাকে জানানো হবে।</p><% } %>
      <form action="/product/<%= product.id %>/notify-me" method="POST" style="display:flex; gap:8px;"><%- include('partials/csrf-field') %>
        <input type="tel" name="phone" required pattern="^(01[3-9][0-9]{8}|\+8801[3-9][0-9]{8})$" placeholder="আপনার মোবাইল নম্বর (01XXXXXXXXX)" style="flex:1; padding:10px; border:1px solid #ccc; border-radius:4px;">
        <button type="submit" class="btn-primary">Notify Me</button>
      </form>
    </div>
    <% } %>
    <% if (product.stock === 0 && product.allow_backorder) { %>
    <p style="color:#e67e22; font-weight:600; margin-top:10px;">📦 Pre-order — স্টক নেই, তবে অর্ডার করতে পারবেন। স্টক আসলেই ডেলিভারি দেওয়া হবে।</p>
    <% } %>

    <% if (userName) { %>
      <form action="/wishlist/add/<%= product.id %>" method="POST" style="margin-top:10px;"><%- include('partials/csrf-field') %>
        <button type="submit" class="btn-wishlist">♡ Add to Wishlist</button>
      </form>
    <% } %>

    <div class="delivery-info-box">
      <p>🚚 Delivery Charge: <strong>৳<%= deliveryCharge %></strong> (Inside Dhaka) / <strong>৳<%= deliveryChargeOutside %></strong> (Outside Dhaka)</p>
      <p>📦 Estimated Delivery: <%= product.delivery_time ? product.delivery_time : 'Inside Dhaka 1–2 din, Outside Dhaka 3–5 din' %></p>
    </div>

    <div class="share-box">
      <span>Share:</span>
      <a href="https://wa.me/?text=<%= encodeURIComponent(product.name + ' — ৳' + product.price + ' | Goince') %>" target="_blank" rel="noopener">WhatsApp</a>
      <button type="button" onclick="copyProductLink()">🔗 Copy Link</button>
    </div>
    <a href="/" class="back-link">&larr; Back to shop</a>
  </div>
</div>

<% if (product.description) { %>
  <div class="long-description-section">
    <h2>Product Details</h2>
    <div class="description"><%- descriptionHtml %></div>
  </div>
<% } %>

<% if (specs && specs.length > 0) { %>
  <div class="specs-section">
    <h2>Specifications</h2>
    <div class="table-responsive">
    <table class="specs-table">
      <% specs.forEach(s => { %>
        <tr><td><%= s.key %></td><td><%= s.value %></td></tr>
      <% }) %>
    </table>
    </div>
  </div>
<% } %>

<div class="reviews-section">
  <h2>Reviews</h2>
  <% if (typeof reviewPending !== 'undefined' && reviewPending) { %>
    <p style="background:#fff8e1; border:1px solid #f0a500; padding:10px; border-radius:6px;">✅ Thanks! Your review is awaiting approval and will show after the admin approves it.</p>
  <% } %>

  <% if (reviews.length === 0) { %>
    <p>Be the first to review this product!</p>
  <% } else { %>
    <% reviews.forEach(r => { %>
      <div class="review-item">
        <p class="review-stars"><%= '⭐'.repeat(r.rating) %></p>
        <p class="review-author"><strong><%= r.user_name %></strong> — <%= new Date(r.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
        <% if (r.comment) { %><p class="review-comment"><%= r.comment %></p><% } %>
      </div>
    <% }) %>
  <% } %>

  <% if (userName) { %>
    <h3>Write a Review</h3>
    <form action="/product/<%= product.id %>/review" method="POST" class="review-form"><%- include('partials/csrf-field') %>
      <label>Rating</label>
      <select name="rating" required>
        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
        <option value="4">⭐⭐⭐⭐ (4)</option>
        <option value="3">⭐⭐⭐ (3)</option>
        <option value="2">⭐⭐ (2)</option>
        <option value="1">⭐ (1)</option>
      </select>
      <label>Comment (optional)</label>
      <textarea name="comment" rows="3"></textarea>
      <button type="submit" class="btn-primary">Submit Review</button>
    </form>
  <% } else { %>
    <p><a href="/login">Login</a> to write a review.</p>
  <% } %>
</div>

<% if (related && related.length > 0) { %>
  <div class="section-heading"><h2>Related Products</h2></div>
  <div class="product-grid">
    <% related.forEach(p => { %>
      <div class="product-card">
        <a href="/product/<%= p.id %>">
          <img src="/uploads/<%= p.image %>" alt="<%= p.name %>" onerror="this.src='/uploads/no-image.png'">
          <% /* A5 hover preview (homepage-er motoi): 2nd gallery
                chobi thaklei hover-e swap, na thakle ektai chobi. */ %>
          <% if (typeof secondImages !== 'undefined' && secondImages && secondImages[p.id]) { %><img class="product-card-img-alt" src="/uploads/<%= secondImages[p.id] %>" alt="" aria-hidden="true" loading="lazy" onerror="this.remove()"><% } %>
          <h3><%= p.name %></h3>
        </a>
        <div class="product-card-foot">
          <p class="price">৳<%= p.price %></p>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<script>
  function copyProductLink() {
    navigator.clipboard.writeText(location.href).then(function () { alert('Link copied!'); });
  }
  // Recently viewed-e save kora (homepage-e dekhabe). stock + hasOptions-o
  // save kora hoy — homepage-e Recently Viewed card-er button (Add to
  // Cart na Choose Option) ei duto diye thik hoy (fix/product-hover-gallery).
  try {
    var recent = JSON.parse(localStorage.getItem('goince-recent') || '[]');
    recent = recent.filter(function (it) { return it.id !== <%= product.id %>; });
    recent.unshift({ id: <%= product.id %>, name: <%- JSON.stringify(product.name) %>, price: <%= product.price %>, image: <%- JSON.stringify(product.image || 'no-image.png') %>, stock: <%= product.stock %>, hasOptions: <%= ((variants && variants.length > 0) || (options && options.length > 0)) ? 'true' : 'false' %> });
    localStorage.setItem('goince-recent', JSON.stringify(recent.slice(0, 4)));
  } catch (e) {}
  function swapImage(el, src) {
    // Gallery module thakle shetai chobi bodlay (index + zoom reset
    // soho); na thakle purono upay (direct src bodol + active class).
    if (window.GoinceGallery) { window.GoinceGallery.showBySrc(src, el); return; }
    document.getElementById('main-product-image').src = src;
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
  }

  function selectOption(el) {
    document.querySelectorAll('.option-pill').forEach(s => s.style.borderColor = '#ddd');
    el.style.borderColor = '#f0a500';
    document.getElementById('option_id_input').value = el.dataset.optionId;
    document.getElementById('selected-option-name').textContent = el.dataset.optionName;
    if (el.dataset.optionImage) {
      document.getElementById('main-product-image').src = el.dataset.optionImage;
      document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    }
  }

  <% if (options && options.length > 0) { %>
  // Page load hote-i prothom option-ta selected dekhano
  document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('selected-option-name').textContent = <%- JSON.stringify(options[0].value_name) %>;
  });
  <% } %>

  <% if (variants && variants.length > 0) { %>
  // Product-er shob variant, prottekta-r attribute combination shoho
  const variantData = <%- JSON.stringify(variants.map(v => ({
    id: v.id,
    price: v.price,
    compare_at_price: v.compare_at_price,
    image: v.image,
    stock: v.stock,
    attrs: v.attrs.reduce((acc, a) => { acc[a.attribute_id] = a.value_id; return acc; }, {})
  }))) %>;
  const allowBackorder = <%= product.allow_backorder ? 'true' : 'false' %>;

  const selects = document.querySelectorAll('.variant-attr-select');
  const form = document.getElementById('add-to-cart-form');
  const msg = document.getElementById('variant-message');
  const priceEl = document.getElementById('display-price');
  const stockEl = document.getElementById('display-stock');
  const variantIdInput = document.getElementById('variant_id_input');
  const qtyInput = document.getElementById('quantity');
  const addBtn = document.getElementById('add-to-cart-btn');

  function updateVariantSelection() {
    const selection = {};
    let allSelected = true;
    selects.forEach(sel => {
      if (sel.value) {
        selection[sel.dataset.attributeId] = sel.value;
      } else {
        allSelected = false;
      }
    });

    if (!allSelected) {
      form.style.display = 'none';
      msg.textContent = '';
      return;
    }

    const match = variantData.find(v => {
      return Object.keys(selection).every(attrId => String(v.attrs[attrId]) === String(selection[attrId]));
    });

    if (!match) {
      form.style.display = 'none';
      msg.textContent = 'This combination is currently unavailable.';
      return;
    }

    msg.textContent = '';
    variantIdInput.value = match.id;
    priceEl.textContent = '৳' + Number(match.price).toFixed(2);
    // Variant-er nijer chobi thakle main chobi bodle jabe (lal/nil alada chobi)
    if (match.image) {
      const mainImg = document.getElementById('main-product-image');
      if (mainImg) mainImg.src = '/uploads/' + match.image;
    }
    // Variant-er chhar thakle purono dam kata dam-e dekhabe
    const compareEl = document.getElementById('display-compare-price');
    const badgeEl = document.getElementById('display-discount-badge');
    if (match.compare_at_price && Number(match.compare_at_price) > Number(match.price)) {
      compareEl.textContent = '৳' + Number(match.compare_at_price).toFixed(2);
      compareEl.style.display = '';
      const pct = Math.round((1 - Number(match.price) / Number(match.compare_at_price)) * 100);
      badgeEl.textContent = '-' + pct + '%';
      badgeEl.style.display = '';
    } else {
      compareEl.style.display = 'none';
      badgeEl.style.display = 'none';
    }
    if (match.stock > 0) {
      stockEl.textContent = match.stock + ' in stock';
      qtyInput.max = match.stock;
      qtyInput.value = 1;
      addBtn.disabled = false;
      addBtn.textContent = 'Add to Cart';
      form.style.display = '';
    } else if (allowBackorder) {
      stockEl.textContent = 'Pre-order — stock asle delivery hobe';
      qtyInput.removeAttribute('max');
      qtyInput.value = 1;
      addBtn.disabled = false;
      addBtn.textContent = 'Pre-order Now';
      form.style.display = '';
    } else {
      stockEl.textContent = 'Out of stock — ei combination-ti ekhon nei';
      addBtn.disabled = true;
      addBtn.textContent = 'Out of Stock';
      form.style.display = '';
    }
  }

  selects.forEach(sel => sel.addEventListener('change', updateVariantSelection));
  <% } %>
</script>

<!-- Google Analytics: view_item event -->
<script>
  gtag('event', 'view_item', {
    currency: 'BDT',
    value: <%= product.price %>,
    items: [{
      item_id: '<%= product.id %>',
      item_name: <%- JSON.stringify(product.name) %>,
      price: <%= product.price %>,
      quantity: 1
    }]
  });
  fbq('track', 'ViewContent', {
    content_ids: ['<%= product.id %>'],
    content_type: 'product',
    value: <%= product.price %>,
    currency: 'BDT'
  });
</script>

<!-- Google Analytics: add_to_cart event (form submit howar age fire hoy) -->
<script>
  (function () {
    const cartForm = document.getElementById('add-to-cart-form');
    if (cartForm) {
      cartForm.addEventListener('submit', function () {
        const qtyInput = document.getElementById('quantity');
        const qty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;
        gtag('event', 'add_to_cart', {
          currency: 'BDT',
          value: <%= product.price %> * qty,
          items: [{
            item_id: '<%= product.id %>',
            item_name: <%- JSON.stringify(product.name) %>,
            price: <%= product.price %>,
            quantity: qty
          }]
        });
        fbq('track', 'AddToCart', {
          content_ids: ['<%= product.id %>'],
          content_type: 'product',
          value: <%= product.price %> * qty,
          currency: 'BDT'
        });
      });
    }
  })();
</script>

<%- include('partials/footer') %>
