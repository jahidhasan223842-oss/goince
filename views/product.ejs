      <div class="qa-item">
        <p class="qa-question"><strong>Q:</strong> <%= q.question %> <span class="qa-asker">— <%= q.asker_name %></span></p>
        <p class="qa-answer"><strong>A:</strong> <%= q.answer %></p>
