<%- include('partials/header') %>

<div class="order-success">
  <%- include('partials/checkout-steps', { step: 3 }) %>
  <h1>✅ Order Placed Successfully!</h1>
  <p>Thank you for shopping with <%= siteName %>.</p>
  <p>Your Order ID: <strong>#<%= orderId %></strong></p>
  <p>Order-er status jante <a href="/track-order">Track Order</a> page-e Order ID ar phone number dao.</p>
  <a href="/track-order" class="btn-primary">Track Order</a>
  <a href="/" class="btn-primary">Continue Shopping</a>
</div>

<!-- Google Analytics: purchase event -->
<script>
  gtag('event', 'purchase', {
    transaction_id: '<%= orderId %>',
    currency: 'BDT',
    value: <%= total %>,
    items: [
      <% cart.forEach(item => { %>
      {
        item_id: '<%= item.id %>',
        item_name: <%- JSON.stringify(item.name) %>,
        price: <%= item.price %>,
        quantity: <%= item.quantity %>
      },
      <% }) %>
    ]
  });
  fbq('track', 'Purchase', {
    content_ids: [<% cart.forEach((item, i) => { %>'<%= item.id %>'<% if (i < cart.length - 1) { %>, <% } %><% }) %>],
    content_type: 'product',
    value: <%= total %>,
    currency: 'BDT'
  });
</script>

<%- include('partials/footer') %>
