<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Reset Password - <%= siteName %></title>
  <script>
    (function () {
      /* One-time theme reset (fix/whmcs-light-theme) — same as the admin
         header: a stored 'dark' is reset to 'light' once, then the
         toggle choice is respected. */
      var MIGRATION_KEY = 'goince-theme-whmcs-v1';
      var stored = null;
      try {
        if (!localStorage.getItem(MIGRATION_KEY)) {
          localStorage.setItem('goince-theme', 'light');
          localStorage.setItem(MIGRATION_KEY, '1');
        }
        stored = localStorage.getItem('goince-theme');
      } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || 'light');
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/style.css') : '/css/style.css' %>">
</head>
<body class="admin-login-body">
  <div class="admin-login-box">
    <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="<%= siteName %>" class="admin-login-logo">
    <h2><%= siteName %> Admin</h2>
    <% if (error) { %><p class="error-msg"><%= error %></p><% } %>

    <% if (token) { %>
      <form action="/admin/reset-password/<%= token %>" method="POST"><%- include('../partials/csrf-field') %>
        <label>New Password</label>
        <div class="password-wrapper">
          <input type="password" name="password" id="admin-reset-1" minlength="6" required>
          <button type="button" class="password-toggle-btn" onclick="var i=document.getElementById('admin-reset-1'); var h=i.type==='password'; i.type=h?'text':'password'; this.textContent=h?'Hide':'Show';">Show</button>
        </div>
        <label>Confirm New Password</label>
        <div class="password-wrapper">
          <input type="password" name="confirm_password" id="admin-reset-2" minlength="6" required>
          <button type="button" class="password-toggle-btn" onclick="var i=document.getElementById('admin-reset-2'); var h=i.type==='password'; i.type=h?'text':'password'; this.textContent=h?'Hide':'Show';">Show</button>
        </div>
        <button type="submit" class="btn-primary">Reset Password</button>
      </form>
    <% } else { %>
      <p class="switch-link"><a href="/admin/forgot-password">Try requesting a new link</a></p>
    <% } %>
  </div>
</body>
</html>
