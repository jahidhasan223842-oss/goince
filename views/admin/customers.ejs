<%- include('../partials/admin-header') %>

<div class="admin-page-header">
  <h1>Customers</h1>
  <a href="/admin/customers/add" class="btn-primary">+ Add New Customer</a>
</div>

<% if (typeof winbackMsg !== 'undefined' && winbackMsg) { %><p class="success-msg" style="text-align:left;"><%= winbackMsg %></p><% } %>

<form method="GET" action="/admin/customers" class="admin-search-form">
  <input type="text" name="q" value="<%= q || '' %>" placeholder="Search by name, email or phone...">
  <button type="submit" class="btn-primary">Search</button>
  <% if (q) { %> <a href="/admin/customers">Clear</a> <% } %>
</form>

<div style="margin:0 0 16px;">
  <form action="/admin/winback/run<%- typeof csrfToken !== 'undefined' && csrfToken ? '?_csrf=' + csrfToken : '' %>" method="POST" style="display:inline"><%- include('../partials/csrf-field') %>
    <button type="submit" class="btn-sm" title="Issue a win-back coupon + email to customers who have not ordered in X days (Settings > Retention)">💌 Run win-back check</button>
  </form>
  <span class="field-hint">Issues a real coupon (WINBACK-…) to customers with no order in X days — at most once per customer per period.</span>
</div>

<% if (customers.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">👥</span>
    <strong>No customers found</strong>
    <p>Try clearing the search, or add a new customer.</p>
    <a href="/admin/customers/add" class="btn-primary">+ Add New Customer</a>
  </div>
<% } else { %>
  <div class="table-responsive">
  <table class="admin-table">
    <thead>
      <tr><th>Name</th><th>Email</th><th>Phone</th><th>Orders</th><th>Total Spent</th><th>Status</th><th>Joined</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% customers.forEach(c => { %>
        <tr>
          <td><a href="/admin/customers/<%= c.id %>"><%= c.name %></a></td>
          <td><%= c.email %></td>
          <td><%= c.phone || '-' %></td>
          <td><a href="/admin/customers/<%= c.id %>"><%= c.order_count %></a></td>
          <td>৳<%= c.total_spent %></td>
          <td>
            <% if (c.is_blocked) { %>
              <span class="status-badge status-cancelled">Blocked</span>
            <% } else { %>
              <span class="status-badge status-delivered">Active</span>
            <% } %>
          </td>
          <td><%= new Date(c.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
          <td>
            <div class="admin-actions">
              <a href="/admin/customers/<%= c.id %>" class="btn-sm btn-sm--primary">View</a>
              <a href="/admin/customers/edit/<%= c.id %>" class="btn-sm">Edit</a>
              <form action="/admin/customers/delete/<%= c.id %>" method="POST" style="display:inline" onsubmit="return confirm('Sure to delete this customer? Their orders will stay but unlinked.');"><%- include('../partials/csrf-field') %>
                <button type="submit" class="btn-sm btn-sm--danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
