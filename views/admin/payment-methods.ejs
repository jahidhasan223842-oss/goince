<%- include('../partials/admin-header') %>

<h1>Payment Methods</h1>
<p class="field-hint" style="margin-bottom:16px;">
  Customers will see these methods at checkout (Cash on Delivery always stays and does not need to be added separately).
  For each method, set the <strong>Send Money / Cash Out / Payment</strong> type — the way customers should send the money. That is what customers will see at checkout.
  To set up an online gateway (SSLCommerz/ShurjoPay/bKash PGW), go to the <a href="/admin/settings">Payment Gateway section on the Settings page</a>.
</p>

<form action="/admin/payment-methods/add" method="POST" class="admin-form">
  <label>Method Name</label>
  <input type="text" name="method_name" placeholder="e.g. bKash, Nagad, Upay" required>

  <label>Number</label>
  <input type="text" name="number" placeholder="01XXXXXXXXX">

  <label>Payment Type — the way the customer will send the money</label>
  <select name="payment_type">
    <option value="send_money">Send Money</option>
    <option value="cash_out">Cash Out</option>
    <option value="payment">Payment</option>
    <option value="agent">Agent Banking</option>
    <option value="bank">Bank Transfer</option>
  </select>

  <label>Instructions (optional — shown at checkout)</label>
  <input type="text" name="instructions" placeholder="e.g. Send the TrxID after sending the money">

  <button type="submit" class="btn-primary">Add Payment Method</button>
</form>

<h2 style="margin-top:30px;">All Payment Methods</h2>
<div class="table-responsive">
<table class="admin-table">
  <thead>
    <tr><th>Method</th><th>Number</th><th>Type</th><th>Status</th><th>Actions</th></tr>
  </thead>
  <tbody>
    <% methods.forEach(m => { %>
      <tr>
        <td>
          <form id="edit-form-<%= m.id %>" action="/admin/payment-methods/edit/<%= m.id %>" method="POST"></form>
          <input type="text" name="method_name" value="<%= m.method_name %>" form="edit-form-<%= m.id %>" style="width:120px; padding:6px; border:1px solid #ccc; border-radius:4px;">
        </td>
        <td><input type="text" name="number" value="<%= m.number || '' %>" form="edit-form-<%= m.id %>" placeholder="01XXXXXXXXX" style="width:140px; padding:6px; border:1px solid #ccc; border-radius:4px;"></td>
        <td>
          <select name="payment_type" form="edit-form-<%= m.id %>" style="padding:6px; border:1px solid #ccc; border-radius:4px;">
            <% ['send_money','cash_out','payment','agent','bank'].forEach(t => { %><option value="<%= t %>" <%= (m.payment_type || 'send_money') === t ? 'selected' : '' %>><%= {send_money:'Send Money',cash_out:'Cash Out',payment:'Payment',agent:'Agent Banking',bank:'Bank Transfer'}[t] %></option><% }) %>
          </select>
          <input type="text" name="instructions" value="<%= m.instructions || '' %>" form="edit-form-<%= m.id %>" placeholder="Instructions" style="width:140px; padding:6px; border:1px solid #ccc; border-radius:4px; margin-top:4px;">
        </td>
        <td>
          <span class="status-badge <%= m.is_active ? 'status-delivered' : 'status-cancelled' %>">
            <%= m.is_active ? 'Active' : 'Inactive' %>
          </span>
        </td>
        <td style="white-space:nowrap;">
          <button type="submit" form="edit-form-<%= m.id %>" class="link-btn-danger" style="color:#2196f3;">Save</button>
          |
          <form action="/admin/payment-methods/toggle/<%= m.id %>" method="POST" style="display:inline">
            <button type="submit" class="link-btn-danger" style="color:#2196f3;"><%= m.is_active ? 'Deactivate' : 'Activate' %></button>
          </form>
          |
          <form action="/admin/payment-methods/delete/<%= m.id %>" method="POST" style="display:inline" onsubmit="return confirm('Sure to delete?');">
            <button type="submit" class="link-btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <% if (methods.length === 0) { %>
      <tr><td colspan="5" style="text-align:center; color:#888;">No payment methods yet. Add one above.</td></tr>
    <% } %>
  </tbody>
</table>
</div>

<%- include('../partials/admin-footer') %>
