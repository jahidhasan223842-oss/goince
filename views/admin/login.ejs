<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login - <%= siteName %></title>
  <script>
    (function () {
      /* One-time theme reset (fix/whmcs-light-theme) — same as the admin
         header: a stored 'dark' is reset to 'light' once, then the
         toggle choice is respected. */
      var MIGRATION_KEY = 'goince-theme-whmcs-v1';
      var stored = null;
      try {
        if (!localStorage.getItem(MIGRATION_KEY)) {
          localStorage.setItem('goince-theme', 'light');
          localStorage.setItem(MIGRATION_KEY, '1');
        }
        stored = localStorage.getItem('goince-theme');
      } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || 'light');
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/style.css') : '/css/style.css' %>">
</head>
<body class="admin-login-body">
  <div class="admin-login-box">
    <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="<%= siteName %>" class="admin-login-logo">
    <h2><%= siteName %> Admin</h2>
    <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
    <% if (typeof message !== 'undefined' && message) { %><p class="success-msg"><%= message %></p><% } %>
    <form action="/admin/login" method="POST"><%- include('../partials/csrf-field') %>
      <label>Email</label>
      <input type="email" name="email" required>
      <label>Password</label>
      <div class="password-wrapper">
        <input type="password" name="password" id="admin-password" required>
        <button type="button" class="password-toggle-btn" onclick="var i=document.getElementById('admin-password'); var isHidden=i.type==='password'; i.type=isHidden?'text':'password'; this.textContent=isHidden?'Hide':'Show';">Show</button>
      </div>
      <label class="remember-me-row">
        <input type="checkbox" name="remember_me" value="1">
        Remember Me
      </label>
      <button type="submit" class="btn-primary">Login</button>
    </form>
    <p class="switch-link"><a href="/admin/forgot-password">Forgot Password?</a></p>
  </div>
</body>
</html>
