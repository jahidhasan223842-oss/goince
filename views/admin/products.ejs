<%- include('../partials/admin-header') %>

<% const _perms = (typeof adminPermissions !== 'undefined' && Array.isArray(adminPermissions)) ? adminPermissions : null; const _can = (perm) => !_perms || _perms.includes(perm); %>
<div class="admin-page-header">
  <h1>Products</h1>
  <% if (_can('products.manage')) { %>
  <span>
    <a href="/admin/products/add" class="btn-primary">+ Add New Product</a>
    <a href="/admin/products/import" class="btn-secondary">⇪ Import CSV</a>
    <a href="/admin/products/export" class="btn-secondary">⇩ Export CSV</a>
  </span>
  <% } %>
</div>

<form method="GET" action="/admin/products" class="admin-search-form">
  <input type="text" name="q" value="<%= q || '' %>" placeholder="Search by name, SKU or brand...">
  <% if (typeof categoryGroups !== 'undefined' && categoryGroups.length) { %>
  <select name="category">
    <option value="">All Categories</option>
    <% categoryGroups.forEach(g => { %>
    <optgroup label="<%= g.label %>">
      <% g.options.forEach(o => { %><option value="<%= o.id %>" <%= String(typeof category !== 'undefined' ? category : '') === String(o.id) ? 'selected' : '' %>><%= '— '.repeat(o.depth) %><%= o.name %></option><% }) %>
    </optgroup>
    <% }) %>
  </select>
  <% } else if (typeof categories !== 'undefined' && categories.length) { %>
  <select name="category">
    <option value="">All Categories</option>
    <% categories.forEach(c => { %><option value="<%= c.id %>" <%= String(typeof category !== 'undefined' ? category : '') === String(c.id) ? 'selected' : '' %>><%= c.parent_id ? '— ' : '' %><%= c.name %></option><% }) %>
  </select>
  <% } %>
  <button type="submit" class="btn-primary">Search</button>
  <% if (q || (typeof category !== 'undefined' && category)) { %> <a href="/admin/products">Clear</a> <% } %>
</form>

<% if (products.length === 0) { %>
  <p>No products found. Try clearing the search.</p>
<% } else { %>
<div class="table-responsive">
<table class="admin-table">
  <thead>
    <tr>
      <th>Image</th>
      <th>Name</th>
      <th>Category</th>
      <th>Audience</th>
      <th>Price</th>
      <th>Cost / Profit</th>
      <th>Status</th>
      <th>Stock</th>
      <th>Video</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><img src="/uploads/<%= p.image %>" class="admin-thumb" onerror="this.src='/uploads/no-image.png'"></td>
        <td><%= p.name %><% if (p.source_link) { %><br><a href="<%= p.source_link %>" target="_blank" style="font-size:11px; color:var(--text-muted);">source ↗</a><% } %></td>
        <td><%= p.category_name || '-' %></td>
        <td><%= p.target_audience && p.target_audience !== 'all' ? (p.target_audience.charAt(0).toUpperCase() + p.target_audience.slice(1)) : 'All / General' %></td>
        <td>৳<%= p.price %></td>
        <td><% if (p.cost_price != null) { %>৳<%= p.cost_price %> / <strong style="color:green;">+৳<%= (p.price - p.cost_price).toFixed(0) %></strong><% } else { %>-<% } %></td>
        <td><% if (p.status === 'draft') { %><span class="status-badge status-cancelled">Draft</span><% } else if (p.scheduled_at && new Date(p.scheduled_at) > new Date()) { %><span class="status-badge">Scheduled</span><% } else { %><span class="status-badge status-delivered">Published</span><% } %><% if (p.is_featured) { %><br><small>⭐ Featured</small><% } %><% if (p.is_new) { %><br><small>🆕 New</small><% } %></td>
        <td><%= p.stock %></td>
        <td style="min-width:160px;">
          <% if (p.video_filename) { %>
            <span style="color:green; font-size:12px;">✓ Video Ready</span><br>
            <% if (_can('products.manage')) { %><a href="/admin/products/<%= p.id %>/video/download" class="btn-sm" style="margin-top:4px; display:inline-block;">Download</a>
            <form action="/admin/products/<%= p.id %>/video/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this video?');"><%- include('../partials/csrf-field') %>
              <button type="submit" class="link-btn-danger" style="font-size:12px;">Delete</button>
            </form><% } %>
          <% } else { %>
            <span style="color:var(--text-muted); font-size:12px;">No video</span>
          <% } %>
          <br>
          <% if (_can('products.manage')) { %><button type="button" class="btn-sm generate-video-btn" data-id="<%= p.id %>" style="margin-top:6px; background:#e94560; color:white; border:none; padding:5px 10px; border-radius:4px; cursor:pointer; font-size:12px;">
            🎬 Generate Video
          </button><% } %>
          <span class="video-status" id="status-<%= p.id %>" style="font-size:11px; display:block; margin-top:4px;"></span>
        </td>
        <td>
          <% if (_can('products.manage')) { %>
          <a href="/admin/products/edit/<%= p.id %>">Edit</a> |
          <a href="/admin/products/<%= p.id %>/stock-history">History</a> |
          <form action="/admin/products/<%= p.id %>/duplicate" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><button type="submit" class="link-btn-danger" style="color:#2196f3;">Duplicate</button></form> |
          <form action="/admin/products/delete/<%= p.id %>" method="POST" style="display:inline" onsubmit="return confirm('Sure to delete?');"><%- include('../partials/csrf-field') %>
            <button type="submit" class="link-btn-danger">Delete</button>
          </form>
          <% } else { %><span style="color:var(--text-muted);">View only</span><% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>

<script>
document.querySelectorAll('.generate-video-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const id = this.dataset.id;
    const status = document.getElementById('status-' + id);
    this.disabled = true;
    this.textContent = '⏳ Generating...';
    status.textContent = 'Please wait 15-40 seconds...';
    status.style.color = '#666';

    try {
      const csrfMeta = document.querySelector('meta[name="csrf-token"]');
      const res = await fetch('/admin/products/' + id + '/generate-video', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', ...(csrfMeta ? { 'x-csrf-token': csrfMeta.content } : {}) }
      });
      const data = await res.json();
      if (data.ok) {
        status.textContent = '✅ ' + data.message;
        status.style.color = 'green';
        setTimeout(() => location.reload(), 1200);
      } else {
        status.textContent = '❌ ' + (data.error || 'Failed');
        status.style.color = 'red';
        this.disabled = false;
        this.textContent = '🎬 Generate Video';
      }
    } catch (err) {
      status.textContent = '❌ Network error';
      status.style.color = 'red';
      this.disabled = false;
      this.textContent = '🎬 Generate Video';
    }
  });
});
</script>

<%- include('../partials/admin-footer') %>
