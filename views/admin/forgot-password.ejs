<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Forgot Password - <%= siteName %></title>
  <script>
    (function () {
      /* One-time theme reset (fix/whmcs-light-theme) — same as the admin
         header: a stored 'dark' is reset to 'light' once, then the
         toggle choice is respected. */
      var MIGRATION_KEY = 'goince-theme-whmcs-v1';
      var stored = null;
      try {
        if (!localStorage.getItem(MIGRATION_KEY)) {
          localStorage.setItem('goince-theme', 'light');
          localStorage.setItem(MIGRATION_KEY, '1');
        }
        stored = localStorage.getItem('goince-theme');
      } catch (e) {}
      document.documentElement.setAttribute('data-theme', stored || 'light');
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof assetUrl === 'function' ? assetUrl('/css/style.css') : '/css/style.css' %>">
</head>
<body class="admin-login-body">
  <div class="admin-login-box">
    <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/icons/icon-192.png' %>" alt="<%= siteName %>" class="admin-login-logo">
    <h2><%= siteName %> Admin</h2>
    <% if (error) { %><p class="error-msg"><%= error %></p><% } %>
    <% if (message) { %><p class="success-msg"><%= message %></p><% } %>

    <form action="/admin/forgot-password" method="POST"><%- include('../partials/csrf-field') %>
      <label>Admin Email</label>
      <input type="email" name="email" required>
      <button type="submit" class="btn-primary">Send Reset Link</button>
    </form>

    <p class="switch-link"><a href="/admin/login">Back to Login</a></p>
  </div>
</body>
</html>
