<%- include('../partials/admin-header') %>

<h1>Orders</h1>

<div class="table-responsive">
<table class="admin-table">
  <thead>
    <tr><th>ID</th><th>Customer</th><th>Phone</th><th>Total</th><th>Status</th><th>Payment</th><th>Date</th><th></th></tr>
  </thead>
  <tbody>
    <% orders.forEach(o => { %>
      <tr>
        <td>#<%= o.id %></td>
        <td><%= o.customer_name %></td>
        <td><%= o.phone %></td>
        <td>৳<%= o.total_amount %></td>
        <td><span class="status-badge status-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
        <td><span class="status-badge <%= o.payment_status === 'Paid' ? 'status-delivered' : 'status-pending' %>"><%= o.payment_status || 'Unpaid' %></span></td>
        <td><%= new Date(o.created_at).toLocaleDateString() %></td>
        <td><a href="/admin/orders/<%= o.id %>">View</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>

<%- include('../partials/admin-footer') %>
