  <script>
    // Profit preview + slug auto-fill
    (function () {
      var price = document.querySelector('input[name="price"]');
      var cost = document.getElementById('cost_price');
      var preview = document.getElementById('profit-preview');
      var nameInput = document.querySelector('input[name="name"]');
      var slugInput = document.getElementById('slug');
      function updateProfit() {
        var p = parseFloat(price.value), c = parseFloat(cost.value);
        if (!isNaN(p) && !isNaN(c)) {
          var profit = p - c, pct = c > 0 ? Math.round(profit / c * 100) : 0;
          preview.textContent = 'Profit per sale: ৳' + profit.toFixed(0) + ' (' + pct + '% on cost)';
        } else preview.textContent = '';
      }
      price.addEventListener('input', updateProfit); cost.addEventListener('input', updateProfit); updateProfit();
      nameInput.addEventListener('input', function () {
        if (!slugInput.value) slugInput.value = nameInput.value.toLowerCase().replace(/[^a-z0-9\s-]/g, '').trim().replace(/\s+/g, '-');
      });
    })();
  </script>

  <script>
    // Collapsible sections: click a heading to open/close it; your choice is remembered
    (function () {
      var KEY = 'goince-product-sections';
      var saved = {};
      try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
      function save() {
        var state = {};
        document.querySelectorAll('.collapsible-section').forEach(function (sec) {
          state[sec.getAttribute('data-section')] = !sec.classList.contains('collapsed');
        });
        try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
      }
      function setSection(sec, open) {
        sec.classList.toggle('collapsed', !open);
        sec.querySelector('.section-toggle').setAttribute('aria-expanded', String(open));
      }
      document.querySelectorAll('.collapsible-section').forEach(function (sec) {
        var id = sec.getAttribute('data-section');
        var open = saved.hasOwnProperty(id) ? saved[id] : !sec.classList.contains('collapsed');
        setSection(sec, open);
        sec.querySelector('.section-toggle').addEventListener('click', function () {
          setSection(sec, sec.classList.contains('collapsed'));
          save();
        });
      });
      document.getElementById('expand-all-sections').addEventListener('click', function () {
        document.querySelectorAll('.collapsible-section').forEach(function (sec) { setSection(sec, true); });
        save();
      });
      document.getElementById('collapse-all-sections').addEventListener('click', function () {
        document.querySelectorAll('.collapsible-section').forEach(function (sec) { setSection(sec, false); });
        save();
      });
      // Required field khali thakle browser je section-e ache sheta khule debe
      document.getElementById('product-main-form').addEventListener('invalid', function () {
        document.querySelectorAll('.collapsible-section').forEach(function (sec) { setSection(sec, true); });
      }, true);
    })();
  </script>
  <script>
    // Drag & drop: section-er ⠿ handle dhore tene order bodlano; order mone rakha hobe
    (function () {
      var ORDER_KEY = 'goince-product-section-order';
      var form = document.getElementById('product-main-form');
      var dragged = null;

      function sections() {
        return Array.prototype.slice.call(form.querySelectorAll('.collapsible-section'));
      }
      function saveOrder() {
        try {
          localStorage.setItem(ORDER_KEY, JSON.stringify(sections().map(function (sec) {
            return sec.getAttribute('data-section');
          })));
        } catch (e) {}
      }
      function applySavedOrder() {
        var saved;
        try { saved = JSON.parse(localStorage.getItem(ORDER_KEY) || '[]'); } catch (e) { saved = []; }
        if (!saved || !saved.length) return;
        var anchor = form.querySelector('button[type="submit"]');
        var byId = {};
        sections().forEach(function (sec) { byId[sec.getAttribute('data-section')] = sec; });
        saved.forEach(function (id) {
          if (byId[id]) form.insertBefore(byId[id], anchor);
        });
      }
      function clearIndicators() {
        sections().forEach(function (sec) {
          sec.classList.remove('drag-over-top', 'drag-over-bottom');
        });
      }
      sections().forEach(function (sec) {
        var handle = sec.querySelector('.drag-handle');
        handle.addEventListener('dragstart', function (e) {
          dragged = sec;
          sec.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
          try { e.dataTransfer.setData('text/plain', sec.getAttribute('data-section')); } catch (err) {}
        });
        handle.addEventListener('dragend', function () {
          dragged = null;
          sec.classList.remove('dragging');
          clearIndicators();
        });
        sec.addEventListener('dragover', function (e) {
          if (!dragged || dragged === sec) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = 'move';
          var rect = sec.getBoundingClientRect();
          var before = (e.clientY - rect.top) < rect.height / 2;
          sec.classList.toggle('drag-over-top', before);
          sec.classList.toggle('drag-over-bottom', !before);
        });
        sec.addEventListener('dragleave', function () {
          sec.classList.remove('drag-over-top', 'drag-over-bottom');
        });
        sec.addEventListener('drop', function (e) {
          if (!dragged || dragged === sec) return;
          e.preventDefault();
          var rect = sec.getBoundingClientRect();
          var before = (e.clientY - rect.top) < rect.height / 2;
          form.insertBefore(dragged, before ? sec : sec.nextSibling);
          clearIndicators();
          saveOrder();
        });
        // Up/down buttons: mouse chara (mobile/keyboard) order bodlanor upay
        sec.querySelectorAll('.section-move button').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var list = sections();
            var i = list.indexOf(sec);
            if (btn.getAttribute('data-move') === 'up' && i > 0) {
              form.insertBefore(sec, list[i - 1]);
            } else if (btn.getAttribute('data-move') === 'down' && i < list.length - 1) {
              form.insertBefore(list[i + 1], sec);
            }
            saveOrder();
          });
        });
      });
      applySavedOrder();
    })();
  </script>

