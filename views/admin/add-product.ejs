<%- include('../partials/admin-header') %>

<h1><%= product ? 'Edit Product' : 'Add New Product' %></h1>

<form action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/add' %>" method="POST" enctype="multipart/form-data" class="admin-form">
  <label>Product Name</label>
  <input type="text" name="name" value="<%= product ? product.name : '' %>" required>

  <label>Category</label>
  <select name="category_id">
    <option value="">-- Select Category --</option>
    <% categories.forEach(cat => { %>
      <option value="<%= cat.id %>" <%= (product && product.category_id == cat.id) ? 'selected' : '' %>><%= cat.parent_id ? '— ' : '' %><%= cat.name %></option>
    <% }) %>
  </select>

  <label>Short Description — Ekta-dui line-e product-ta ki, ei ta product page-e title-r nichei dekhabe</label>
  <textarea name="short_description" rows="2" maxlength="300" placeholder="Jemon: 100% cotton comfortable t-shirt, everyday wear-er jonno perfect."><%= product && product.short_description ? product.short_description : '' %></textarea>

  <label>Long Description — Product niye bistarito lekha, ei ta page-er niche "Product Details" section-e dekhabe</label>
  <textarea name="description" rows="6" placeholder="Product-ta niye vindin details lekhun - material, use-case, care instruction, ba jekono kichu customer jana dorkar."><%= product ? product.description : '' %></textarea>

  <label>Specifications (ekta line e ekta feature, jemon: Material: Cotton)</label>
  <textarea name="specifications" rows="4" placeholder="Material: Cotton&#10;Weight: 200g&#10;Origin: Bangladesh"><%= product && product.specifications ? product.specifications : '' %></textarea>

  <label>Regular Price (৳) — Optional, product-er actual/original price</label>
  <input type="number" step="0.01" name="compare_at_price" value="<%= product && product.compare_at_price ? product.compare_at_price : '' %>" placeholder="e.g. 999">

  <label>Discount Price (৳) — Eita-i customer ke show hobe, website-e ei price-e product bikri hobe</label>
  <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required placeholder="e.g. 799">

  <label>Stock Quantity</label>
  <input type="number" name="stock" value="<%= product ? product.stock : 0 %>" required>

  <label>Main Product Image</label>
  <input type="file" name="image" accept="image/*">
  <% if (product && product.image) { %>
    <img src="/uploads/<%= product.image %>" class="admin-thumb" style="margin-top:10px;">
  <% } %>

  <label>Gallery Images (aro extra chobi, ekbare kototuku o dite paro)</label>
  <input type="file" name="gallery" accept="image/*" multiple>

  <button type="submit" class="btn-primary"><%= product ? 'Update Product' : 'Add Product' %></button>
</form>

<% if (galleryImages && galleryImages.length > 0) { %>
  <div style="margin-top:20px;">
    <p style="font-size:13px; color:#888;">Existing gallery images:</p>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <% galleryImages.forEach(img => { %>
        <div style="position:relative;">
          <img src="/uploads/<%= img.image %>" class="admin-thumb">
          <form action="/admin/products/<%= product.id %>/gallery/delete/<%= img.id %>" method="POST" style="margin-top:4px;">
            <button type="submit" class="link-btn-danger" style="font-size:11px;">Remove</button>
          </form>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<% if (product) { %>
  <hr>
  <h3>Product Options<% if (options && options.length > 0) { %> — <%= options[0].option_label %><% } %></h3>
  <p style="font-size:13px; color:#888; margin-bottom:12px;">
    Ei product-e Color, Size, Weight (kg) — jekono ekta ধরনের option add korte parben (ekbare ekta product-e ekই ধরনের).
    Chobi dile shei value select korle main image-o bodle jabe; na dile shudhu text/color swatch dekhabe.
  </p>

  <% if (options && options.length > 0) { %>
    <div style="display:flex; gap:14px; flex-wrap:wrap; margin-bottom:20px;">
      <% options.forEach(o => { %>
        <div style="text-align:center; position:relative;">
          <% if (o.image) { %>
            <img src="/uploads/<%= o.image %>" class="admin-thumb" style="display:block; margin:0 auto 4px;">
          <% } else if (o.color_hex) { %>
            <span style="display:block; width:45px; height:45px; border-radius:4px; border:1px solid #ddd; background:<%= o.color_hex %>; margin:0 auto 4px;"></span>
          <% } %>
          <span style="font-size:12px; display:block;"><%= o.value_name %></span>
          <form action="/admin/products/<%= product.id %>/options/delete/<%= o.id %>" method="POST" style="margin-top:4px;">
            <button type="submit" class="link-btn-danger" style="font-size:11px;">Remove</button>
          </form>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p style="color:#888; font-size:13px; margin-bottom:16px;">Ekhono kono option add kora hoyni.</p>
  <% } %>

  <form action="/admin/products/<%= product.id %>/options/add" method="POST" enctype="multipart/form-data" class="inline-form" style="flex-wrap:wrap;">
    <% if (!options || options.length === 0) { %>
      <input type="text" name="option_label" placeholder="Option name (Color / Size / Weight...)" required style="min-width:180px;">
    <% } %>
    <input type="text" name="value_name" placeholder="Value (e.g. Red / Large / 1kg)" required>
    <label style="display:flex; align-items:center; gap:4px; font-size:12px; font-weight:normal;">
      <input type="checkbox" name="use_color_hex" value="1" onchange="document.getElementById('color_hex_input').style.display = this.checked ? 'inline-block' : 'none';">
      Color swatch?
    </label>
    <input type="color" name="color_hex" id="color_hex_input" value="#f0a500" style="display:none; width:50px; height:38px; padding:2px; border:1px solid #ccc; border-radius:4px;">
    <input type="file" name="option_image" accept="image/*" title="Optional: ei value-er product photo">
    <button type="submit">Add</button>
  </form>
<% } else { %>
  <p style="color:#888; font-size:13px; margin-top:20px;">Product-ta save korar por, edit page theke Option (Color/Size/Weight) add korte parbe.</p>
<% } %>

<hr>
<h3>Quick Add Category</h3>
<form action="/admin/categories/add" method="POST" class="inline-form">
  <input type="text" name="name" placeholder="New category name" required>
  <select name="parent_id">
    <option value="">-- Main Category --</option>
    <% categories.filter(c => !c.parent_id).forEach(mc => { %>
      <option value="<%= mc.id %>">Sub-category of: <%= mc.name %></option>
    <% }) %>
  </select>
  <button type="submit">Add Category</button>
</form>

<%- include('../partials/admin-footer') %>
