<%- include('../partials/admin-header') %>

<% const _statusBadge = (s) => (s || 'open') === 'open' ? 'status-pending' : (s === 'closed' ? 'status-cancelled' : 'status-delivered'); %>
<% const _status = message.status || 'open'; %>

<div class="admin-page-header">
  <h1>Message #<%= message.id %></h1>
  <div><a href="/admin/messages" class="btn-primary">&larr; Back to Messages</a></div>
</div>

<div class="invoice-box" style="margin-bottom:20px;">
  <p><strong>From:</strong> <%= message.name %> <% if (message.phone) { %>(<a href="tel:<%= message.phone %>"><%= message.phone %></a>)<% } %> <%= message.email || '' %></p>
  <p><strong>Subject:</strong> <%= message.subject || '-' %></p>
  <p><strong>Date:</strong> <%= new Date(message.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
  <p><strong>Status:</strong> <span class="status-badge <%= _statusBadge(_status) %>"><%= _status %></span></p>
  <hr>
  <p><%= message.message %></p>
  <% if (message.reply) { %>
    <hr>
    <p><strong>Your reply:</strong></p>
    <p><%= message.reply %></p>
    <p class="field-hint">Replied <%= message.replied_at ? new Date(message.replied_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %></p>
  <% } %>
</div>

<h2>Reply</h2>
<p class="field-hint">Write down what you told the customer (by phone or WhatsApp) — saving marks the ticket Answered.</p>
<form action="/admin/messages/<%= message.id %>/reply" method="POST" class="admin-form"><%- include('../partials/csrf-field') %>
  <label for="message-reply">Reply</label>
  <textarea id="message-reply" name="reply" rows="4" placeholder="e.g. Called the customer, confirmed delivery for tomorrow…"><%= message.reply || '' %></textarea>
  <div style="margin-top:12px;"><button type="submit" class="btn-primary">Save Reply</button></div>
</form>

<h2 style="margin-top:24px;">Change Status</h2>
<form action="/admin/messages/<%= message.id %>/status" method="POST" class="admin-form"><%- include('../partials/csrf-field') %>
  <label for="message-status">Status</label>
  <select id="message-status" name="status">
    <option value="open" <%= _status === 'open' ? 'selected' : '' %>>Open</option>
    <option value="answered" <%= _status === 'answered' ? 'selected' : '' %>>Answered</option>
    <option value="closed" <%= _status === 'closed' ? 'selected' : '' %>>Closed</option>
  </select>
  <div style="margin-top:12px;"><button type="submit" class="btn-primary">Update Status</button></div>
</form>

<div style="margin-top:20px;">
  <% if (!message.is_read) { %><form action="/admin/messages/<%= message.id %>/read" method="POST" style="display:inline;"><%- include('../partials/csrf-field') %><button type="submit" class="btn-primary">Mark Read</button></form> <% } %>
  <form action="/admin/messages/<%= message.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this message?');"><%- include('../partials/csrf-field') %><button type="submit" class="link-btn-danger" style="padding:10px 22px;border-radius:5px;">Delete Message</button></form>
</div>

<%- include('../partials/admin-footer') %>
