<%- include('../partials/admin-header') %>

<% const _groups = (typeof permissionGroups !== 'undefined' && Array.isArray(permissionGroups)) ? permissionGroups : []; %>

<div class="admin-page-header">
  <h1><%= role ? (readOnly ? 'View Role: ' + role.name : 'Edit Role: ' + role.name) : 'Create Custom Role' %></h1>
  <p style="color:#666;"><%= readOnly ? 'System roles cannot be edited — this is what the role can do.' : 'Tick exactly what this role can do. New features added later will appear here automatically.' %></p>
</div>

<% if (message) { %><p class="success-msg"><%= message %></p><% } %>
<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<% const _checked = (role && role.permissions) ? role.permissions : []; %>
<% const _action = role ? ('/admin/roles/edit/' + role.id) : '/admin/roles/add'; %>

<form action="<%= _action %>" method="POST" class="admin-form" style="max-width:720px;"><%- include('../partials/csrf-field') %>
  <label>Role name</label>
  <input type="text" name="name" required maxlength="100" placeholder="e.g. Order Handler" value="<%= role ? role.name : '' %>" <%= readOnly ? 'disabled' : '' %>>
  <label>Description</label>
  <input type="text" name="description" maxlength="500" placeholder="What is this role for?" value="<%= role ? (role.description || '') : '' %>" <%= readOnly ? 'disabled' : '' %>>

  <h2 style="margin:24px 0 8px;">Permissions</h2>
  <% _groups.forEach((grp, gi) => { %>
    <fieldset class="role-perm-group" data-perm-group="<%= gi %>">
      <legend><%= grp.group %></legend>
      <% if (!readOnly) { %>
        <p style="margin:0 0 4px;">
          <button type="button" class="link-btn" onclick="togglePermGroup(<%= gi %>, true)">Select all</button>
          |
          <button type="button" class="link-btn" onclick="togglePermGroup(<%= gi %>, false)">Clear</button>
        </p>
      <% } %>
      <% grp.items.forEach(item => { %>
        <label class="perm-check-row">
          <input type="checkbox" name="permissions" value="<%= item.id %>" <%= _checked.includes(item.id) ? 'checked' : '' %> <%= readOnly ? 'disabled' : '' %>>
          <span><strong><%= item.label %></strong><br><small style="color:var(--text-muted);"><%= item.desc %></small></span>
        </label>
      <% }) %>
    </fieldset>
  <% }) %>

  <p style="margin-top:16px;">
    <% if (!readOnly) { %>
      <button type="submit" class="btn-primary"><%= role ? 'Save Role' : 'Create Role' %></button>
    <% } %>
    <a href="/admin/roles" class="btn-secondary" style="text-decoration:none; display:inline-block; padding:10px 18px; margin-left:8px;">Back to Roles</a>
  </p>
</form>

<script>
function togglePermGroup(gi, on) {
  document.querySelectorAll('[data-perm-group="' + gi + '"] input[type="checkbox"]').forEach(function (cb) { cb.checked = on; });
}
</script>

<%- include('../partials/admin-footer') %>
