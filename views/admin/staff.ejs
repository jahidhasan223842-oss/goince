<%- include('../partials/admin-header') %>

<% const _roles = (typeof roles !== 'undefined' && Array.isArray(roles)) ? roles : []; %>

<div class="admin-page-header">
  <h1>Staff &amp; Roles</h1>
  <p style="color:var(--text-muted);">Owner can do everything. Manager can manage products, orders, customers and inventory. Staff can only view orders and products. Create your own roles with exactly the access you want.</p>
</div>

<% if (message) { %><p class="success-msg"><%= message %></p><% } %>
<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<p style="margin-bottom:16px;">
  <a href="/admin/roles" class="btn-primary" style="text-decoration:none; display:inline-block; padding:10px 18px;">🎭 Manage Roles &amp; Permissions</a>
</p>

<h2 style="margin-bottom:12px;">Add Staff Account</h2>
<form action="/admin/staff/add" method="POST" class="admin-form admin-form--wide"><%- include('../partials/csrf-field') %>
  <label>Email</label>
  <input type="email" name="email" required placeholder="staff@example.com">
  <label>Password</label>
  <input type="password" name="password" required minlength="6" placeholder="At least 6 characters">
  <label>Role</label>
  <select name="role">
    <% if (_roles.length) { %>
      <% _roles.forEach(r => { %>
        <option value="role:<%= r.id %>" <%= r.name === 'Staff' ? 'selected' : '' %>><%= r.name %><%= r.is_system ? '' : ' (custom)' %><%= r.description ? ' — ' + r.description : '' %></option>
      <% }) %>
    <% } else { %>
      <option value="manager">Manager — products, orders, customers, inventory</option>
      <option value="staff" selected>Staff — orders + products, view only</option>
      <option value="owner">Owner — everything</option>
    <% } %>
  </select>
  <button type="submit" class="btn-primary" style="margin-top:12px;">Add Staff</button>
</form>

<h2 style="margin:28px 0 12px;">All Admins</h2>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr><th>Email</th><th>Role</th><th>Created</th><th>Change Role</th><th>Reset Password</th><th></th></tr>
    </thead>
    <tbody>
      <% admins.forEach(a => { %>
        <% const _roleRow = _roles.find(r => a.role_id && String(r.id) === String(a.role_id)); %>
        <% const _roleName = _roleRow ? _roleRow.name : a.role; %>
        <tr>
          <td><%= a.email %><% if (typeof meId !== 'undefined' && String(a.id) === String(meId)) { %> <span class="status-badge status-confirmed" style="margin-left:6px;">You</span><% } %></td>
          <td><span class="status-badge <%= _roleName === 'Owner' ? 'status-delivered' : (_roleName === 'Manager' ? 'status-confirmed' : 'status-pending') %>"><%= _roleName %></span></td>
          <td><%= a.created_at ? new Date(a.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '-' %></td>
          <td>
            <% if (typeof meId !== 'undefined' && String(a.id) === String(meId)) { %>
              <span style="color:var(--text-muted);">—</span>
            <% } else { %>
              <form action="/admin/staff/<%= a.id %>/role" method="POST" class="inline-form"><%- include('../partials/csrf-field') %>
                <select name="role">
                  <% if (_roles.length) { %>
                    <% _roles.forEach(r => { %>
                      <option value="role:<%= r.id %>" <%= (_roleRow ? String(r.id) === String(a.role_id) : r.name.toLowerCase() === String(a.role || '').toLowerCase()) ? 'selected' : '' %>><%= r.name %><%= r.is_system ? '' : ' (custom)' %></option>
                    <% }) %>
                  <% } else { %>
                    <option value="owner" <%= a.role === 'owner' ? 'selected' : '' %>>Owner</option>
                    <option value="manager" <%= a.role === 'manager' ? 'selected' : '' %>>Manager</option>
                    <option value="staff" <%= a.role === 'staff' ? 'selected' : '' %>>Staff</option>
                  <% } %>
                </select>
                <button type="submit" class="btn-sm btn-sm--primary">Save</button>
              </form>
            <% } %>
          </td>
          <td>
            <form id="reset-form-<%= a.id %>" action="/admin/staff/<%= a.id %>/reset-password" method="POST" style="display:none;"><%- include('../partials/csrf-field') %>
              <input type="hidden" name="new_password" value="">
            </form>
            <button type="button" class="btn-sm" onclick='resetStaffPassword(<%= a.id %>, <%= JSON.stringify(a.email) %>)'>Reset password</button>
          </td>
          <td>
            <% if (typeof meId !== 'undefined' && String(a.id) === String(meId)) { %>
              <span style="color:var(--text-muted);">—</span>
            <% } else { %>
              <form action="/admin/staff/<%= a.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this admin account?');"><%- include('../partials/csrf-field') %>
                <button type="submit" class="btn-sm btn-sm--danger">Delete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<script>
// Password reset lives in a button, not a cramped input inside the table
// cell: ask for the new password, then submit the hidden form.
function resetStaffPassword(id, email) {
  var pw = prompt('Enter a new password for ' + email + ' (at least 6 characters):');
  if (pw === null) return;
  if (!pw || pw.length < 6) { alert('Password must be at least 6 characters.'); return; }
  var f = document.getElementById('reset-form-' + id);
  f.querySelector('input[name="new_password"]').value = pw;
  f.submit();
}
</script>

<%- include('../partials/admin-footer') %>
