<%- include('../partials/admin-header') %>

<div class="admin-page-header">
  <h1>Staff &amp; Roles</h1>
  <p style="color:#666;">Owner can do everything. Manager can manage products, orders, customers and inventory. Staff can only view orders and products.</p>
</div>

<% if (message) { %><p class="success-msg"><%= message %></p><% } %>
<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<h2 style="margin-bottom:12px;">Add Staff Account</h2>
<form action="/admin/staff/add" method="POST" class="admin-form" style="max-width:520px;">
  <label>Email</label>
  <input type="email" name="email" required placeholder="staff@example.com">
  <label>Password</label>
  <input type="password" name="password" required minlength="6" placeholder="At least 6 characters">
  <label>Role</label>
  <select name="role">
    <option value="manager">Manager — products, orders, customers, inventory</option>
    <option value="staff">Staff — orders + products, view only</option>
    <option value="owner">Owner — everything</option>
  </select>
  <button type="submit" class="btn-primary" style="margin-top:12px;">Add Staff</button>
</form>

<h2 style="margin:28px 0 12px;">All Admins</h2>
<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr><th>Email</th><th>Role</th><th>Created</th><th>Change Role</th><th>Reset Password</th><th></th></tr>
    </thead>
    <tbody>
      <% admins.forEach(a => { %>
        <tr>
          <td><%= a.email %><% if (typeof meId !== 'undefined' && String(a.id) === String(meId)) { %> <span class="status-badge status-confirmed">You</span><% } %></td>
          <td><span class="status-badge <%= a.role === 'owner' ? 'status-delivered' : (a.role === 'manager' ? 'status-confirmed' : 'status-pending') %>"><%= a.role %></span></td>
          <td><%= a.created_at ? new Date(a.created_at).toLocaleDateString() : '-' %></td>
          <td>
            <% if (typeof meId !== 'undefined' && String(a.id) === String(meId)) { %>
              <span style="color:#999;">—</span>
            <% } else { %>
              <form action="/admin/staff/<%= a.id %>/role" method="POST" class="inline-form">
                <select name="role">
                  <option value="owner" <%= a.role === 'owner' ? 'selected' : '' %>>Owner</option>
                  <option value="manager" <%= a.role === 'manager' ? 'selected' : '' %>>Manager</option>
                  <option value="staff" <%= a.role === 'staff' ? 'selected' : '' %>>Staff</option>
                </select>
                <button type="submit" class="btn-primary" style="padding:4px 10px;">Save</button>
              </form>
            <% } %>
          </td>
          <td>
            <form action="/admin/staff/<%= a.id %>/reset-password" method="POST" class="inline-form">
              <input type="password" name="new_password" required minlength="6" placeholder="New password" style="width:130px;">
              <button type="submit" class="btn-primary" style="padding:4px 10px;">Reset</button>
            </form>
          </td>
          <td>
            <% if (typeof meId !== 'undefined' && String(a.id) === String(meId)) { %>
              <span style="color:#999;">—</span>
            <% } else { %>
              <form action="/admin/staff/<%= a.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this admin account?');">
                <button type="submit" class="link-btn-danger">Delete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-footer') %>
