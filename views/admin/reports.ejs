<%- include('../partials/admin-header') %>

<% const _tk = (v) => { const n = Number(v || 0); return '৳' + (Number.isInteger(n) ? n.toLocaleString('en-BD') : n.toFixed(2)); }; %>

<h1>📊 Reports</h1>

<div class="report-tabs">
  <a href="/admin/reports?period=daily" class="report-tab<%= period === 'daily' ? ' active' : '' %>">Daily</a>
  <a href="/admin/reports?period=weekly" class="report-tab<%= period === 'weekly' ? ' active' : '' %>">Weekly</a>
  <a href="/admin/reports?period=monthly" class="report-tab<%= period === 'monthly' ? ' active' : '' %>">Monthly</a>
  <a href="/admin/reports?period=yearly" class="report-tab<%= period === 'yearly' ? ' active' : '' %>">Yearly</a>
  <a href="/admin/reports?period=all" class="report-tab<%= period === 'all' ? ' active' : '' %>">All Time</a>
  <a href="#" class="report-tab<%= period === 'custom' ? ' active' : '' %>" onclick="document.getElementById('custom-date-form').classList.toggle('hidden'); return false;">📅 Custom Date</a>
</div>

<form id="custom-date-form" class="custom-date-form<%= period === 'custom' ? '' : ' hidden' %>" action="/admin/reports" method="GET">
  <input type="hidden" name="period" value="custom">
  <label>From: <input type="date" name="from" value="<%= customFrom %>" required></label>
  <label>To: <input type="date" name="to" value="<%= customTo %>" required></label>
  <button type="submit" class="btn-primary">Show Report</button>
</form>

<p class="report-period-label">Showing: <strong><%= periodLabel %></strong> &nbsp; <a href="/admin/reports/export?period=<%= period %><% if (period === 'custom') { %>&from=<%= customFrom %>&to=<%= customTo %><% } %>" class="btn-secondary">⇩ Export CSV</a></p>

<div class="report-summary-grid">
  <div class="report-card">
    <p class="report-card-label">Total Orders</p>
    <p class="report-card-value"><%= summary.totalOrders %></p>
  </div>
  <div class="report-card">
    <p class="report-card-label">Total Revenue</p>
    <p class="report-card-value"><%= _tk(summary.totalRevenue) %></p>
  </div>
  <div class="report-card">
    <p class="report-card-label">Items Sold</p>
    <p class="report-card-value"><%= itemsSummary.totalItemsSold %></p>
  </div>
  <div class="report-card">
    <p class="report-card-label">Avg. Order Value</p>
    <p class="report-card-value"><%= _tk(summary.avgOrderValue) %></p>
  </div>
  <div class="report-card">
    <p class="report-card-label">💰 Total Profit (Revenue − Cost)</p>
    <p class="report-card-value" style="color:green;"><%= _tk(typeof totalProfit !== 'undefined' ? totalProfit : 0) %></p>
    <p class="report-card-label">Total cost: <%= _tk(typeof totalCost !== 'undefined' ? totalCost : 0) %> (only orders with a cost price saved)</p>
  </div>
  <div class="report-card report-card-muted">
    <p class="report-card-label">Cancelled Orders</p>
    <p class="report-card-value"><%= cancelledSummary.cancelledOrders %></p>
  </div>
</div>

<h2 class="report-section-heading">🏆 Top Selling Products</h2>
<% if (topProducts.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">🏆</span>
    <strong>No products sold in this period</strong>
    <p>Try a different date range to view sales activity.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Product</th><th>Units Sold</th><th>Revenue</th></tr>
      </thead>
      <tbody>
        <% topProducts.forEach(p => { %>
          <tr>
            <td><%= p.product_name %></td>
            <td><%= p.unitsSold %></td>
            <td><%= _tk(p.revenue) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<h2 class="report-section-heading">📊 Sales by Category</h2>
<% if (typeof categorySales === 'undefined' || categorySales.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">🗂️</span>
    <strong>No categories yet</strong>
    <p>Add a category to see its sales here.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Category</th><th>Orders</th><th>Items Sold</th><th>Revenue</th><th>Cost</th><th>Profit</th></tr>
      </thead>
      <tbody>
        <% categorySales.forEach(c => { %>
          <tr>
            <td><a href="/admin/products?category=<%= c.id %>"><%= c.name %></a></td>
            <td><%= c.orders %></td>
            <td><%= c.items %></td>
            <td><%= _tk(c.revenue) %></td>
            <td><%= _tk(c.cost) %></td>
            <td><%= _tk(c.profit) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="report-note">Each category includes its sub-categories' sales. Products without a category are not counted here.</p>
<% } %>

<h2 class="report-section-heading">🧾 Orders (<%= periodLabel %>)</h2>
<% if (orders.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">🧾</span>
    <strong>No orders found in this period</strong>
    <p>Try a different date range.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Order ID</th><th>Customer</th><th>Amount</th><th>Status</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr>
            <td>#<%= o.id %></td>
            <td><%= o.customer_name %></td>
            <td><%= _tk(o.total_amount) %></td>
            <td><span class="status-badge status-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
            <td><%= new Date(o.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (orders.length === 20) { %>
    <p class="report-note">Only the most recent 20 orders are shown. Visit the <a href="/admin/orders">Orders page</a> to see all orders.</p>
  <% } %>
<% } %>

<%- include('../partials/admin-footer') %>
