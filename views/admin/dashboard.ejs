<%- include('../partials/admin-header') %>

<% const money = (value) => Number(value || 0).toLocaleString('en-BD', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); %>
<% const pct = dashboard.revenueChange; %>
<div class="analytics-header">
  <div>
    <p class="analytics-eyebrow">GOINCE ADMINISTRATION</p>
    <h1>Dashboard Overview</h1>
    <p class="analytics-subtitle">Your store performance at a glance.</p>
  </div>
  <a class="analytics-report-link" href="/admin/reports">Open full reports <span aria-hidden="true">→</span></a>
</div>

<form class="analytics-filter" method="GET" action="/admin/dashboard">
  <div class="analytics-filter-presets" role="group" aria-label="Date range">
    <button type="submit" name="range" value="7" class="analytics-filter-btn <%= dashboard.range === '7' ? 'is-active' : '' %>">7 days</button>
    <button type="submit" name="range" value="30" class="analytics-filter-btn <%= dashboard.range === '30' ? 'is-active' : '' %>">30 days</button>
    <button type="submit" name="range" value="90" class="analytics-filter-btn <%= dashboard.range === '90' ? 'is-active' : '' %>">90 days</button>
  </div>
  <label>From <input type="date" name="from" value="<%= dashboard.from %>" required></label>
  <label>To <input type="date" name="to" value="<%= dashboard.to %>" required></label>
  <button type="submit" name="range" value="custom" class="analytics-apply-btn">Apply dates</button>
</form>
<p class="analytics-period-note">Showing <strong><%= dashboard.from %></strong> to <strong><%= dashboard.to %></strong>. Sales figures exclude cancelled orders; collected revenue counts orders with a recognised paid status.</p>

<section class="admin-quick-links" aria-label="Quick actions">
  <a href="/admin/products">＋ Add Product</a>
  <a href="/admin/orders">🛒 View Orders</a>
  <a href="/admin/messages">✉️ Messages</a>
  <a href="/admin/settings">⚙️ Edit Homepage</a>
  <a href="/" target="_blank">🌐 View Site</a>
</section>

<section class="analytics-kpi-grid" aria-label="Store metrics">
  <article class="analytics-kpi kpi-revenue">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Today's pending orders</span><span class="analytics-kpi-icon">🛒</span></div>
    <strong class="analytics-kpi-value"><%= Number((typeof todaysPendingCount !== 'undefined' ? todaysPendingCount : 0) || 0).toLocaleString() %></strong>
    <span class="analytics-kpi-foot"><a href="/admin/orders?status=Pending">View pending orders →</a></span>
  </article>
  <article class="analytics-kpi kpi-revenue">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Sales revenue</span><span class="analytics-kpi-icon">৳</span></div>
    <strong class="analytics-kpi-value">৳<%= money(dashboard.currentSummary.revenue) %></strong>
    <span class="analytics-kpi-foot"><% if (pct === null) { %>No previous-period baseline<% } else { %><span class="<%= pct >= 0 ? 'trend-up' : 'trend-down' %>"><%= pct > 0 ? '↑' : pct < 0 ? '↓' : '→' %> <%= Math.abs(pct).toFixed(1) %>%</span> vs previous period<% } %></span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Orders in period</span><span class="analytics-kpi-icon">▤</span></div>
    <strong class="analytics-kpi-value"><%= Number(dashboard.currentSummary.ordersCount || 0).toLocaleString() %></strong>
    <span class="analytics-kpi-foot">All non-cancelled orders</span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Average order value</span><span class="analytics-kpi-icon">↗</span></div>
    <strong class="analytics-kpi-value">৳<%= money(dashboard.currentSummary.avgOrderValue) %></strong>
    <span class="analytics-kpi-foot">Average per qualifying order</span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Collected revenue</span><span class="analytics-kpi-icon">✓</span></div>
    <strong class="analytics-kpi-value">৳<%= money(dashboard.currentSummary.collectedRevenue) %></strong>
    <span class="analytics-kpi-foot">Orders marked paid / verified</span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">New customers</span><span class="analytics-kpi-icon">♙</span></div>
    <strong class="analytics-kpi-value"><%= dashboard.newCustomers.toLocaleString() %></strong>
    <span class="analytics-kpi-foot">Registered in selected period</span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">All-time products</span><span class="analytics-kpi-icon">▦</span></div>
    <strong class="analytics-kpi-value"><%= Number(totalProducts || 0).toLocaleString() %></strong>
    <span class="analytics-kpi-foot">Products in catalogue</span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Pending COD / due</span><span class="analytics-kpi-icon">৳</span></div>
    <strong class="analytics-kpi-value">৳<%= money(pendingDue) %></strong>
    <span class="analytics-kpi-foot"><a href="/admin/invoices?tab=unpaid"><%= Number(pendingDueOrders || 0) %> open order(s) still owe — View unpaid →</a></span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Today's revenue</span><span class="analytics-kpi-icon">৳</span></div>
    <strong class="analytics-kpi-value">৳<%= money(todaysSummary.revenue) %></strong>
    <span class="analytics-kpi-foot"><%= Number(todaysSummary.ordersCount || 0) %> order(s) today (Asia/Dhaka)</span>
  </article>
  <article class="analytics-kpi">
    <div class="analytics-kpi-top"><span class="analytics-kpi-label">Profit in period</span><span class="analytics-kpi-icon">↗</span></div>
    <% if (Number(periodProfit.totalUnits || 0) === 0) { %>
      <strong class="analytics-kpi-value">৳0</strong>
      <span class="analytics-kpi-foot">No sales in this period</span>
    <% } else if (Number(periodProfit.costedUnits || 0) === 0) { %>
      <strong class="analytics-kpi-value">—</strong>
      <span class="analytics-kpi-foot">Cost prices not set — add cost price in Add/Edit Product to see real profit.</span>
    <% } else { %>
      <strong class="analytics-kpi-value">৳<%= money(periodProfit.totalProfit) %></strong>
      <span class="analytics-kpi-foot"><% if (Number(periodProfit.costedUnits) < Number(periodProfit.totalUnits)) { %>Cost price set for <%= Number(periodProfit.costedUnits) %> of <%= Number(periodProfit.totalUnits) %> units — partial profit.<% } else { %>Revenue − cost in this period<% } %></span>
    <% } %>
  </article>
</section>

<section class="analytics-panel analytics-attention-panel">
  <div class="analytics-panel-heading"><div><h2>Needs attention</h2><p>Reviews and messages waiting for you</p></div></div>
  <% if (Number(pendingReviews || 0) === 0 && Number(unreadMessages || 0) === 0) { %>
    <div class="analytics-small-empty">Nothing needs attention right now.</div>
  <% } else { %>
    <div class="analytics-attention-list">
      <% if (Number(pendingReviews || 0) > 0) { %>
        <div class="analytics-attention-row">
          <span class="analytics-attention-icon">★</span>
          <div><strong><%= Number(pendingReviews) %> review(s) waiting for approval</strong><span>New reviews are pending by default</span></div>
          <a class="analytics-view-link" href="/admin/reviews">Review →</a>
        </div>
      <% } %>
      <% if (Number(unreadMessages || 0) > 0) { %>
        <div class="analytics-attention-row">
          <span class="analytics-attention-icon">✉</span>
          <div><strong><%= Number(unreadMessages) %> unread message(s)</strong><span>Contact messages you have not opened yet</span></div>
          <a class="analytics-view-link" href="/admin/messages">Read →</a>
        </div>
      <% } %>
    </div>
  <% } %>
</section>

<section class="analytics-main-grid">
  <article class="analytics-panel analytics-chart-panel">
    <div class="analytics-panel-heading">
      <div><h2>Sales trend</h2><p>Daily revenue for the selected period</p></div>
      <span class="analytics-panel-tag">BDT (৳)</span>
    </div>
    <% if (dashboard.salesTrend.every(row => Number(row.revenue) === 0)) { %>
      <div class="analytics-empty"><span>▥</span><strong>No sales recorded in this period</strong><p>Try a different date range to view sales activity.</p></div>
    <% } else { %>
      <div class="analytics-chart" role="img" aria-label="Daily sales bar chart">
        <% dashboard.salesTrend.forEach((point, index) => { %>
          <div class="analytics-chart-column" title="<%= point.day %>: ৳<%= money(point.revenue) %>; <%= point.ordersCount %> orders">
            <span class="analytics-bar-value"><%= Number(point.revenue) > 0 ? money(point.revenue) : '' %></span>
            <div class="analytics-bar-track"><div class="analytics-bar" style="height:<%= Math.max(Number(point.revenue) > 0 ? 4 : 0, (Number(point.revenue) / dashboard.maxTrendRevenue) * 100) %>%"></div></div>
            <% if (dashboard.salesTrend.length <= 14 || index === 0 || index === dashboard.salesTrend.length - 1 || index % Math.ceil(dashboard.salesTrend.length / 7) === 0) { %><span class="analytics-chart-label"><%= point.day.slice(5) %></span><% } else { %><span class="analytics-chart-label analytics-chart-label-hidden">.</span><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
    <div class="analytics-chart-legend"><span class="analytics-legend-dot"></span> Sales revenue <span class="analytics-legend-note">Cancelled orders excluded</span></div>
  </article>

  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Order status</h2><p>Orders created during this period</p></div></div>
    <% if (dashboard.statusRows.length === 0) { %><div class="analytics-small-empty">No orders in this period.</div><% } else { %>
      <div class="analytics-status-list">
        <% dashboard.statusRows.forEach(item => { %>
          <div class="analytics-status-row"><span class="analytics-status-dot status-<%= String(item.status || 'other').toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"></span><span class="analytics-status-name"><%= item.status || 'Unknown' %></span><strong><%= Number(item.count).toLocaleString() %></strong></div>
        <% }) %>
      </div>
    <% } %>
    <div class="analytics-total-orders"><span>All-time orders</span><strong><%= Number(totalOrders || 0).toLocaleString() %></strong></div>
  </article>
</section>

<section class="analytics-lower-grid">
  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Top-selling products</h2><p>Ranked by units sold in this period</p></div><a href="/admin/reports">Reports →</a></div>
    <% if (dashboard.topProducts.length === 0) { %><div class="analytics-small-empty">No product sales in this period.</div><% } else { %>
      <div class="table-responsive"><table class="admin-table analytics-table"><thead><tr><th>Product</th><th>Units sold</th><th>Revenue</th></tr></thead><tbody>
      <% dashboard.topProducts.forEach((product, index) => { %><tr><td><span class="analytics-rank"><%= index + 1 %></span><strong><%= product.product_name %></strong></td><td><%= Number(product.unitsSold || 0).toLocaleString() %></td><td>৳<%= money(product.productRevenue) %></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </article>
  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Inventory alerts</h2><p>Keep best sellers available</p></div><a href="/admin/inventory">Manage →</a></div>
    <div class="analytics-inventory-summary">
      <div class="analytics-inventory-stat"><span class="inventory-icon inventory-low">!</span><div><strong><%= Number(lowStockCount || 0) %></strong><span>Low stock</span></div></div>
      <div class="analytics-inventory-stat"><span class="inventory-icon inventory-out">×</span><div><strong><%= Number(outOfStockCount || 0) %></strong><span>Out of stock</span></div></div>
    </div>
    <% if (lowStockProducts.length > 0) { %><div class="analytics-low-stock-list"><% lowStockProducts.slice(0, 5).forEach(product => { %><div><span><%= product.name %></span><strong class="<%= Number(product.stock) === 0 ? 'stock-zero' : 'stock-low' %>"><%= Number(product.stock) %> left</strong></div><% }) %></div><% } else { %><div class="analytics-small-empty">No low-stock products. Inventory looks good.</div><% } %>
  </article>
</section>

<section class="analytics-panel analytics-pending-panel">
  <div class="analytics-panel-heading"><div><h2>Recent pending orders</h2><p>Orders that may need your attention</p></div><a href="/admin/orders">View all orders →</a></div>
  <% if (pendingOrders.length === 0) { %><div class="analytics-small-empty">No pending orders right now.</div><% } else { %>
    <div class="table-responsive"><table class="admin-table analytics-table"><thead><tr><th>Order</th><th>Customer</th><th>Phone</th><th>Total</th><th>Date</th><th></th></tr></thead><tbody>
      <% pendingOrders.forEach(o => { %><tr><td><strong>#<%= o.id %></strong></td><td><%= o.customer_name %></td><td><%= o.phone %></td><td>৳<%= money(o.total_amount) %></td><td><%= new Date(o.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td><td><a class="analytics-view-link" href="/admin/orders/<%= o.id %>">View order</a></td></tr><% }) %>
    </tbody></table></div>
  <% } %>
</section>

<% const _activity = (typeof recentActivity !== 'undefined' && recentActivity) || []; %>
<% const _phoneQueue = (typeof phoneQueue !== 'undefined' && phoneQueue) || []; %>
<% const _phoneQueueTotal = Number((typeof phoneQueueTotal !== 'undefined' && phoneQueueTotal) || 0); %>
<% const _catSales = (typeof dashboardCategorySales !== 'undefined' && dashboardCategorySales) || []; %>
<% const _topCustomers = (typeof topCustomers !== 'undefined' && topCustomers) || []; %>
<% const _shipped = (typeof shippedOrders !== 'undefined' && shippedOrders) || []; %>
<% const _shippedTotal = Number((typeof shippedTotal !== 'undefined' && shippedTotal) || 0); %>
<% const fmtDate = (d) => { try { return new Date(d).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); } catch (e) { return ''; } }; %>

<section class="analytics-lower-grid">
  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Recent activity</h2><p>Latest orders and status changes — live</p></div></div>
    <% if (_activity.length === 0) { %><div class="analytics-small-empty">No recent activity yet.</div><% } else { %>
    <div class="analytics-activity-list">
      <% _activity.forEach(a => { %>
      <div class="analytics-activity-row">
        <span class="analytics-activity-icon"><%= a.kind === 'status' ? '↻' : '🛒' %></span>
        <div><strong><%= a.text %></strong><span><%= fmtDate(a.when) %></span></div>
        <a class="analytics-view-link" href="/admin/orders/<%= a.orderId %>">View →</a>
      </div>
      <% }) %>
    </div>
    <% } %>
  </article>
  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Phone confirmation queue</h2><p>Open orders waiting for a confirmation call — oldest first</p></div><a href="/admin/orders">View all orders →</a></div>
    <% if (_phoneQueue.length === 0) { %><div class="analytics-small-empty">All open orders are phone-confirmed.</div><% } else { %>
    <p class="analytics-phone-note"><%= _phoneQueueTotal %> order(s) waiting for a call</p>
    <div class="table-responsive"><table class="admin-table analytics-table"><thead><tr><th>Order</th><th>Customer</th><th>Phone</th><th>Total</th><th>Date</th><th></th></tr></thead><tbody>
      <% _phoneQueue.forEach(o => { %><tr><td><strong>#<%= o.id %></strong></td><td><%= o.customer_name %></td><td><a href="tel:<%= o.phone %>"><%= o.phone %></a> <a class="analytics-view-link" href="tel:<%= o.phone %>">📞 Call</a></td><td>৳<%= money(o.total_amount) %></td><td><%= fmtDate(o.created_at) %></td><td><a class="analytics-view-link" href="/admin/orders/<%= o.id %>">View order</a></td></tr><% }) %>
    </tbody></table></div>
    <% } %>
  </article>
</section>

<section class="analytics-lower-grid">
  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Sales by category</h2><p>Revenue in the selected period — top-level categories including sub-categories</p></div><a href="/admin/reports">Reports →</a></div>
    <% if (_catSales.length === 0) { %><div class="analytics-small-empty">No category sales in this period.</div><% } else { %>
    <% const _maxCat = Math.max(1, ..._catSales.map(c => Number(c.revenue || 0))); %>
    <div class="analytics-catbar-list">
      <% _catSales.forEach(c => { %>
      <div class="analytics-catbar-row" title="<%= c.name %>: ৳<%= money(c.revenue) %> · <%= Number(c.orders || 0) %> order(s)">
        <span class="analytics-catbar-name"><%= c.name %></span>
        <div class="analytics-catbar-track"><div class="analytics-catbar" style="width:<%= Math.max(Number(c.revenue) > 0 ? 4 : 0, (Number(c.revenue) / _maxCat) * 100) %>%"></div></div>
        <strong class="analytics-catbar-value">৳<%= money(c.revenue) %></strong>
      </div>
      <% }) %>
    </div>
    <% } %>
  </article>
  <article class="analytics-panel">
    <div class="analytics-panel-heading"><div><h2>Top customers</h2><p>By total spent in the selected period</p></div><a href="/admin/customers">Customers →</a></div>
    <% if (_topCustomers.length === 0) { %><div class="analytics-small-empty">No customer orders in this period.</div><% } else { %>
    <div class="table-responsive"><table class="admin-table analytics-table"><thead><tr><th>#</th><th>Customer</th><th>Orders</th><th>Total spent</th></tr></thead><tbody>
      <% _topCustomers.forEach((c, i) => { %><tr><td><span class="analytics-rank"><%= i + 1 %></span></td><td><% if (c.user_id) { %><a class="analytics-view-link" href="/admin/customers/<%= c.user_id %>"><strong><%= c.customer_name %></strong></a><% } else { %><strong><%= c.customer_name %></strong><% } %><br><span class="analytics-sub"><%= c.phone %></span></td><td><%= Number(c.orderCount || 0) %></td><td>৳<%= money(c.totalSpent) %></td></tr><% }) %>
    </tbody></table></div>
    <% } %>
  </article>
</section>

<section class="analytics-panel analytics-pending-panel">
  <div class="analytics-panel-heading"><div><h2>Shipped — not delivered yet</h2><p>Orders out for delivery — oldest shipped first</p></div><a href="/admin/orders">View all orders →</a></div>
  <% if (_shipped.length === 0) { %><div class="analytics-small-empty">No orders are waiting for delivery.</div><% } else { %>
  <p class="analytics-phone-note"><%= _shippedTotal %> order(s) shipped and awaiting delivery</p>
  <div class="table-responsive"><table class="admin-table analytics-table"><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Courier / Tracking</th><th>Waiting</th><th></th></tr></thead><tbody>
    <% _shipped.forEach(o => { %><tr><td><strong>#<%= o.id %></strong></td><td><%= o.customer_name %><br><span class="analytics-sub"><%= o.phone %></span></td><td>৳<%= money(o.total_amount) %></td><td><%= o.courier_name || '—' %><% if (o.tracking_number) { %><br><span class="analytics-sub"><%= o.tracking_number %></span><% } %></td><td><%= Number(o.daysSinceShipped || 0) %> day(s)</td><td><a class="analytics-view-link" href="/admin/orders/<%= o.id %>">View order</a></td></tr><% }) %>
  </tbody></table></div>
  <% } %>
</section>

<%- include('../partials/admin-footer') %>
