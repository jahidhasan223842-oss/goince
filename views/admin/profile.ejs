<%- include('../partials/admin-header') %>

<% const _name = (typeof adminName !== 'undefined' && adminName) ? String(adminName) : 'Admin'; %>
<% const _email = (typeof adminEmail !== 'undefined' && adminEmail) ? String(adminEmail) : ''; %>
<% const _role = (typeof adminRoleLabel !== 'undefined' && adminRoleLabel) ? String(adminRoleLabel) : 'Owner'; %>
<% const _initial = _name.charAt(0).toUpperCase(); %>
<% const _since = (typeof memberSince !== 'undefined' && memberSince) ? memberSince : null; %>
<% const _photo = (typeof photoUrl !== 'undefined' && photoUrl) ? String(photoUrl) : null; %>
<% const _phone = (typeof phone !== 'undefined' && phone) ? String(phone) : ''; %>
<% const _emailOk = (typeof emailConfigured !== 'undefined' && emailConfigured); %>

<h1>My Profile</h1>
<p class="field-hint">Your admin account — photo, sign-in details, password and recovery.</p>

<% if (typeof pwMessage !== 'undefined' && pwMessage) { %><p class="<%= (typeof pwOk !== 'undefined' && pwOk) ? 'success-msg' : 'error-msg' %>" style="text-align:left;"><%= pwMessage %></p><% } %>
<% if (typeof profileMessage !== 'undefined' && profileMessage) { %><p class="<%= (typeof profileOk !== 'undefined' && profileOk) ? 'success-msg' : 'error-msg' %>" style="text-align:left;"><%= profileMessage %></p><% } %>

<div class="admin-profile-page">
<div class="admin-profile-card">
  <div class="admin-profile-overview">
    <% if (_photo) { %><span class="admin-user-avatar admin-profile-avatar" aria-hidden="true"><img src="<%= _photo %>" alt=""></span><% } else { %><span class="admin-user-avatar admin-profile-avatar" aria-hidden="true"><%= _initial %></span><% } %>
    <div class="admin-profile-details">
      <h2 class="admin-profile-name"><%= _name %></h2>
      <div class="admin-profile-field"><span class="admin-profile-label">Email</span><span><%= _email %></span></div>
      <% if (_phone) { %><div class="admin-profile-field"><span class="admin-profile-label">Phone</span><span><%= _phone %></span></div><% } %>
      <div class="admin-profile-field"><span class="admin-profile-label">Role</span><span class="admin-profile-role-badge"><%= _role %></span></div>
      <% if (_since) { %><div class="admin-profile-field"><span class="admin-profile-label">Member since</span><span><%= _since %></span></div><% } %>
    </div>
  </div>
  <p class="field-hint" style="margin-bottom:0;">Your email is the address you sign in with — change it in the Change Email section below.</p>
</div>

<div class="admin-profile-card" id="profile-photo">
  <h2>📷 Profile Photo</h2>
  <p class="field-hint">Recommended: square photo, at least 256 × 256 px. The photo is saved as a 256 × 256 square and shown next to your name in the top bar.</p>
  <div class="admin-photo-current">
    <% if (_photo) { %><img src="<%= _photo %>" alt="Current profile photo" class="admin-photo-current-img"><% } else { %><span class="admin-user-avatar admin-profile-avatar" aria-hidden="true"><%= _initial %></span><% } %>
    <div>
      <p class="field-hint" style="margin:0 0 8px;"><%= _photo ? 'Your current photo.' : 'No photo yet — your initial is shown instead.' %></p>
      <% if (_photo) { %>
      <form action="/admin/profile/photo/remove" method="POST" style="display:inline;"><%- include('../partials/csrf-field') %><button type="submit" class="btn-secondary">Remove photo</button></form>
      <% } %>
    </div>
  </div>
  <form action="/admin/profile/photo<%- typeof csrfToken !== 'undefined' && csrfToken ? '?_csrf=' + csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="admin-form admin-form--wide" id="admin-photo-form"><%- include('../partials/csrf-field') %>
    <input type="file" id="admin-photo-file" name="photo" accept="image/jpeg,image/png,image/webp" required>
    <label class="admin-photo-choose" for="admin-photo-file">Choose photo</label>
    <p class="error-msg" id="admin-photo-error" hidden style="text-align:left;"></p>
    <div id="admin-photo-crop-wrap" hidden>
      <p class="field-hint">Drag the square to choose which part of the photo to keep — use the slider to zoom in. The circle shows how it will look.</p>
      <div class="admin-photo-crop-row">
        <div class="admin-photo-crop-stage" id="admin-photo-crop-stage">
          <img id="admin-photo-crop-img" alt="Photo to crop" draggable="false">
          <div class="admin-photo-crop-box" id="admin-photo-crop-box" role="button" tabindex="0" aria-label="Crop area — drag to move"><span class="admin-photo-crop-handle" id="admin-photo-crop-handle" aria-hidden="true"></span></div>
        </div>
        <div class="admin-photo-crop-side">
          <div class="admin-photo-crop-preview" id="admin-photo-crop-preview" aria-label="Cropped photo preview"></div>
          <label for="admin-photo-crop-zoom">Zoom</label>
          <input type="range" id="admin-photo-crop-zoom" min="1" max="3" step="0.05" value="1">
        </div>
      </div>
      <input type="hidden" id="admin-photo-crop-x" name="crop_x" value="">
      <input type="hidden" id="admin-photo-crop-y" name="crop_y" value="">
      <input type="hidden" id="admin-photo-crop-size" name="crop_size" value="">
    </div>
    <button type="submit" class="btn-primary" id="admin-photo-save-btn" disabled>Save photo</button>
  </form>
</div>

<div class="admin-profile-card" id="profile-details">
  <h2>👤 Profile Details</h2>
  <p class="field-hint">The name shown in the top bar and your contact number. Leave the phone blank if you do not want to share it.</p>
  <form action="/admin/profile/details" method="POST" class="admin-form admin-form--wide"><%- include('../partials/csrf-field') %>
    <label>Display Name</label>
    <input type="text" name="display_name" value="<%= _name %>" maxlength="60" required autocomplete="name">
    <label>Phone Number (optional)</label>
    <input type="tel" name="phone" value="<%= _phone %>" placeholder="01XXXXXXXXX" autocomplete="tel">
    <button type="submit" class="btn-primary">Save Details</button>
  </form>
</div>

<div class="admin-profile-card" id="change-email">
  <h2>✉️ Change Email</h2>
  <p class="field-hint">Change the email address you sign in with. Your current password is required, and the new address must not belong to another admin.</p>
  <form action="/admin/profile/email" method="POST" class="admin-form admin-form--wide"><%- include('../partials/csrf-field') %>
    <label>New Email</label>
    <input type="email" name="new_email" required autocomplete="email" placeholder="new-email@example.com">
    <label>Confirm New Email</label>
    <input type="email" name="confirm_new_email" required autocomplete="email" placeholder="new-email@example.com">
    <label>Current Password</label>
    <input type="password" name="current_password" required autocomplete="current-password">
    <button type="submit" class="btn-primary">Change Email</button>
  </form>
</div>

<div class="admin-profile-card" id="change-password">
  <h2>🔑 Change Password</h2>
  <p class="field-hint">Change the password you use to sign in to the admin panel.</p>
  <form action="/admin/settings/change-password" method="POST" class="admin-form admin-form--wide"><%- include('../partials/csrf-field') %>
    <input type="hidden" name="return_to" value="/admin/profile">
    <label>Current Password</label>
    <input type="password" name="current_password" required autocomplete="current-password">
    <label>New Password (at least 6 characters)</label>
    <input type="password" name="new_password" required autocomplete="new-password">
    <label>Confirm New Password</label>
    <input type="password" name="confirm_password" required autocomplete="new-password">
    <button type="submit" class="btn-primary">Change Password</button>
  </form>
</div>

<div class="admin-profile-card" id="forgot-password">
  <h2>✉️ Forgot Password</h2>
  <p class="field-hint">Forgot your password? Request a reset link for your admin email — it is valid for 1 hour.</p>
  <% if (_emailOk) { %>
    <p>A reset link will be emailed to the address you enter on the next page.</p>
  <% } else { %>
    <p>Email is not set up on the server yet, so the reset link will be shown on screen after you submit the form instead of being emailed.</p>
  <% } %>
  <a href="/admin/forgot-password" class="btn-secondary" style="text-decoration:none;">Request a reset link</a>
</div>
</div>

<script>
  // Profile photo cropper (fix/admin-profile-photo): vanilla JS, no library.
  // After a file is chosen, the photo is shown in a square stage with a
  // draggable square crop box (drag to move, drag the corner to resize)
  // and a zoom slider. Pointer Events cover mouse + touch. The crop is
  // sent as fractions of the photo's own size (crop_x, crop_y, crop_size);
  // the server clamps them and crops to a 256x256 WebP square. Without
  // JavaScript the form still works — the server takes a centred square.
  (function () {
    var fileInput = document.getElementById('admin-photo-file');
    var wrap = document.getElementById('admin-photo-crop-wrap');
    var stage = document.getElementById('admin-photo-crop-stage');
    var img = document.getElementById('admin-photo-crop-img');
    var box = document.getElementById('admin-photo-crop-box');
    var handle = document.getElementById('admin-photo-crop-handle');
    var zoom = document.getElementById('admin-photo-crop-zoom');
    var preview = document.getElementById('admin-photo-crop-preview');
    var fx = document.getElementById('admin-photo-crop-x');
    var fy = document.getElementById('admin-photo-crop-y');
    var fs = document.getElementById('admin-photo-crop-size');
    var saveBtn = document.getElementById('admin-photo-save-btn');
    var errEl = document.getElementById('admin-photo-error');
    if (!fileInput || !wrap) return;
    var state = null;
    function clamp(v, min, max) { return Math.max(min, Math.min(v, max)); }
    function layout() {
      if (!state) return;
      var S = stage.clientWidth;
      if (!S) return;
      var base = Math.min(S / state.nw, S / state.nh);
      state.iw = state.nw * base * state.z;
      state.ih = state.nh * base * state.z;
      state.ix = (S - state.iw) / 2;
      state.iy = (S - state.ih) / 2;
      var maxBs = Math.min(state.iw, state.ih);
      if (state.bs > maxBs) state.bs = maxBs;
      state.bx = clamp(state.bx, state.ix, state.ix + state.iw - state.bs);
      state.by = clamp(state.by, state.iy, state.iy + state.ih - state.bs);
      img.style.width = state.iw + 'px';
      img.style.height = state.ih + 'px';
      img.style.left = state.ix + 'px';
      img.style.top = state.iy + 'px';
      box.style.left = state.bx + 'px';
      box.style.top = state.by + 'px';
      box.style.width = state.bs + 'px';
      box.style.height = state.bs + 'px';
      var p = 64;
      var scale = p / state.bs;
      preview.style.backgroundImage = 'url(' + state.url + ')';
      preview.style.backgroundSize = (state.iw * scale) + 'px ' + (state.ih * scale) + 'px';
      preview.style.backgroundPosition = (-(state.bx - state.ix) * scale) + 'px ' + (-(state.by - state.iy) * scale) + 'px';
      fx.value = ((state.bx - state.ix) / state.iw).toFixed(4);
      fy.value = ((state.by - state.iy) / state.ih).toFixed(4);
      fs.value = (state.bs / Math.min(state.iw, state.ih)).toFixed(4);
    }
    function showError(msg) {
      errEl.textContent = msg;
      errEl.hidden = false;
    }
    fileInput.addEventListener('change', function () {
      var file = fileInput.files && fileInput.files[0];
      if (!file) return;
      errEl.hidden = true;
      if (!file.type || file.type.indexOf('image/') !== 0) { showError('Choose a photo file (jpg, png or webp).'); fileInput.value = ''; return; }
      if (file.size > 5 * 1024 * 1024) { showError('The photo must be up to 5 MB.'); fileInput.value = ''; return; }
      var reader = new FileReader();
      reader.onload = function (e) {
        var probe = new Image();
        probe.onload = function () {
          state = { url: e.target.result, nw: probe.naturalWidth, nh: probe.naturalHeight, z: 1, iw: 0, ih: 0, ix: 0, iy: 0, bx: 0, by: 0, bs: 0 };
          img.src = state.url;
          wrap.hidden = false;
          zoom.value = '1';
          saveBtn.disabled = false;
          requestAnimationFrame(function () {
            var S = stage.clientWidth;
            var base = Math.min(S / state.nw, S / state.nh);
            state.iw = state.nw * base;
            state.ih = state.nh * base;
            state.bs = Math.min(state.iw, state.ih);
            state.bx = (S - state.iw) / 2 + (state.iw - state.bs) / 2;
            state.by = (S - state.ih) / 2 + (state.ih - state.bs) / 2;
            layout();
          });
        };
        probe.onerror = function () { showError('That file could not be read as a photo — try another one.'); };
        probe.src = e.target.result;
      };
      reader.readAsDataURL(file);
    });
    zoom.addEventListener('input', function () {
      if (!state) return;
      state.z = parseFloat(zoom.value) || 1;
      layout();
    });
    function dragSetup(el, onMove, stopBubble) {
      el.addEventListener('pointerdown', function (e) {
        if (!state) return;
        // The resize handle sits inside the drag box — its pointerdown
        // must not bubble up and move the box at the same time.
        if (stopBubble) e.stopPropagation();
        e.preventDefault();
        el.setPointerCapture(e.pointerId);
        var startX = e.clientX;
        var startY = e.clientY;
        var start = { bx: state.bx, by: state.by, bs: state.bs };
        function move(ev) {
          onMove(ev.clientX - startX, ev.clientY - startY, start);
          layout();
        }
        function up() {
          el.removeEventListener('pointermove', move);
          el.removeEventListener('pointerup', up);
          el.removeEventListener('pointercancel', up);
        }
        el.addEventListener('pointermove', move);
        el.addEventListener('pointerup', up);
        el.addEventListener('pointercancel', up);
      });
    }
    // Drag the box to move it (stays inside the photo).
    dragSetup(box, function (dx, dy, start) {
      state.bx = clamp(start.bx + dx, state.ix, state.ix + state.iw - state.bs);
      state.by = clamp(start.by + dy, state.iy, state.iy + state.ih - state.bs);
    });
    // Drag the corner handle to resize the square (stays inside the photo).
    dragSetup(handle, function (dx, dy, start) {
      var next = clamp(start.bs + Math.max(dx, dy), 48, Math.min(state.iw, state.ih));
      state.bs = next;
      state.bx = clamp(start.bx, state.ix, state.ix + state.iw - state.bs);
      state.by = clamp(start.by, state.iy, state.iy + state.ih - state.bs);
    }, true);
    // Keyboard: arrow keys move the crop square (Shift = bigger steps).
    box.addEventListener('keydown', function (e) {
      if (!state) return;
      var step = e.shiftKey ? 16 : 4;
      var moved = true;
      if (e.key === 'ArrowLeft') state.bx = clamp(state.bx - step, state.ix, state.ix + state.iw - state.bs);
      else if (e.key === 'ArrowRight') state.bx = clamp(state.bx + step, state.ix, state.ix + state.iw - state.bs);
      else if (e.key === 'ArrowUp') state.by = clamp(state.by - step, state.iy, state.iy + state.ih - state.bs);
      else if (e.key === 'ArrowDown') state.by = clamp(state.by + step, state.iy, state.iy + state.ih - state.bs);
      else moved = false;
      if (moved) { e.preventDefault(); layout(); }
    });
    window.addEventListener('resize', layout);
  })();
</script>

<%- include('../partials/admin-footer') %>
