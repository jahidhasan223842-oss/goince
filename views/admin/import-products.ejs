<%- include('../partials/admin-header') %>

<h1>Import Products (CSV)</h1>
<p class="field-hint">Upload a CSV file to add many products at once. Columns (first row = header): <code>name, price, cost_price, stock, sku, brand, tags, category_id</code> — only <strong>name</strong> and <strong>price</strong> are required. <a href="/admin/products/export">Download the current products as CSV</a> to see the format.</p>

<form action="/admin/products/import<%- typeof csrfToken !== 'undefined' && csrfToken ? '?_csrf=' + csrfToken : '' %>" method="POST" enctype="multipart/form-data" class="admin-form"><%- include('../partials/csrf-field') %>
  <label>CSV File</label>
  <input type="file" name="csv" accept=".csv" required>
  <button type="submit" class="btn-primary">Import Products</button>
</form>

<% if (result) { %>
  <div style="margin-top:20px;">
    <p><strong><%= result.added %> products added</strong>, <%= result.skipped %> rows skipped.</p>
    <% if (result.errors && result.errors.length) { %>
      <ul><% result.errors.forEach(e => { %><li style="color:#d62839;"><%= e %></li><% }) %></ul>
    <% } %>
    <p><a href="/admin/products">← Back to Products</a></p>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
