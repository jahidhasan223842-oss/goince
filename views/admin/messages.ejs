<%- include('../partials/admin-header') %>

<% const _filter = (typeof statusFilter !== 'undefined' && statusFilter) ? statusFilter : 'all'; %>
<% const _counts = (typeof statusCounts !== 'undefined' && statusCounts) || { open: 0, answered: 0, closed: 0 }; %>
<% const _total = (typeof total !== 'undefined' && total) || messages.length; %>
<% const _statusBadge = (s) => (s || 'open') === 'open' ? 'status-pending' : (s === 'closed' ? 'status-cancelled' : 'status-delivered'); %>

<h1>Contact Messages</h1>
<p class="field-hint">Messages sent from the website's Contact form — handled like support tickets. <strong><%= unread %> new / unread.</strong></p>

<!-- Ticket-style status filter (fix/whmcs-style-admin). -->
<nav class="admin-tabs" aria-label="Filter messages by status">
  <a class="admin-tab <%= _filter === 'all' ? 'is-active' : '' %>" href="/admin/messages">All (<%= _total %>)</a>
  <a class="admin-tab <%= _filter === 'open' ? 'is-active' : '' %>" href="/admin/messages?status=open">Open (<%= Number(_counts.open || 0) %>)</a>
  <a class="admin-tab <%= _filter === 'answered' ? 'is-active' : '' %>" href="/admin/messages?status=answered">Answered (<%= Number(_counts.answered || 0) %>)</a>
  <a class="admin-tab <%= _filter === 'closed' ? 'is-active' : '' %>" href="/admin/messages?status=closed">Closed (<%= Number(_counts.closed || 0) %>)</a>
</nav>

<% if (messages.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">✉️</span>
    <strong>No messages yet</strong>
    <p>Messages from the website's Contact form will appear here as tickets.</p>
    <a href="/contact" target="_blank" rel="noopener" class="btn-primary">Open the contact form</a>
  </div>
<% } else { %>
<div class="table-responsive">
<table class="admin-table">
  <thead><tr><th>Date</th><th>Name</th><th>Phone / Email</th><th>Subject</th><th>Message</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% messages.forEach(m => { %>
      <tr style="<%= m.is_read ? '' : 'font-weight:600;' %>">
        <td><%= new Date(m.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
        <td><%= m.name %></td>
        <td><%= m.phone || '' %><br><%= m.email || '' %></td>
        <td><%= m.subject || '-' %></td>
        <td><%= m.message %></td>
        <td><span class="status-badge <%= _statusBadge(m.status) %>"><%= m.status || 'open' %></span></td>
        <td style="white-space:nowrap;">
          <div class="admin-actions">
            <a href="/admin/messages/<%= m.id %>" class="btn-sm btn-sm--primary">View</a>
            <% if (!m.is_read) { %><form action="/admin/messages/<%= m.id %>/read" method="POST" style="display:inline;"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm">Mark read</button></form><% } %>
            <form action="/admin/messages/<%= m.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete this message?');"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--danger">Delete</button></form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>

<%- include('../partials/admin-footer') %>
