<% /*
  One category row — used by the recursive tree view and by the flat
  search/filter results. Locals:
    cat          — category node from lib/categories (children, depth,
                   descendantIds, totalProductCount, directProductCount)
    depth        — nesting depth (0 = main category)
    isFirst      — true when first in its group (▲ disabled)
    isLast       — true when last in its group (▼ disabled)
    chevronId    — category id when it has children (renders the ▼/▶
                   dropdown button), null otherwise
  Hidden categories are dimmed and carry a "Hidden from website" badge.
  The bulk checkbox is a plain input (not inside any form) — the bulk
  bar's script collects the checked ids on submit, because HTML does not
  allow forms nested inside the row's own toggle/move/delete forms.
*/ %>
<% const totalSubs = (cat.descendantIds || []).length; %>
<% const totalProducts = (typeof cat.totalProductCount !== 'undefined' ? cat.totalProductCount : cat.product_count); %>
<% const directProducts = (typeof cat.directProductCount !== 'undefined' ? cat.directProductCount : cat.product_count); %>
<div class="cat-row <%= !cat.parent_id ? 'cat-main-row' : 'cat-sub-row' %> <%= cat.is_visible === 0 ? 'cat-hidden' : '' %>" id="cat-<%= cat.id %>" data-cat-id="<%= cat.id %>" data-parent-id="<%= cat.parent_id || '' %>">
  <input type="checkbox" class="cat-check" value="<%= cat.id %>" title="Select for bulk action" aria-label="Select <%= cat.name %>">
  <% if (typeof draggable !== 'undefined' && draggable) { %><span class="cat-drag" draggable="true" data-cat-drag="<%= cat.id %>" title="Drag to reorder among its siblings">⠿</span><% } %>
  <% if (chevronId) { %>
    <button type="button" class="cat-chevron" data-cat-toggle="<%= chevronId %>" aria-expanded="true" title="Show/hide sub-categories">▼</button>
  <% } %>
  <span class="cat-thumb-wrap"><% if (cat.image_url) { %><img src="<%= cat.image_url %>" class="admin-thumb" onerror="this.src='/uploads/no-image.png'"><% } else { %>-<% } %></span>
  <div class="cat-info">
    <strong><%= cat.name %></strong>
    <% if (!cat.parent_id) { %> <span class="badge badge-main" title="Main category">Main</span><% } else { %> <span class="badge badge-sub" title="Sub-category of <%= cat.parent_name %>">Sub-category</span><% } %>
    <% if (cat.is_featured) { %> <span title="Featured on homepage">⭐</span><% } %>
    <% if (cat.banner_url) { %> <span title="Has a banner image">🖼️</span><% } %>
    <% if (cat.is_visible === 0) { %> <span class="badge badge-hidden" title="Not shown on the website">Hidden from website</span><% } %>
    <% if (depth > 0 && cat.parent_name) { %><br><small><%= cat.parent_name %> › <%= cat.name %></small><% } %>
    <% if (cat.description) { %><br><small><%= cat.description %></small><% } %>
  </div>
  <span class="cat-counts">
    <a href="/admin/products?category=<%= cat.id %>" title="<%= directProducts %> directly in this category, <%= totalProducts %> including sub-categories"><%= totalProducts %> product<%= totalProducts == 1 ? '' : 's' %></a><% if (totalSubs > 0) { %> · <%= totalSubs %> sub-categor<%= totalSubs == 1 ? 'y' : 'ies' %><% } %>
  </span>
  <span class="cat-actions">
    <form action="/admin/categories/<%= cat.id %>/toggle-visibility" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm" title="<%= cat.is_visible ? 'Hide this category from the website (products stay safe, nothing is deleted)' : 'Show this category on the website again' %>"><%= cat.is_visible ? '👁️ Shown — Hide' : '🙈 Hidden — Show' %></button></form>
    <form action="/admin/categories/<%= cat.id %>/move" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><input type="hidden" name="direction" value="up"><button type="submit" class="btn-sm" title="Move up" <%= isFirst ? 'disabled' : '' %>>▲</button></form>
    <form action="/admin/categories/<%= cat.id %>/move" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><input type="hidden" name="direction" value="down"><button type="submit" class="btn-sm" title="Move down" <%= isLast ? 'disabled' : '' %>>▼</button></form>
    <span class="cat-order">Order: <%= cat.sort_order %></span>
    <a href="/admin/categories?parent=<%= cat.id %>#add-category" class="btn-sm">＋ Sub-category</a>
    <a href="/?category=<%= cat.id %>" target="_blank" rel="noopener" class="btn-sm" title="See this category on the website">View ↗</a>
    <a href="/admin/categories/edit/<%= cat.id %>" class="btn-sm btn-sm--primary">Edit</a>
    <form action="/admin/categories/delete/<%= cat.id %>" method="POST" style="display:inline" onsubmit="return confirm('<%= totalSubs > 0 ? ('Delete this category? Its ' + totalSubs + ' sub-categories (all levels) will also be deleted, and ' + totalProducts + ' product(s) will become Uncategorized. This cannot be undone.') : ('Delete this category? Its ' + totalProducts + ' product(s) will become Uncategorized. This cannot be undone.') %>');"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--danger">Delete</button></form>
  </span>
</div>
