<%- include('../partials/admin-header') %>

<h1>Delivery Zones</h1>
<p class="field-hint">At checkout, customers choose one of these zones — each zone has its own delivery charge. You can add a new zone here (e.g. Chittagong, Sylhet, or any other area). Zones that are turned off will not appear at checkout.</p>

<form action="/admin/delivery-zones/add" method="POST" class="admin-form admin-form--wide"><%- include('../partials/csrf-field') %>
  <label>Zone Name</label>
  <input type="text" name="name" placeholder="e.g. Chittagong" required>
  <label>Delivery Charge (৳)</label>
  <input type="number" step="0.01" min="0" name="charge" placeholder="150" required>
  <label>Delivery Time</label>
  <input type="text" name="delivery_time" placeholder="e.g. 3-5 days">
  <button type="submit" class="btn-primary">Add Zone</button>
</form>

<h2 style="margin-top:30px;">All Zones</h2>
<div class="table-responsive">
<table class="admin-table">
  <thead><tr><th>Zone</th><th>Charge</th><th>Delivery Time</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
    <% zones.forEach(z => { %>
      <tr>
        <td>
          <form id="zone-form-<%= z.id %>" action="/admin/delivery-zones/edit/<%= z.id %>" method="POST"><%- include('../partials/csrf-field') %></form>
          <input type="text" name="name" value="<%= z.name %>" form="zone-form-<%= z.id %>" style="width:130px; padding:6px; border:1px solid #ccc; border-radius:4px;">
        </td>
        <td>৳ <input type="number" step="0.01" min="0" name="charge" value="<%= z.charge %>" form="zone-form-<%= z.id %>" style="width:90px; padding:6px; border:1px solid #ccc; border-radius:4px;"></td>
        <td><input type="text" name="delivery_time" value="<%= z.delivery_time || '' %>" form="zone-form-<%= z.id %>" placeholder="1–2 days" style="width:90px; padding:6px; border:1px solid #ccc; border-radius:4px;"></td>
        <td><span class="status-badge <%= z.is_active ? 'status-delivered' : 'status-inactive' %>"><%= z.is_active ? 'Active' : 'Inactive' %></span></td>
        <td style="white-space:nowrap;">
          <div class="admin-actions">
            <button type="submit" form="zone-form-<%= z.id %>" class="btn-sm btn-sm--primary">Save</button>
            <form action="/admin/delivery-zones/toggle/<%= z.id %>" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm"><%= z.is_active ? 'Deactivate' : 'Activate' %></button></form>
            <form action="/admin/delivery-zones/delete/<%= z.id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete this zone?');"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--danger">Delete</button></form>
          </div>
        </td>
      </tr>
    <% }) %>
    <% if (zones.length === 0) { %><tr><td colspan="5" style="text-align:center; color:var(--text-muted);">No zones yet. Add one above.</td></tr><% } %>
  </tbody>
</table>
</div>


<h2 style="margin-top:40px;">⚖️ Weight-Based Delivery Bands</h2>
<p class="field-hint">When a cart's total weight fits a band, that band's charge replaces the zone charge at checkout. The lightest matching band wins; if no band matches, the normal zone charge (Inside Dhaka ৳60 / Outside Dhaka ৳120, or the zone's own charge) applies unchanged. A band with no zone applies to every zone.</p>

<form action="/admin/delivery-zones/weight-bands/add" method="POST" class="admin-form admin-form--wide"><%- include('../partials/csrf-field') %>
  <label>Zone (optional — leave blank for all zones)</label>
  <select name="zone_slug">
    <option value="">All zones</option>
    <% zones.forEach(z => { %><option value="<%= z.slug %>"><%= z.name %></option><% }) %>
  </select>
  <label>Up to this weight (kg) — e.g. 2 means carts up to 2 kg</label>
  <input type="number" name="max_weight_kg" min="0.01" step="0.01" placeholder="e.g. 2" required>
  <label>Delivery charge for this band (৳)</label>
  <input type="number" name="charge" min="0" step="0.01" placeholder="e.g. 80" required>
  <button type="submit" class="btn-primary">Add Weight Band</button>
</form>

<% const _bands = (typeof bands !== 'undefined' && bands) ? bands : []; %>
<% if (_bands.length) { %>
<div class="table-responsive" style="margin-top:16px;">
<table class="admin-table">
  <thead><tr><th>Zone</th><th>Up to</th><th>Charge</th><th>Status</th><th>Actions</th></tr></thead>
  <tbody>
    <% _bands.forEach(b => { %>
      <tr>
        <td><%= b.zone_slug || 'All zones' %></td>
        <td><%= b.max_weight_kg %> kg</td>
        <td>৳<%= b.charge %></td>
        <td><span class="status-badge <%= b.is_active ? 'status-delivered' : 'status-inactive' %>"><%= b.is_active ? 'Active' : 'Inactive' %></span></td>
        <td>
          <div class="admin-actions">
            <form action="/admin/delivery-zones/weight-bands/toggle/<%= b.id %>" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm"><%= b.is_active ? 'Deactivate' : 'Activate' %></button></form>
            <form action="/admin/delivery-zones/weight-bands/delete/<%= b.id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete this weight band?');"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--danger">Delete</button></form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } else { %>
<p class="field-hint">No weight bands yet — delivery always uses the zone charge.</p>
<% } %>

<%- include('../partials/admin-footer') %>
