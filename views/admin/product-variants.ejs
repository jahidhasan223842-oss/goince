<%- include('../partials/admin-header') %>

<div class="admin-page-header">
  <h1>Variants — <%= product.name %></h1>
  <a href="/admin/products">&larr; Back to Products</a>
</div>

<% if (attributes.length === 0) { %>
  <p style="color:#666;">Ekhono kono Attribute (Size/Color) toiri kora hoyni. Age <a href="/admin/attributes">Attributes</a> page theke Attribute ar Value banao, tarpor ekhane esho.</p>
<% } else { %>

  <div class="invoice-box" style="margin-bottom:24px;">
    <p style="color:#666; margin-bottom:16px;">যেই যেই Color/Size এই product-এ পাওয়া যাবে, শুধু সেগুলোতে টিক দিয়ে নিচের <strong>Save</strong> বাটনে ক্লিক করো — সাথে সাথে ওয়েবসাইটে দেখাবে। টিক তুলে দিয়ে আবার Save করলে ওটা ওয়েবসাইট থেকে সরে যাবে।</p>

    <form action="/admin/products/<%= product.id %>/variants/sync" method="POST">
      <div style="display:flex; gap:30px; flex-wrap:wrap;">
        <% attributes.forEach(attr => { %>
          <div>
            <label style="font-weight:600; display:block; margin-bottom:8px;"><%= attr.name %></label>
            <% if (attr.values.length === 0) { %>
              <p style="color:#999; font-size:13px;">Kono Value nei.</p>
            <% } %>
            <% attr.values.forEach(v => { %>
              <label style="display:flex; align-items:center; gap:6px; font-weight:normal; margin-bottom:6px;">
                <input type="checkbox" name="attr_<%= attr.id %>" value="<%= v.id %>" <%= selectedValueIds.has(v.id) ? 'checked' : '' %>>
                <%= v.value %>
              </label>
            <% }) %>
          </div>
        <% }) %>
      </div>
      <button type="submit" class="btn-primary" style="margin-top:16px;">Save</button>
    </form>
  </div>

  <% if (variants.length > 0) { %>
    <h2>এখন যা যা ওয়েবসাইটে দেখাচ্ছে</h2>
    <p style="color:#666; margin-bottom:14px;">প্রতিটার Stock (আর চাইলে আলাদা Price) এখান থেকে ঠিক করে নাও — খালি রাখলে product-এর নিজের দাম ব্যবহার হবে।</p>
    <div class="table-responsive">
    <table class="admin-table">
      <thead>
        <tr><th>Combination</th><th>Stock / Price</th><th></th></tr>
      </thead>
      <tbody>
        <% variants.forEach(v => { %>
          <tr>
            <td><%= v.label || '-' %></td>
            <td>
              <form action="/admin/products/<%= product.id %>/variants/<%= v.id %>/update" method="POST" style="display:flex; gap:8px; align-items:center;">
                <input type="number" name="stock" value="<%= v.stock %>" min="0" style="width:80px; padding:6px; border:1px solid #ccc; border-radius:4px;">
                <input type="number" step="0.01" name="price" value="<%= v.price !== null ? v.price : '' %>" placeholder="৳ base price" style="width:110px; padding:6px; border:1px solid #ccc; border-radius:4px;">
                <button type="submit" class="btn-primary" style="padding:6px 14px;">Save</button>
              </form>
            </td>
            <td>
              <form action="/admin/products/<%= product.id %>/variants/delete/<%= v.id %>" method="POST" onsubmit="return confirm('Ei combination remove korte chao? (Checkbox theke tick tule dile-o eta hobe)');">
                <button type="submit" class="link-btn-danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
<% } %>

<%- include('../partials/admin-footer') %>
