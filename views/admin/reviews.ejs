<%- include('../partials/admin-header') %>

<div class="admin-page-header">
  <h1>Reviews <% if (pending > 0) { %><span class="status-badge status-pending"><%= pending %> pending</span><% } %></h1>
</div>

<form method="GET" action="/admin/reviews" class="admin-search-form">
  <select name="status">
    <option value="">All Reviews</option>
    <% ['pending','approved','hidden'].forEach(s => { %>
      <option value="<%= s %>" <%= (status || '') === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn-primary">Filter</button>
  <% if (status) { %> <a href="/admin/reviews">Clear</a> <% } %>
</form>

<% if (reviews.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">⭐</span>
    <strong>No reviews found</strong>
    <p>New customer reviews will appear here for approval.</p>
  </div>
<% } else { %>
<div class="table-responsive">
<table class="admin-table">
  <thead>
    <tr><th>Product</th><th>Customer</th><th>Rating</th><th>Review</th><th>Date</th><th>Status</th><th>Actions</th></tr>
  </thead>
  <tbody>
    <% reviews.forEach(r => { %>
      <tr>
        <td><a href="/product/<%= r.product_id %>" target="_blank"><%= r.product_name || ('#' + r.product_id) %></a></td>
        <td><%= r.user_name || '-' %></td>
        <td><%= '⭐'.repeat(r.rating) %></td>
        <td style="max-width:320px;"><%= r.comment || '-' %></td>
        <td><%= new Date(r.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
        <td>
          <% if (r.status === 'approved') { %><span class="status-badge status-delivered">Approved</span><% } else if (r.status === 'hidden') { %><span class="status-badge status-cancelled">Hidden</span><% } else { %><span class="status-badge status-pending">Pending</span><% } %>
        </td>
        <td style="white-space:nowrap;">
          <div class="admin-actions">
            <% if (r.status !== 'approved') { %>
              <form action="/admin/reviews/<%= r.id %>/approve" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--primary">Approve</button></form>
            <% } %>
            <% if (r.status !== 'hidden') { %>
              <form action="/admin/reviews/<%= r.id %>/hide" method="POST" style="display:inline"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm">Hide</button></form>
            <% } %>
            <form action="/admin/reviews/<%= r.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this review permanently?');"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--danger">Delete</button></form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>

<% /* ---------- D4 Product Q&A (feat/product-page) ----------
      Shopper-er proshno + admin-er uttor — ekhanei moderation.
      Uttor na deoa porjonto proshno shop-e dekhabe na. */ %>
<% if (typeof questions !== 'undefined' && questions) { %>
<div class="admin-page-header" style="margin-top:28px;">
  <h2>Product Q&amp;A <% if (pendingQuestions > 0) { %><span class="status-badge status-pending"><%= pendingQuestions %> pending</span><% } %></h2>
</div>
<% if (questions.length === 0) { %>
  <div class="empty-state">
    <span class="empty-state-icon">❓</span>
    <strong>No questions yet</strong>
    <p>When a shopper asks a question on a product page, it will appear here for you to answer.</p>
  </div>
<% } else { %>
<div class="table-responsive">
<table class="admin-table">
  <thead>
    <tr><th>Product</th><th>Asked by</th><th>Question</th><th>Your answer</th><th>Status</th><th>Actions</th></tr>
  </thead>
  <tbody>
    <% questions.forEach(q => { %>
      <tr>
        <td><a href="/product/<%= q.product_id %>" target="_blank"><%= q.product_name || ('#' + q.product_id) %></a></td>
        <td><%= q.asker_name || '-' %></td>
        <td style="max-width:280px;"><%= q.question %></td>
        <td style="max-width:320px;">
          <% if (q.status === 'answered') { %><%= q.answer %><% } else { %>
          <form action="/admin/questions/<%= q.id %>/answer" method="POST"><%- include('../partials/csrf-field') %>
            <textarea name="answer" rows="2" required placeholder="Write your answer here — it will show on the product page." style="width:100%; padding:8px;"></textarea>
            <button type="submit" class="btn-sm btn-sm--primary" style="margin-top:6px;">Answer &amp; Publish</button>
          </form>
          <% } %>
        </td>
        <td>
          <% if (q.status === 'answered') { %><span class="status-badge status-delivered">Answered</span><% } else { %><span class="status-badge status-pending">Pending</span><% } %>
        </td>
        <td style="white-space:nowrap;">
          <form action="/admin/questions/<%= q.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('Delete this question permanently?');"><%- include('../partials/csrf-field') %><button type="submit" class="btn-sm btn-sm--danger">Delete</button></form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>
<% } %>

<%- include('../partials/admin-footer') %>
