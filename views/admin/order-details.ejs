<%- include('../partials/admin-header') %>

<div class="admin-page-header no-print">
  <h1>Order #<%= order.id %></h1>
  <div>
    <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
    <button onclick="window.print()" class="btn-primary" style="margin-left:10px;">🖨️ Print Invoice</button>
  </div>
</div>

<div id="invoice-print-area" class="invoice-doc">
  <div class="invoice-doc-header">
    <div class="invoice-brand">
      <img src="/icons/icon-512.png" alt="<%= siteName %>" class="invoice-logo">
      <div>
        <h2><%= siteName %></h2>
        <p class="invoice-brand-tagline">Online Shop</p>
      </div>
    </div>
    <div class="invoice-meta">
      <h1>INVOICE</h1>
      <p><span>Invoice No.</span> #<%= order.id %></p>
      <p><span>Date</span> <%= new Date(order.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
      <p class="only-print"><span>Status</span> <%= order.status %></p>
    </div>
  </div>

  <div class="invoice-divider"></div>

  <div class="invoice-box">
    <div class="invoice-grid">
      <div>
        <h3>Billed To</h3>
        <p class="invoice-lead"><%= order.customer_name %></p>
        <p><%= order.phone %></p>
        <% if (order.email) { %><p><%= order.email %></p><% } %>
        <p><%= order.address %></p>
      </div>
      <div>
        <h3>Order Details</h3>
        <p><span>Payment Method</span><%= order.payment_method %></p>
        <p><span>Payment Status</span>
          <span class="status-badge <%= order.payment_status === 'Paid' ? 'status-delivered' : 'status-pending' %>"><%= order.payment_status %></span>
        </p>
        <% if (order.transaction_id) { %><p><span>Transaction ID</span><%= order.transaction_id %></p><% } %>
        <% if (order.coupon_code) { %><p><span>Coupon Used</span><%= order.coupon_code %></p><% } %>
        <% if (order.courier_name) { %><p><span>Courier</span><%= order.courier_name %></p><% } %>
        <% if (order.tracking_number) { %><p><span>Tracking No.</span><%= order.tracking_number %></p><% } %>
      </div>
    </div>
  </div>

  <table class="invoice-items-table">
    <thead><tr><th>Product</th><th class="align-right">Price</th><th class="align-center">Qty</th><th class="align-right">Subtotal</th></tr></thead>
    <tbody>
      <% let subtotal = 0; %>
      <% items.forEach(item => {
           const lineTotal = item.price * item.quantity;
           subtotal += lineTotal;
      %>
        <tr>
          <td><%= item.product_name %><% if (item.variant_label) { %><br><span class="invoice-item-variant"><%= item.variant_label %></span><% } %></td>
          <td class="align-right">৳<%= Number(item.price).toFixed(2) %></td>
          <td class="align-center"><%= item.quantity %></td>
          <td class="align-right">৳<%= lineTotal.toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="invoice-total-box">
    <p><span>Subtotal</span><span>৳<%= subtotal.toFixed(2) %></span></p>
    <% if (order.discount_amount && order.discount_amount > 0) { %>
      <p class="discount-line"><span>Discount <%= order.coupon_code ? '(' + order.coupon_code + ')' : '' %></span><span>- ৳<%= Number(order.discount_amount).toFixed(2) %></span></p>
    <% } %>
    <p><span>Delivery Charge</span><span>৳<%= Number(order.delivery_charge || 0).toFixed(2) %></span></p>
    <p class="invoice-grand-total"><span>Total Paid</span><span>৳<%= Number(order.total_amount).toFixed(2) %></span></p>
  </div>

  <div class="invoice-doc-footer">
    <p class="invoice-thanks">Thank you for shopping with <%= siteName %>!</p>
    <p class="invoice-contact">For any questions about this order, call us at <%= shopPhone %></p>
    <p class="invoice-note only-print">This is a computer-generated invoice and does not require a signature.</p>
  </div>
</div>

<div class="no-print">
  <h3 style="margin-top:30px;">Update Order Status</h3>
  <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline-form">
    <select name="status">
      <% ['Pending','Confirmed','Shipped','Delivered','Cancelled'].forEach(s => { %>
        <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn-primary">Update Status</button>
  </form>

  <h3 style="margin-top:24px;">Update Payment Status</h3>
  <form action="/admin/orders/<%= order.id %>/payment-status" method="POST" class="inline-form">
    <select name="payment_status">
      <% ['Unpaid','Paid','Partial','Refunded'].forEach(s => { %>
        <option value="<%= s %>" <%= order.payment_status === s ? 'selected' : '' %>><%= s %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn-primary">Update Payment</button>
  </form>

  <h3 style="margin-top:24px;">Courier / Tracking Info</h3>
  <form action="/admin/orders/<%= order.id %>/shipping" method="POST" class="admin-form" style="max-width:400px;">
    <label>Courier Company</label>
    <input type="text" name="courier_name" value="<%= order.courier_name || '' %>" placeholder="e.g. Pathao, Steadfast">

    <label>Tracking Number</label>
    <input type="text" name="tracking_number" value="<%= order.tracking_number || '' %>" placeholder="e.g. TRK123456">

    <button type="submit" class="btn-primary">Save Shipping Info</button>
  </form>

  <a href="/admin/orders" class="back-link">&larr; Back to Orders</a>
</div>

<%- include('../partials/admin-footer') %>
