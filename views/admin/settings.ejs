<%- include('../partials/admin-header') %>

<h1>Settings</h1>
<p class="field-hint">Changes made here appear on the homepage and footer right away — no code changes needed. Leave a field blank to use the default text.</p>

<% if (message) { %><p class="success-msg" style="text-align:left;"><%= message %></p><% } %>

<form action="/admin/settings<%- typeof csrfToken !== 'undefined' && csrfToken ? '?_csrf=' + csrfToken : '' %>" method="POST" class="admin-form" enctype="multipart/form-data"><%- include('../partials/csrf-field') %>
  <h3>🖼️ Logo — kothay konta, koto size</h3>
  <p class="field-hint">Upload a file, or enter an image link (URL) — if you upload a file, that will be used. Saving updates the website and admin panel right away.</p>
  <table class="admin-table" style="margin-bottom:16px;">
    <thead><tr><th>Where the logo appears</th><th>Display size</th><th>Upload size</th></tr></thead>
    <tbody>
      <tr><td>Main Logo — header, admin sidebar, login page, invoice</td><td>Header 28×28 · Sidebar 32×32 · Login 64×64 · Invoice 52×52</td><td><strong>512×512 PNG</strong> (a transparent background works best; the header is navy, so a light-coloured logo looks best)</td></tr>
      <tr><td>Favicon — browser tab, bookmark, phone home screen</td><td>Tab-e 16×16 / 32×32</td><td><strong>192×192 PNG</strong></td></tr>
      <tr><td>Social Share Image — Facebook/WhatsApp-e link share korle je chobi dekhabe</td><td>Facebook 1200×630</td><td><strong>1200×630 JPG/PNG</strong></td></tr>
    </tbody>
  </table>
  <label>Main Logo (current: <img src="<%= logoUrl %>" alt="" style="width:28px; height:28px; vertical-align:middle; border-radius:6px;">)</label>
  <input type="file" name="logo_file" accept="image/png,image/jpeg,image/webp">
  <label>…or Main Logo link (URL)</label>
  <input type="url" name="logo_url" value="<%= logoUrl %>" placeholder="https://example.com/logo.png">
  <label>Favicon (current: <img src="<%= faviconUrl %>" alt="" style="width:28px; height:28px; vertical-align:middle; border-radius:6px;">)</label>
  <input type="file" name="favicon_file" accept="image/png,image/jpeg,image/webp">
  <label>…or Favicon link (URL)</label>
  <input type="url" name="favicon_url" value="<%= faviconUrl %>" placeholder="https://example.com/favicon.png">
  <label>Social Share Image (current: <img src="<%= ogImageUrl %>" alt="" style="width:56px; height:28px; vertical-align:middle; border-radius:6px; object-fit:cover;">)</label>
  <input type="file" name="og_file" accept="image/png,image/jpeg,image/webp">
  <label>…or Social Image link (URL)</label>
  <input type="url" name="og_image_url" value="<%= ogImageUrl %>" placeholder="https://example.com/og-image.jpg">

  <hr style="margin:20px 0;">
  <h3>🏪 Shop Information</h3>
  <label>Shop Phone Number (customers will call this number from the WhatsApp / Call button)</label>
  <input type="text" name="shop_phone" value="<%= shopPhone %>" placeholder="+8801XXXXXXXXX" required>

  <label>Shop Address (shown in the footer — leave blank to hide it)</label>
  <input type="text" name="shop_address" value="<%= shopAddress %>" placeholder="e.g. Dhaka, Bangladesh">

  <label>Facebook Page URL (linked in the footer — leave blank to hide it)</label>
  <input type="url" name="facebook_url" value="<%= facebookUrl %>" placeholder="https://www.facebook.com/goince">

  <label>YouTube Channel URL (linked in the footer)</label>
  <input type="url" name="youtube_url" value="<%= youtubeUrl %>" placeholder="https://www.youtube.com/@goince">

  <label>Instagram URL (linked in the footer)</label>
  <input type="url" name="instagram_url" value="<%= instagramUrl %>" placeholder="https://www.instagram.com/goince">

  <label>Shop Email (shown in the footer)</label>
  <input type="email" name="shop_email" value="<%= shopEmail %>" placeholder="support@goince.com">

  <label>Opening Hours (shown in the footer)</label>
  <input type="text" name="footer_hours" value="<%= footerHours %>" placeholder="e.g. Sat–Thu, 9 AM – 9 PM">

  <label>Footer About Text (the Goince text in the footer)</label>
  <textarea name="footer_about" rows="2" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);"><%= footerAbout %></textarea>

  <hr style="margin:20px 0;">
  <h3>🎉 Homepage — Hero &amp; Announcement</h3>
  <label>Announcement Bar (a small line above every page — leave blank to hide the bar)</label>
  <input type="text" name="announcement_text" value="<%= announcementText %>" placeholder="e.g. Eid Offer — 10% off all products!">

  <label>Hero Title (the large heading on the homepage)</label>
  <input type="text" name="hero_title" value="<%= heroTitle %>" placeholder="Cash on Delivery — sara Bangladesh-e delivery">

  <label>Hero Subtitle (the smaller text below the hero title)</label>
  <input type="text" name="hero_subtitle" value="<%= heroSubtitle %>" placeholder="Dhaka-r vitore 1–2 din, Dhaka-r baire 3–5 dine delivery.">

  <label>Hero Banner Product (the product photo shown in the banner — leave blank to show the Best Seller)</label>
  <select name="hero_product_id" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);">
    <option value="">— Best Seller (auto) —</option>
    <% products.forEach(p => { %><option value="<%= p.id %>" <%= String(heroProductId) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %>
  </select>

  <hr style="margin:20px 0;">
  <h3>🚚 Delivery Charge</h3>
  <label>Delivery Charge - Inside Dhaka (৳)</label>
  <input type="number" step="0.01" min="0" name="delivery_charge_inside" value="<%= deliveryChargeInside %>" required>

  <label>Delivery Charge - Outside Dhaka (৳)</label>
  <input type="number" step="0.01" min="0" name="delivery_charge_outside" value="<%= deliveryChargeOutside %>" required>
  <p class="field-hint">To add a new zone or change a zone's charge, go to the <a href="/admin/delivery-zones">Delivery Zones page</a> — customers choose their zone from there at checkout.</p>

  <hr style="margin:20px 0;">
  <h3>Mobile Banking Numbers</h3>
  <p class="field-hint">
    bKash/Nagad/Rocket numbers can now be Added/Edited/Deleted from a separate page —
    go to the <a href="/admin/payment-methods">Payment Methods page</a>.
  </p>

  <hr style="margin:20px 0;">
  <h3>💳 Payment Gateway (Online Payment API)</h3>
  <p class="field-hint">With a gateway connected, customers can pay online by card, bKash, or Nagad. <strong>Manual</strong> means only COD + bKash/Nagad numbers (as it works now). <strong>Gateway</strong> means online payment only — manual methods will be hidden. <strong>Both</strong> shows both options. If the gateway is off, it will not appear anywhere on the website.</p>
  <label>Payment Mode</label>
  <select name="payment_mode" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);">
    <option value="manual" <%= paymentMode === 'manual' ? 'selected' : '' %>>Manual only (COD + bKash/Nagad number)</option>
    <option value="gateway" <%= paymentMode === 'gateway' ? 'selected' : '' %>>Gateway only (online payment)</option>
    <option value="both" <%= paymentMode === 'both' ? 'selected' : '' %>>Both (manual + gateway)</option>
  </select>
  <label>Gateway Provider</label>
  <select name="gateway_provider" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);">
    <option value="none" <%= gatewayProvider === 'none' ? 'selected' : '' %>>— No gateway —</option>
    <option value="sslcommerz" <%= gatewayProvider === 'sslcommerz' ? 'selected' : '' %>>SSLCommerz</option>
    <option value="shurjopay" <%= gatewayProvider === 'shurjopay' ? 'selected' : '' %>>ShurjoPay</option>
    <option value="bkash" <%= gatewayProvider === 'bkash' ? 'selected' : '' %>>bKash PGW</option>
  </select>
  <label><input type="checkbox" name="gateway_enabled" value="1" <%= gatewayEnabled === '1' ? 'checked' : '' %>> Enable gateway</label>
  <label>Gateway Mode</label>
  <select name="gateway_mode" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);">
    <option value="sandbox" <%= gatewayMode === 'sandbox' ? 'selected' : '' %>>Sandbox (test)</option>
    <option value="live" <%= gatewayMode === 'live' ? 'selected' : '' %>>Live (real money)</option>
  </select>
  <label>Store ID / Merchant ID (from your gateway account)</label>
  <input type="text" name="gateway_store_id" value="<%= gatewayStoreId %>" placeholder="e.g. goince001">
  <label>Store Password / API Key <%= gatewayPasswordSet ? '(one is already saved — enter a new one to change it, or leave blank to keep it)' : '(not set yet)' %></label>
  <input type="password" name="gateway_store_password" placeholder="leave blank to keep the current one" autocomplete="new-password">
  <p class="field-hint">⚠️ To accept real payments through a gateway, you need a merchant account with the provider (SSLCommerz/ShurjoPay/bKash PGW). Saving the config here will show the option at checkout, but taking real payments also requires an API verification step for orders — that still needs to be set up with your merchant credentials.</p>

  <hr style="margin:20px 0;">
  <h3>🚚 Courier API (Steadfast / Pathao)</h3>
  <p class="field-hint">With a courier connected, you can book a parcel from an order page in one click — the tracking number is saved on the order automatically. Without keys, the manual courier/tracking fields on the order page keep working as now. <strong>Steadfast has no sandbox</strong> — a live Steadfast key books real parcels. Pathao has a sandbox mode for testing.</p>
  <label>Courier Provider</label>
  <select name="courier_provider" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);">
    <option value="none" <%= courierProvider === 'none' ? 'selected' : '' %>>— No courier API —</option>
    <option value="steadfast" <%= courierProvider === 'steadfast' ? 'selected' : '' %>>Steadfast</option>
    <option value="pathao" <%= courierProvider === 'pathao' ? 'selected' : '' %>>Pathao</option>
  </select>
  <label><input type="checkbox" name="courier_enabled" value="1" <%= courierEnabled === '1' ? 'checked' : '' %>> Enable courier API</label>
  <label>Courier Mode</label>
  <select name="courier_mode" style="width:100%; padding:10px; border:1px solid var(--border-strong); border-radius:6px; background:var(--surface); color:var(--text);">
    <option value="sandbox" <%= courierMode === 'sandbox' ? 'selected' : '' %>>Sandbox (test — Pathao only)</option>
    <option value="live" <%= courierMode === 'live' ? 'selected' : '' %>>Live (real parcels)</option>
  </select>
  <h4 style="margin-top:14px;">Steadfast — from the Steadfast merchant portal (API section)</h4>
  <label>Steadfast API Key <%= courierSteadfastKeySet ? '(one is already saved — enter a new one to change it, or leave blank to keep it)' : '(not set yet)' %></label>
  <input type="password" name="steadfast_api_key" placeholder="leave blank to keep the current one" autocomplete="new-password">
  <label>Steadfast Secret Key <%= courierSteadfastKeySet ? '(one is already saved — enter a new one to change it, or leave blank to keep it)' : '(not set yet)' %></label>
  <input type="password" name="steadfast_secret_key" placeholder="leave blank to keep the current one" autocomplete="new-password">
  <h4 style="margin-top:14px;">Pathao — from the Pathao merchant panel (API credentials) + your store</h4>
  <label>Pathao Client ID</label>
  <input type="text" name="pathao_client_id" value="<%= pathaoClientId %>" placeholder="e.g. 7N1aMJQbWm">
  <label>Pathao Client Secret <%= courierPathaoSecretSet ? '(one is already saved — enter a new one to change it, or leave blank to keep it)' : '(not set yet)' %></label>
  <input type="password" name="pathao_client_secret" placeholder="leave blank to keep the current one" autocomplete="new-password">
  <label>Pathao Username (your Pathao merchant login email)</label>
  <input type="text" name="pathao_username" value="<%= pathaoUsername %>" placeholder="you@example.com">
  <label>Pathao Password <%= courierPathaoPasswordSet ? '(one is already saved — enter a new one to change it, or leave blank to keep it)' : '(not set yet)' %></label>
  <input type="password" name="pathao_password" placeholder="leave blank to keep the current one" autocomplete="new-password">
  <label>Pathao Store ID</label>
  <input type="text" name="pathao_store_id" value="<%= pathaoStoreId %>" placeholder="e.g. 149043">

  <button type="submit" class="btn-primary">Save Settings</button>
</form>

<h3 style="margin-top:28px;">🔑 Change Admin Password</h3>
<% if (typeof pwMessage !== 'undefined' && pwMessage) { %><p class="success-msg" style="text-align:left;"><%= pwMessage %></p><% } %>
<form action="/admin/settings/change-password" method="POST" class="admin-form">
  <label>Current Password</label>
  <input type="password" name="current_password" required autocomplete="current-password">
  <label>New Password (at least 6 characters)</label>
  <input type="password" name="new_password" required autocomplete="new-password">
  <label>Confirm New Password</label>
  <input type="password" name="confirm_password" required autocomplete="new-password">
  <button type="submit" class="btn-primary">Change Password</button>
</form>

<%- include('../partials/admin-footer') %>
