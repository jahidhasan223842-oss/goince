<%- include('../partials/admin-header') %>

<h1>Categories</h1>

<form action="/admin/categories/add" method="POST" class="admin-form" style="max-width:400px;">
  <label>Category Name</label>
  <input type="text" name="name" placeholder="e.g. Fashion, or Men's Shirt" required>

  <label>Parent Category (leave blank to make this a Main Category)</label>
  <select name="parent_id">
    <option value="">-- None (Main Category) --</option>
    <% mainCategories.forEach(cat => { %>
      <option value="<%= cat.id %>"><%= cat.name %></option>
    <% }) %>
  </select>

  <button type="submit" class="btn-primary">Add Category</button>
</form>

<div class="table-responsive">
<table class="admin-table" style="margin-top:24px;">
  <thead><tr><th>Name</th><th>Parent (if any)</th><th>Products</th><th>Actions</th></tr></thead>
  <tbody>
    <% categories.forEach(cat => { %>
      <tr>
        <td><%= cat.parent_id ? '— ' : '' %><%= cat.name %></td>
        <td><%= cat.parent_name || '-' %></td>
        <td><%= cat.product_count %></td>
        <td>
          <form action="/admin/categories/edit/<%= cat.id %>" method="POST" class="inline-form" style="margin-bottom:6px;">
            <input type="text" name="name" value="<%= cat.name %>" style="padding:6px 10px; width:120px;">
            <select name="parent_id" style="padding:6px;">
              <option value="">None</option>
              <% mainCategories.forEach(mc => { %>
                <% if (mc.id != cat.id) { %>
                  <option value="<%= mc.id %>" <%= cat.parent_id == mc.id ? 'selected' : '' %>><%= mc.name %></option>
                <% } %>
              <% }) %>
            </select>
            <button type="submit" style="padding:6px 12px; font-size:13px;">Save</button>
          </form>
          <form action="/admin/categories/delete/<%= cat.id %>" method="POST" onsubmit="return confirm('Deleting this will make its products Uncategorized, and any sub-categories will also be deleted. Sure?');">
            <button type="submit" class="link-btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>

<%- include('../partials/admin-footer') %>
