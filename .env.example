# Database Config (nijer PC-r value, Hosting e giye change korte hobe)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=MyShop@2026
DB_NAME=goince_db
DB_PORT=3306

# Session Secret (jekono random long string dite paro)
SESSION_SECRET=goince_super_secret_key_change_this

# Server Port
PORT=3000

# Admin Login
ADMIN_EMAIL=admin@goince.com
ADMIN_PASSWORD=admin123

# Email Notification (Optional — na dile email pathabe na, kono error hobe na)
# Gmail use korle "App Password" lagbe (normal password na):
# Google Account -> Security -> 2-Step Verification on koro -> App Passwords theke generate koro
EMAIL_USER=
EMAIL_PASS=

# Live Chat er "Call" button e ei number e call hobe (tomar shop/business number diyo)
SHOP_PHONE=+8801700000000

# Push Notification (Admin panel-e "notun order" er push notification pete)
# Ei key duita ekbar generate kore deya hoyeche, notun kore banano lagbe na —
# shudhu ei duitai .env e boshiye dile PWA push notification kaj korbe.
# Na dile eta shudhu skip hoye jabe, kono error hobe na.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@goince.com
